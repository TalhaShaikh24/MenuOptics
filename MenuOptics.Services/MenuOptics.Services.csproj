  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MenuOptics.Models\MenuOptics.Models.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.AspNetCore.Http" />
