@using System.Security.Claims
@using MenuOptics
@using MenuOptics.Models
@using MenuOptics.Utility
@inject Microsoft.AspNetCore.Mvc.Rendering.IHtmlHelper Html
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@{
    var firstName = User?.FindFirst("FirstName")?.Value ?? "John";
    var lastName = User?.FindFirst("LastName")?.Value ?? "Doe";
    var initials = (firstName.FirstOrDefault().ToString() + lastName.FirstOrDefault().ToString()).ToUpper();
    var userRole = User?.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Role)?.Value ?? "User";
    bool isParent = Convert.ToBoolean(
        User?.FindFirst("isParent")?.Value ?? "false"
    );
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Menu Optics</title>
    <script type="importmap"></script>
    <link rel="icon" type="image/png" href="~/favicon.png" />
    <link rel="stylesheet" href="~/css/styles.css?v=@DateTime.Now.Ticks">
    <link rel="stylesheet" href="~/css/image-preview.css?v=@DateTime.Now.Ticks">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.10.25/css/jquery.dataTables.min.css" />

    <!-- DataTables Buttons CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.1/css/buttons.dataTables.min.css" />


    <link href="~/css/error-popup.css" rel="stylesheet" />
    <script src="~/lib/jquery/dist/jquery.min.js"></script>


</head>
<body>
    <style>
        .availability-badge {
            display: none !important;
        }

        .menu-item-content .stat {
            display: none !important;
        }

        .policies {
            margin-top: auto;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .policies .policies-link {
            font-size: 14px;
            color: #898989;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }
        .policies .policies-link:hover {
            color: #f08d11;
        }
        .policies .welcome-video-sidebar-link {
            color: #f08d11;
            font-weight: 500;
            cursor: pointer;
            transition: color 0.2s ease;
        }
        .policies .welcome-video-sidebar-link:hover {
            color: #e07c0a;
        }
        .policies .welcome-video-sidebar-link i {
            font-size: 15px;
        }
    </style>
    <span id="subscriptioStatus" class="stripe-alert danger" style="display:none;"></span>
    <div class="dashboard-container">
        <!-- Sidebar -->
        <aside class="sidebar" id="sidebar">
            <!-- Header -->
            <div class="sidebar-header">
                <div class="sidebar-brand">
                    @*   <div class="brand-icon">
                         <i class="fas fa-store"></i> 
                    </div> *@
                    <div class="brand-icon" style="background:transparent!important; width:auto!important;height:auto!important">
                        @* <img src="~/images/transparent logo symbol.png" style="width:30px!important"/> *@
                        <img class="sidebar-logo expanded" src="~/images/menu optics_logo.png" />
                        <img class="sidebar-logo collapsed" src="~/favicon.png" />
                        @* <i class="fas fa-store"></i> *@
                    </div>
                    @*  <div class="brand-text">
                        <h1>MENU</h1>
                        <h1>OPTICS</h1>
                    </div> *@
                </div>
                <button class="sidebar-toggle" id="sidebarToggle">
                    <i class="fas fa-bars"></i>
                </button>
            </div>

            <!-- Search -->
            @* <div class="sidebar-search">
                <div class="search-input-wrapper">
                    <i class="fas fa-search"></i>
                    <input type="text" placeholder="Search..." class="search-input">
                </div>
            </div> *@



            <!-- Navigation -->
            <nav class="sidebar-nav">

                @if (User.IsInRole("Admin"))
                {
                    <!-- Admin: Management Group -->
                    <div class="nav-group">
                        <button class="nav-group-toggle" data-target="admin-management">
                            <span class="nav-group-left">
                                <i class="fas fa-shield-alt"></i>
                                <span>Management</span>
                            </span>
                            <i class="fas fa-chevron-down nav-group-arrow"></i>
                        </button>
                        <div class="nav-group-items" id="admin-management">
                            <a href="@Url.Action("Index", "User")" class="nav-item nav-child @Html.IsActive("User", "Index")">
                                <i class="fas fa-users"></i>
                                <span>Users</span>
                            </a>
                            <a href="@Url.Action("Index", "Restaurant")" class="nav-item nav-child @Html.IsActive("Restaurant", "Index")">
                                <i class="fas fa-store"></i>
                                <span>Restaurants</span>
                            </a>
                        </div>
                    </div>

                    <a href="@Url.Action("Index", "Policies")" class="nav-item @Html.IsActive("Policies", "Index")">
                        <i class="fas fa-file-contract"></i>
                        <span>Policy Management</span>
                    </a>
                }

                @if (User.IsInRole("Restaurant"))
                {
                    <!-- Restaurant: Menu Management Group -->
                    <div class="nav-group">
                        <button class="nav-group-toggle" data-target="menu-management">
                            <span class="nav-group-left">
                                <i class="fas fa-utensils"></i>
                                <span>Menu Management</span>
                            </span>
                            <i class="fas fa-chevron-down nav-group-arrow"></i>
                        </button>
                        <div class="nav-group-items" id="menu-management">
                            <a href="@Url.Action("Index", "Ingredient")" class="nav-item nav-child @Html.IsActive("Ingredient", "Index")">
                                <i class="fas fa-box"></i>
                                <span>Ingredients</span>
                            </a>
                            <a href="@Url.Action("Index", "Recipe")" class="nav-item nav-child @Html.IsActive("Recipe", "Index")">
                                <i class="fas fa-book-open"></i>
                                <span>Recipes</span>
                            </a>
                            <a href="@Url.Action("Index", "Category")" class="nav-item nav-child @Html.IsActive("Category", "Index")">
                                <i class="fas fa-tags"></i>
                                <span>Menu Categories</span>
                            </a>
                            <a href="@Url.Action("Index", "Supplier")" class="nav-item nav-child @Html.IsActive("Supplier", "Index")">
                                <i class="fas fa-truck"></i>
                                <span>Suppliers</span>
                            </a>
                            <a href="@Url.Action("Index", "Menu")" class="nav-item nav-child @Html.IsActive("Menu", "Index")">
                                <i class="fas fa-list"></i>
                                <span>Menu Items</span>
                            </a>
                        </div>
                    </div>

                    <!-- Restaurant: Business & Analytics Group -->
                    <div class="nav-group">
                        <button class="nav-group-toggle" data-target="business-analytics">
                            <span class="nav-group-left">
                                <i class="fas fa-chart-bar"></i>
                                <span>Business & Analytics</span>
                            </span>
                            <i class="fas fa-chevron-down nav-group-arrow"></i>
                        </button>
                        <div class="nav-group-items" id="business-analytics">
                            <a href="@Url.Action("Index", "Sales")" class="nav-item nav-child @Html.IsActive("Sales", "Index")">
                                <i class="fas fa-dollar-sign"></i>
                                <span>Sales</span>
                            </a>
                            <a href="@Url.Action("Index", "MenuEngineeringInsights")" class="nav-item nav-child @Html.IsActive("MenuEngineeringInsights", "Index")">
                                <i class="fas fa-chart-pie"></i>
                                <span>Menu Insights</span>
                            </a>
                            <a href="@Url.Action("Index", "Analytics")" class="nav-item nav-child @Html.IsActive("Analytics", "Index") hidden">
                                <i class="fas fa-chart-line"></i>
                                <span>Analytics</span>
                            </a>
                            <a href="@Url.Action("Index", "Inventory")" class="nav-item nav-child @Html.IsActive("Inventory", "Index")">
                                <i class="fas fa-file"></i>
                                <span>Inventory Suite</span>
                            </a>
                        </div>
                    </div>

                    <!-- Restaurant: Operations Group -->
                    <div class="nav-group">
                        <button class="nav-group-toggle" data-target="operations">
                            <span class="nav-group-left">
                                <i class="fas fa-concierge-bell"></i>
                                <span>Operations</span>
                            </span>
                            <i class="fas fa-chevron-down nav-group-arrow"></i>
                        </button>
                        <div class="nav-group-items" id="operations">
                            <a href="@Url.Action("Index", "Event")" class="nav-item nav-child @Html.IsActive("Event", "Index")">
                                <i class="fa-solid fa-bell-concierge"></i>
                                <span>Event & Catering</span>
                            </a>
                        </div>
                    </div>
                }

                @if (User.IsInRole("Admin") || User.IsInRole("Restaurant"))
                {
                    @if (User.IsInRole("Vendor"))
                    {
                        <a href="@Url.Action("VendorIngredients", "Ingredient")" class="nav-item @Html.IsActive("Ingredient", "VendorIngredients")">
                            <i class="fas fa-box"></i>
                            <span>Ingredients</span>
                        </a>
                    }
                }

                @if (User.IsInRole("Restaurant") && isParent)
                {
                    <!-- Restaurant (Parent): Settings Group -->
                    <div class="nav-group">
                        <button class="nav-group-toggle" data-target="settings">
                            <span class="nav-group-left">
                                <i class="fas fa-cog"></i>
                                <span>Settings</span>
                            </span>
                            <i class="fas fa-chevron-down nav-group-arrow"></i>
                        </button>
                        <div class="nav-group-items" id="settings">
                            <a href="@Url.Action("Index", "Profile")" class="nav-item nav-child @Html.IsActive("Profile", "Index")">
                                <i class="fas fa-edit"></i>
                                <span>Edit Profile</span>
                            </a>
                            <a href="@Url.Action("Members", "Restaurant")" class="nav-item nav-child @Html.IsActive("Restaurant", "Members")">
                                <i class="fas fa-users-cog"></i>
                                <span>Staff Members</span>
                            </a>
                        </div>
                    </div>
                }

                <a id="btnLogout" class="nav-item" href="javascript:void(0);">
                    <i class="fas fa-sign-out-alt"></i>
                    <span>Logout</span>
                </a>

                <div class="policies">
                   
                    <a class="policies-link" href="@Url.Action("TermsAndConditions", "Home")" target="_blank">Terms & Conditions</a>
                </div>
            </nav>


            


            <!-- Footer -->
            <div class="sidebar-footer">
                <div class="user-profile">
                    <div class="user-avatar">@initials</div>
                    <div class="user-info">
                        <p class="user-name">@firstName </p>
                        <p class="user-role">@userRole</p>
                    </div>
                    @* <i class="fas fa-bell"></i> *@
                </div>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="main-content">
            @RenderBody()
            <div class="modal" id="confirmDeleteModal" style="display: none;">
                <div class="modal-content">
                    <div class="modal-header">
                        <h3>Confirm Deletion</h3>
                        <button class="modal-close" onclick="closeModal('confirmDeleteModal')">&times;</button>
                    </div>
                    <div class="modal-body">
                        <p id="confirmDeleteMessage">Are you sure you want to delete this item? This action cannot be undone.</p>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-outline" onclick="closeModal('confirmDeleteModal')">Cancel</button>
                        <button id="confirmDeleteBtn" class="btn btn-primary">Delete</button>
                    </div>
                </div>
            </div>
            <input type="hidden" id="imageBaseUrl" value="@Configuration["ImageBaseUrl"]" />
        </main>

    </div>



    @if (User.IsInRole("Restaurant"))
    {
        <!-- ═══════════════════════════════════════════════
             Welcome Video Modal — shown only on first login
        ════════════════════════════════════════════════ -->
        <div id="welcomeVideoModal" class="welcome-modal-overlay" style="display:none;" role="dialog" aria-modal="true" aria-labelledby="welcomeModalTitle">
            <div class="welcome-modal-card">
                <div class="welcome-modal-header">
                    <div class="welcome-modal-title-group">
                        <div class="welcome-modal-icon">
                            <i class="fas fa-play-circle"></i>
                        </div>
                        <div>
                            <h2 id="welcomeModalTitle" class="welcome-modal-title">Welcome to Menu Optics!</h2>
                            <p class="welcome-modal-subtitle">Get started with a quick tour of your dashboard</p>
                        </div>
                    </div>
                    <button class="welcome-modal-close" id="welcomeModalCloseBtn" aria-label="Close welcome video">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                <div class="welcome-modal-body">
                    <div class="welcome-video-wrapper">
                        <video id="welcomeVideo" controls playsinline preload="metadata">
                            <source src="/videos/Welcome.mp4" type="video/mp4" />
                            Your browser does not support the video tag.
                        </video>
                    </div>
                </div>
                <div class="welcome-modal-footer">
                    <button class="btn-welcome-skip hidden" id="welcomeModalSkipBtn">
                        <i class="fas fa-forward"></i> Skip for now
                    </button>
                    <button class="btn-welcome-primary" id="welcomeModalDoneBtn">
                        <i class="fas fa-check"></i> Got it, let's go!
                    </button>
                </div>
            </div>
        </div>
    }

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <!-- Include this before your custom script -->
    <script src="https://cdn.jsdelivr.net/npm/js-cookie@3.0.5/dist/js.cookie.min.js"></script>

    <!-- DataTables core JS -->
    <script src="https://cdn.datatables.net/1.10.25/js/jquery.dataTables.min.js"></script>

    <!-- DataTables Buttons -->
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>

    <!-- Export dependencies -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>

    <!-- Buttons HTML5 -->
    
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.html5.min.js"></script>



    <script src="~/js/dateformatter.js"></script>
    <script src="~/js/script.js?v=@DateTime.Now.Ticks"></script>
    <script src="~/js/image-preview.js?v=@DateTime.Now.Ticks"></script>
    <script src="~/js/globalajax.js?v=@DateTime.Now.Ticks"></script>
    <script src="~/js/unitconversions.js?v=@DateTime.Now.Ticks"></script>
    <script src="~/js/error-popup.js?v=@DateTime.Now.Ticks"></script>
    <script src="~/js/module-tutorials.js?v=@DateTime.Now.Ticks"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>


    <script>
        let imageBaseUrl;
        $(document).ready(function () {
            imageBaseUrl = $("#imageBaseUrl").val();
            var token = Cookies.get('JwtToken');

            if (token && token.trim() !== '') {
                $.ajaxSetup({
                    headers: {
                        Authorization: 'Bearer ' + token
                    },
                    xhrFields: {
                        withCredentials: true
                    }
                });
            } else {
                $.ajaxSetup({
                    xhrFields: {
                        withCredentials: true
                    }
                });
            }

            // Sidebar toggle
            $("#sidebarToggle").on("click", () => {
                $(".sidebar").toggleClass("collapsed")
            })

            // Collapsible nav groups
            $(".nav-group-toggle").on("click", function () {
                var targetId = $(this).data("target");
                var $items = $("#" + targetId);
                var $arrow = $(this).find(".nav-group-arrow");
                var isOpen = $items.hasClass("open");

                // Close all groups
                $(".nav-group-items").removeClass("open");
                $(".nav-group-arrow").removeClass("rotated");
                $(".nav-group-toggle").removeClass("active");

                // Open clicked group if it was closed
                if (!isOpen) {
                    $items.addClass("open");
                    $arrow.addClass("rotated");
                    $(this).addClass("active");
                }
            });

            // Auto-open group containing the active nav-child
            $(".nav-group-items").each(function () {
                if ($(this).find(".nav-item.active").length > 0) {
                    $(this).addClass("open");
                    $(this).prev(".nav-group-toggle").addClass("active").find(".nav-group-arrow").addClass("rotated");
                }
            });
        });
    </script>

    @if (User.IsInRole("Restaurant"))
    {
        <script>
            $(document).ready(function () {
                // Check if this is the restaurant's first-ever login
                if (sessionStorage.getItem('showWelcomeVideo') == 'true') {
                    sessionStorage.removeItem('showWelcomeVideo'); // consume the flag immediately
                    showWelcomeModal();
                }

                function showWelcomeModal() {
                    var $modal = $('#welcomeVideoModal');
                    $modal.css('display', 'flex');
                    // Force reflow then animate in
                    requestAnimationFrame(function () {
                        $modal.addClass('welcome-modal-visible');
                    });
                    // Auto-play the video
                    var video = document.getElementById('welcomeVideo');
                    if (video) {
                        video.play().catch(function () {
                            // Autoplay blocked by browser — the user can still press play manually
                        });
                    }
                }

                function closeWelcomeModal() {
                    var $modal = $('#welcomeVideoModal');
                    var video = document.getElementById('welcomeVideo');
                    if (video) {
                        video.pause();
                    }
                    $modal.removeClass('welcome-modal-visible');
                    setTimeout(function () {
                        $modal.css('display', 'none');
                    }, 350);
                }

                $('#welcomeModalCloseBtn, #welcomeModalSkipBtn, #welcomeModalDoneBtn').on('click', closeWelcomeModal);

                // Open welcome video modal from sidebar link
                $(document).on('click', '#btnSidebarWelcomeVideo', function (e) {
                    e.preventDefault();
                    showWelcomeModal();
                });


                // Close on Escape key
                $(document).on('keydown', function (e) {
                    if (e.key === 'Escape') {
                        closeWelcomeModal();
                    }
                });
            });
        </script>
    }

    <script>
        $(document).on('click','#btnLogout',function(){
           ajaxRequest({
            url: '/api/UserApi/Logout',
            method: 'POST',
            data: null,
            contentType: false,
            processData: false,
            onSuccess: function (response) {
                localStorage.removeItem("profilePic");
                showNotification('Logout successfully!', 'success');
                window.location.href = '/User/login';

            },
            onError: function (xhr, status, error) {
                console.error('Failed to logout:', error);
                showNotification('Failed to Logout.', 'error');
            }
        });
        })
    </script>

    

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
