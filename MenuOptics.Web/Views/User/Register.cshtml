@using MenuOptics.Models.Enums
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Signup";
}

    <!-- Left Side - Branding -->
    <div class="auth-branding">
        <div class="branding-content">
        <div class="brand-logo" style="background:#fffffff0; border-radius: 12px; padding:10px; box-shadow: 0px 10px 15px -3px rgba(0,0,0,0.1);">
            <img src="~/images/menu optics_logo.png" style="width:200px" />
        </div>
            <div class="branding-text">
                <h2>Data Driven Insights.. <br> Simplified</h2>
            </div>
            <div class="stats-grid">
                <div class="stat-item">
                    <div class="stat-number">Menu</div>
                    <div class="stat-label">Costing</div>
                </div>
                <div class="stat-item">
                    <div class="stat-number">Menu</div>
                <div class="stat-label">Analysis</div>
                </div>
                <div class="stat-item">
                    <div class="stat-number">Menu</div>
                    <div class="stat-label">Engineering</div>
                </div>
                <div class="stat-item">
                <div class="stat-number">Inventory</div>
                    <div class="stat-label">Management</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Side - Register Form -->
    <div class="auth-form-container">
        <div class="auth-form">
            <div class="form-header">
                <h2>Create Account</h2>
                <p>Get started with your restaurant management system</p>
            </div>

            <!-- Step Indicator -->
            <div class="step-indicator">
                <div class="step active" data-step="1">
                    <div class="step-number">1</div>
                    <span>Personal Info</span>
                </div>
                <div class="step" data-step="2">
                    <div class="step-number">2</div>
                    <span>Location</span>
                </div>
                <div class="step" data-step="3">
                    <div class="step-number">3</div>
                    <span>Vendor</span>
                </div>
                <div class="step" data-step="4">
                    <div class="step-number">4</div>
                    <span>Account Setup</span>
                </div>
            </div>

        <form id="registerForm" class="register-form" enctype="multipart/form-data">
            <!-- Step 1: Personal Information -->
            <div class="form-step active" data-step="1">
                <div class="form-row">
                    <div class="form-group">
                        <label for="firstName">First Name <span style="color:red">*</span></label>
                        <div class="input-wrapper">
                            <i class="fas fa-user"></i>
                            <input type="text" id="firstName" name="firstName" placeholder="Enter first name" required>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="lastName">Last Name <span style="color:red">*</span></label>
                        <div class="input-wrapper">
                            <i class="fas fa-user"></i>
                            <input type="text" id="lastName" name="lastName" placeholder="Enter last name" required>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label for="username">Username <span style="color:red">*</span></label>
                    <div class="input-wrapper">
                        <i class="fas fa-user"></i>
                        <input type="text" id="username" name="username" placeholder="Enter your username" required>
                    </div>
                </div>
                <div class="form-group">
                    <label for="email">Email Address <span style="color:red">*</span></label>
                    <div class="input-wrapper">
                        <i class="fas fa-envelope"></i>
                        <input type="email" id="email" name="email" placeholder="Enter your email" required>
                    </div>
                </div>
                <div class="form-group">
                    <label for="phone">Phone Number <span style="color:red">*</span></label>
                    <div class="input-wrapper">
                        <i class="fas fa-phone"></i>
                        <input type="tel" id="phone" name="phone" placeholder="Enter phone number" required>
                    </div>
                </div>
                <div class="form-group" style="display:none;">
                    <label for="role">Your Role</label>
                    <div class="input-wrapper">
                        <i class="fas fa-briefcase"></i>
                        <input type="hidden" id="role" name="role" value="@Roles.Restaurant.ToString()" placeholder="Enter role" required>
                    </div>
                </div>
            </div>

            <!-- Step 2: Restaurant Details -->
            <div class="form-step" data-step="2">
                <div class="form-group">
                    <label for="restaurantName">Restaurant Name <span style="color:red">*</span></label>
                    <div class="input-wrapper">
                        <i class="fas fa-store"></i>
                        <input type="text" id="restaurantName" name="restaurantName" placeholder="Enter restaurant name" required>
                    </div>
                </div>
                <div class="form-group">
                    <label for="address">Restaurant Address <span style="color:red">*</span></label>
                    <div class="input-wrapper">
                        <i class="fas fa-map-marker-alt"></i>
                        <textarea id="address" name="address" placeholder="Enter complete address" rows="3" required></textarea>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label for="city">City <span style="color:red">*</span></label>
                        <div class="input-wrapper">
                            <i class="fas fa-city"></i>
                            <input type="text" id="city" name="city" placeholder="Enter city" required>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="zipCode">Postal / ZIP Code <span style="color:red">*</span></label>
                        <div class="input-wrapper">
                            <i class="fas fa-mail-bulk"></i>
                            <input type="text" id="zipCode" name="zip" placeholder="Enter Postal / ZIP code" required>
                        </div>
                    </div>
                </div>
            </div>

          

            <!-- Step 3: Connect Vendor -->
            <div class="form-step" data-step="3">
                <div class="form-group">
                    <label for="password">Select Primay Distributor <span style="color:red">*</span></label>
                    <div class="input-wrapper">
                       <select id="primaryDistributor" name="vendorId" required>
                        </select>
                    </div>
                </div>
                <div class="form-group">
                    <label for="password">Distributor Customer Account Number <span style="color:red">*</span></label>
                    <div class="input-wrapper">
                        <input type="text" id="customerNumber" name="vendorCustomerNumber" placeholder="Enter Distributor Customer Account Number" required>
                    </div>
                </div>
                <div class="form-group">
                    <label for="password">Select Secondary Distributor</label>
                    <div class="input-wrapper">
                        <input type="text" id="secondaryVendor" name="secondaryVendor" placeholder="Enter Secondary Distributor">
                        
                    </div>
                </div>
            </div>

            <!-- Step 4: Account Setup -->
            <div class="form-step" data-step="4">
                <div class="form-group">
                    <label for="password">Password</label>
                    <div class="input-wrapper">
                        <i class="fas fa-lock"></i>
                        <input type="password" id="password" name="password" placeholder="Create password" required>
                        <button type="button" class="password-toggle" onclick="togglePassword('password')">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                    <div class="password-strength">
                        <div class="strength-bar">
                            <div class="strength-fill"></div>
                        </div>
                        <span class="strength-text">Password strength</span>
                    </div>
                </div>
                <div class="form-group">
                    <label for="confirmPassword">Confirm Password</label>
                    <div class="input-wrapper">
                        <i class="fas fa-lock"></i>
                        <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Confirm password" required>
                        <button type="button" class="password-toggle" onclick="togglePassword('confirmPassword')">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                </div>
                <div class="form-group">
                    @* <label for="plan">Choose Plan</label> *@
                    <div class="plan-options">
                        <label class="plan-option" style="display:none">
                            <input type="radio" name="plan" value="starter" checked>
                            <div class="plan-card">
                                <div class="plan-header">
                                    <h4>Monthly</h4>
                                    <div class="plan-price">$20<span>/month</span></div>
                                </div>
                                <ul class="plan-features">
                                    <li><i class="fas fa-check"></i> Basic analytics</li>
                                    <li><i class="fas fa-check"></i> Email support</li>
                                </ul>
                            </div>
                        </label>
                        <label class="plan-option" >
                            <input type="radio" name="plan" value="professional">
                            <div class="plan-card popular">
                                <div class="popular-badge">Most Popular</div>
                                <div class="plan-header">
                                    <h4>Yearly</h4>
                                    <div class="plan-price">$50<span>/month</span></div>
                                </div>
                                <ul class="plan-features">
                                    <li><i class="fas fa-check"></i> Advanced analytics</li>
                                    <li><i class="fas fa-check"></i> Priority support</li>
                                </ul>
                            </div>
                        </label>
                    </div>
                </div>
                <div class="form-options">
                    
                </div>
            </div>

            <!-- Form Navigation -->
            <div class="form-navigation">
                <button type="button" class="btn btn-outline prev-btn" style="display: none;">
                    <i class="fas fa-arrow-left"></i>
                    Previous
                </button>
                <button type="button" class="btn btn-primary next-btn">
                    Next
                    <i class="fas fa-arrow-right"></i>
                </button>
                <button type="submit" class="btn btn-primary submit-btn" style="display: none;">
                    <span class="btn-text">Create Account</span>
                    <i class="fas fa-spinner fa-spin btn-loading" style="display: none;"></i>
                </button>
            </div>

            <div class="form-footer">
                <label class="checkbox-label">
                    <input type="checkbox" name="terms" required>
                    <span class="checkmark"></span>
                    I agree to the <a href="@Url.Action("TermsAndConditions", "Home")" target="_blank">Terms & Conditions</a>
                </label>
                <p>Already have an account? <a href="@Url.Action("Login", "User")">Sign in here</a></p>
            </div>
        </form>
        </div>
    </div>






@section Scripts {
    @* <script src="~/views-js/register.js"></script> *@
    <script src="https://js.stripe.com/v3/"></script>
    <script src="~/js/globalajax.js?v=@DateTime.Now.Ticks"></script>
    <script src="~/views-js/register.js?v=@DateTime.Now.Ticks"></script>

}
