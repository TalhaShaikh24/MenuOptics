@{
    Layout = null;
    ViewData["Title"] = "Access denied";
}


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Access Denied - Restaurant Management System</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/contact-modal.css?v=@DateTime.Now.Ticks">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
            color: #1f2937;
            line-height: 1.6;
            min-height: 100vh;
            overflow-x: hidden;
            position: relative;
        }

            /* Background Pattern */
            body::before {
                content: '';
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background-image: radial-gradient(circle at 25% 25%, rgba(240, 141, 17, 0.1) 0%, transparent 50%), radial-gradient(circle at 75% 75%, rgba(240, 141, 17, 0.05) 0%, transparent 50%);
                z-index: -1;
            }

        /* Floating Elements */
        .floating-elements {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 1;
        }

        .floating-element {
            position: absolute;
            opacity: 0.1;
            animation: float 6s ease-in-out infinite;
        }

            .floating-element:nth-child(1) {
                top: 10%;
                left: 10%;
                animation-delay: 0s;
            }

            .floating-element:nth-child(2) {
                top: 20%;
                right: 10%;
                animation-delay: 2s;
            }

            .floating-element:nth-child(3) {
                bottom: 20%;
                left: 15%;
                animation-delay: 4s;
            }

            .floating-element:nth-child(4) {
                bottom: 10%;
                right: 20%;
                animation-delay: 1s;
            }

        @@keyframes float {
            0%, 100%

        {
            transform: translateY(0px) rotate(0deg);
        }

        50% {
            transform: translateY(-20px) rotate(180deg);
        }

        }

        /* Header */
        .header {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(229, 231, 235, 0.5);
            padding: 16px 32px;
            z-index: 100;
            animation: slideDown 0.8s ease-out;
        }

        .header-content {
            display: flex;
            align-items: center;
            justify-content: space-between;
            max-width: 1200px;
            margin: 0 auto;
        }

        .brand-section {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .brand-icon {
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, #f08d11 0%, #ff9f2e 100%);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 18px;
            box-shadow: 0 4px 12px rgba(240, 141, 17, 0.3);
        }

        .brand-text h1 {
            font-size: 20px;
            font-weight: 700;
            color: #111827;
            margin: 0;
        }

        .brand-text p {
            font-size: 12px;
            color: #6b7280;
            margin: 0;
        }

        .header-actions {
            display: flex;
            gap: 12px;
        }

        .header-btn {
            padding: 8px 16px;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 500;
            text-decoration: none;
            transition: all 0.3s ease;
            border: 1px solid #e5e7eb;
            background: white;
            color: #374151;
        }

            .header-btn:hover {
                background: #f3f4f6;
                transform: translateY(-1px);
            }

        /* Main Container */
        .main-container {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 100px 32px 32px;
            position: relative;
            z-index: 10;
        }

        .access-denied-container {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(20px);
            border-radius: 24px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1), 0 0 0 1px rgba(255, 255, 255, 0.5);
            padding: 64px;
            text-align: center;
            max-width: 800px;
            width: 100%;
            border: 1px solid rgba(229, 231, 235, 0.3);
            animation: slideUp 1s ease-out;
            position: relative;
            overflow: hidden;
        }

            .access-denied-container::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 4px;
                background: linear-gradient(90deg, #f08d11, #ff9f2e, #f08d11);
                background-size: 200% 100%;
                animation: shimmer 3s ease-in-out infinite;
            }

        @@keyframes shimmer {
            0%

        {
            background-position: -200% 0;
        }

        100% {
            background-position: 200% 0;
        }

        }

        /* Error Icon Section */
        .error-icon-section {
            margin-bottom: 40px;
            position: relative;
        }

        .error-icon-wrapper {
            position: relative;
            display: inline-block;
        }

        .error-icon {
            width: 120px;
            height: 120px;
            background: linear-gradient(135deg, #fee2e2 0%, #fecaca 50%, #f87171 100%);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #dc2626;
            font-size: 48px;
            margin: 0 auto;
            box-shadow: 0 20px 40px rgba(220, 38, 38, 0.2), inset 0 2px 4px rgba(255, 255, 255, 0.3);
            animation: pulse 3s ease-in-out infinite;
            position: relative;
        }

            .error-icon::before {
                content: '';
                position: absolute;
                top: -10px;
                left: -10px;
                right: -10px;
                bottom: -10px;
                border: 2px solid rgba(220, 38, 38, 0.2);
                border-radius: 50%;
                animation: ripple 2s ease-out infinite;
            }

        @@keyframes ripple {
            0%

        {
            transform: scale(0.8);
            opacity: 1;
        }

        100% {
            transform: scale(1.2);
            opacity: 0;
        }

        }

        .error-code {
            position: absolute;
            top: -20px;
            right: -20px;
            background: #f08d11;
            color: white;
            width: 60px;
            height: 60px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            font-weight: 700;
            box-shadow: 0 8px 20px rgba(240, 141, 17, 0.3);
            animation: bounce 2s ease-in-out infinite;
        }

        @@keyframes bounce {
            0%, 100%

        {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-10px);
        }

        }

        /* Content Section */
        .content-section {
            margin-bottom: 48px;
        }

        .error-title {
            font-size: 48px;
            font-weight: 800;
            background: linear-gradient(135deg, #111827, #374151);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-bottom: 16px;
            letter-spacing: -0.02em;
        }

        .error-subtitle {
            font-size: 24px;
            font-weight: 600;
            color: #dc2626;
            margin-bottom: 24px;
        }

        .error-message {
            font-size: 18px;
            color: #6b7280;
            margin-bottom: 40px;
            line-height: 1.7;
            max-width: 600px;
            margin-left: auto;
            margin-right: auto;
        }

        /* Info Cards */
        .info-cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 24px;
            margin-bottom: 48px;
        }

        .info-card {
            background: rgba(249, 250, 251, 0.8);
            border: 1px solid rgba(229, 231, 235, 0.5);
            border-radius: 16px;
            padding: 24px;
            text-align: left;
            transition: all 0.3s ease;
            backdrop-filter: blur(10px);
        }

            .info-card:hover {
                transform: translateY(-4px);
                box-shadow: 0 12px 24px rgba(0, 0, 0, 0.1);
                border-color: rgba(240, 141, 17, 0.3);
            }

        .info-card-header {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 16px;
        }

        .info-card-icon {
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, #f08d11, #ff9f2e);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 16px;
        }

        .info-card h4 {
            font-size: 16px;
            font-weight: 600;
            color: #111827;
            margin: 0;
        }

        .info-card-content {
            color: #6b7280;
            font-size: 14px;
            line-height: 1.6;
        }

            .info-card-content ul {
                list-style: none;
                padding: 0;
                margin: 12px 0 0 0;
            }

            .info-card-content li {
                display: flex;
                align-items: center;
                gap: 8px;
                margin-bottom: 8px;
                font-size: 13px;
            }

                .info-card-content li i {
                    color: #f08d11;
                    width: 16px;
                }

        /* Action Section */
        .action-section {
            margin-bottom: 40px;
        }

        .action-buttons {
            display: flex;
            gap: 20px;
            justify-content: center;
            flex-wrap: wrap;
            margin-bottom: 32px;
        }

        .btn {
            padding: 16px 32px;
            border-radius: 12px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
            border: none;
            font-family: inherit;
            position: relative;
            overflow: hidden;
        }

            .btn::before {
                content: '';
                position: absolute;
                top: 0;
                left: -100%;
                width: 100%;
                height: 100%;
                background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
                transition: left 0.5s;
            }

            .btn:hover::before {
                left: 100%;
            }

        .btn-primary {
            background: linear-gradient(135deg, #f08d11, #ff9f2e);
            color: white;
            border: 1px solid #f08d11;
            box-shadow: 0 8px 20px rgba(240, 141, 17, 0.3);
        }

            .btn-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 12px 28px rgba(240, 141, 17, 0.4);
            }

        .btn-outline {
            background: rgba(255, 255, 255, 0.8);
            color: #374151;
            border: 2px solid #e5e7eb;
            backdrop-filter: blur(10px);
        }

            .btn-outline:hover {
                background: rgba(243, 244, 246, 0.9);
                border-color: #f08d11;
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
            }

        .btn-ghost {
            background: transparent;
            color: #6b7280;
            border: 2px solid transparent;
        }

            .btn-ghost:hover {
                color: #f08d11;
                border-color: rgba(240, 141, 17, 0.2);
                background: rgba(240, 141, 17, 0.05);
            }

        /* Quick Actions */
        .quick-actions {
            display: flex;
            justify-content: center;
            gap: 16px;
            flex-wrap: wrap;
        }

        .quick-action {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 16px;
            background: rgba(249, 250, 251, 0.8);
            border: 1px solid rgba(229, 231, 235, 0.5);
            border-radius: 8px;
            color: #6b7280;
            text-decoration: none;
            font-size: 14px;
            transition: all 0.3s ease;
        }

            .quick-action:hover {
                color: #f08d11;
                border-color: rgba(240, 141, 17, 0.3);
                background: rgba(240, 141, 17, 0.05);
            }

        /* Footer */
        .footer-section {
            border-top: 1px solid rgba(229, 231, 235, 0.3);
            padding-top: 32px;
            margin-top: 32px;
        }

        .contact-info {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 24px;
            margin-bottom: 24px;
        }

        .contact-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 16px;
            background: rgba(249, 250, 251, 0.5);
            border-radius: 12px;
            border: 1px solid rgba(229, 231, 235, 0.3);
        }

        .contact-icon {
            width: 36px;
            height: 36px;
            background: linear-gradient(135deg, #f08d11, #ff9f2e);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 14px;
        }

        .contact-details h5 {
            font-size: 14px;
            font-weight: 600;
            color: #111827;
            margin: 0 0 4px 0;
        }

        .contact-details p {
            font-size: 13px;
            color: #6b7280;
            margin: 0;
        }

        .contact-link {
            color: #f08d11;
            text-decoration: none;
            font-weight: 500;
        }

            .contact-link:hover {
                color: #e07c0a;
                text-decoration: underline;
            }

        /* Animations */
        @@keyframes slideDown {
            from

        {
            opacity: 0;
            transform: translateY(-20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        @@keyframes slideUp {
            from

        {
            opacity: 0;
            transform: translateY(40px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        @@keyframes pulse {
            0%, 100%

        {
            transform: scale(1);
        }

        50% {
            transform: scale(1.05);
        }

        }

        /* Responsive Design */
        @@media (max-width: 1024px) {
            .access-denied-container

        {
            padding: 48px 32px;
        }

        .error-title {
            font-size: 40px;
        }

        .info-cards {
            grid-template-columns: 1fr;
        }

        }

        @@media (max-width: 768px) {
            .header

        {
            padding: 12px 20px;
        }

        .header-content {
            flex-direction: column;
            gap: 12px;
        }

        .main-container {
            padding: 120px 20px 32px;
        }

        .access-denied-container {
            padding: 32px 24px;
        }

        .error-icon {
            width: 100px;
            height: 100px;
            font-size: 40px;
        }

        .error-title {
            font-size: 32px;
        }

        .error-subtitle {
            font-size: 20px;
        }

        .error-message {
            font-size: 16px;
        }

        .action-buttons {
            flex-direction: column;
            align-items: center;
        }

        .btn {
            width: 100%;
            max-width: 280px;
            justify-content: center;
        }

        .contact-info {
            grid-template-columns: 1fr;
        }

        }

        @@media (max-width: 480px) {
            .access-denied-container

        {
            padding: 24px 16px;
        }

        .error-icon {
            width: 80px;
            height: 80px;
            font-size: 32px;
        }

        .error-code {
            width: 50px;
            height: 50px;
            font-size: 16px;
        }

        .error-title {
            font-size: 28px;
        }

        .btn {
            padding: 14px 24px;
            font-size: 14px;
        }

        }

        /* Loading Animation */
        .loading-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(248, 250, 252, 0.95);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 9999;
            opacity: 1;
            transition: opacity 0.5s ease;
        }

            .loading-overlay.hidden {
                opacity: 0;
                pointer-events: none;
            }

        .loading-spinner {
            width: 50px;
            height: 50px;
            border: 3px solid rgba(240, 141, 17, 0.2);
            border-top: 3px solid #f08d11;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }

        @@keyframes spin {
            0%

        {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }

        }
    </style>
</head>
<body>
    <!-- Loading Overlay -->
    <div class="loading-overlay" id="loadingOverlay">
        <div class="loading-spinner"></div>
    </div>

    <!-- Floating Elements -->
    <div class="floating-elements">
        <i class="fas fa-utensils floating-element" style="font-size: 24px;"></i>
        <i class="fas fa-shield-alt floating-element" style="font-size: 20px;"></i>
        <i class="fas fa-lock floating-element" style="font-size: 18px;"></i>
        <i class="fas fa-key floating-element" style="font-size: 22px;"></i>
    </div>

    <!-- Header -->
    <header class="header">
        <div class="header-content">
            <div class="brand-section">
                <div class="brand-icon">
                    <i class="fas fa-utensils"></i>
                </div>
                <div class="brand-text">
                    <h1>RestaurantOS</h1>
                    <p>Management System</p>
                </div>
            </div>
            <div class="header-actions">
                <a href="/help" class="header-btn">
                    <i class="fas fa-question-circle"></i>
                    Help
                </a>
                <a href="javascript:void(0);" class="header-btn open-contact-modal" data-reason="Support">
                    <i class="fas fa-headset"></i>
                    Support
                </a>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <main class="main-container">
        <div class="access-denied-container">
            <!-- Error Icon Section -->
            <div class="error-icon-section">
                <div class="error-icon-wrapper">
                    <div class="error-icon">
                        <i class="fas fa-ban"></i>
                    </div>
                    <div class="error-code">403</div>
                </div>
            </div>

            <!-- Content Section -->
            <div class="content-section">
                <h1 class="error-title">Access Denied</h1>
                <h2 class="error-subtitle">Insufficient Permissions</h2>
                <p class="error-message">
                    We're sorry, but you don't have the necessary permissions to access this resource.
                    This could be due to your current role, expired session, or security restrictions.
                </p>
            </div>

            <!-- Info Cards -->
            <div class="info-cards">
                <div class="info-card">
                    <div class="info-card-header">
                        <div class="info-card-icon">
                            <i class="fas fa-user-shield"></i>
                        </div>
                        <h4>Permission Issues</h4>
                    </div>
                    <div class="info-card-content">
                        Common permission-related causes:
                        <ul>
                            <li><i class="fas fa-dot-circle"></i> Insufficient user role</li>
                            <li><i class="fas fa-dot-circle"></i> Account not activated</li>
                            <li><i class="fas fa-dot-circle"></i> Feature not available</li>
                        </ul>
                    </div>
                </div>

                <div class="info-card">
                    <div class="info-card-header">
                        <div class="info-card-icon">
                            <i class="fas fa-clock"></i>
                        </div>
                        <h4>Session Status</h4>
                    </div>
                    <div class="info-card-content">
                        Authentication-related issues:
                        <ul>
                            <li><i class="fas fa-dot-circle"></i> Session expired</li>
                            <li><i class="fas fa-dot-circle"></i> Invalid token</li>
                            <li><i class="fas fa-dot-circle"></i> Login required</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Action Section -->
            <div class="action-section">
                <div class="action-buttons">
                    <a href="/User/login" class="btn btn-primary">
                        <i class="fas fa-sign-in-alt"></i>
                        Login Again
                    </a>
                    <a href="/Menu/Index" class="btn btn-outline">
                        <i class="fas fa-home"></i>
                        Go to Dashboard
                    </a>
                    <a href="javascript:history.back()" class="btn btn-ghost">
                        <i class="fas fa-arrow-left"></i>
                        Go Back
                    </a>
                </div>

                <div class="quick-actions">
                    <a href="/profile" class="quick-action">
                        <i class="fas fa-user"></i>
                        View Profile
                    </a>
                    <a href="/settings" class="quick-action">
                        <i class="fas fa-cog"></i>
                        Account Settings
                    </a>
                    <a href="/help/permissions" class="quick-action">
                        <i class="fas fa-info-circle"></i>
                        Learn More
                    </a>
                </div>
            </div>

            <!-- Footer Section -->
            <div class="footer-section">
                <div class="contact-info">
                    <div class="contact-item">
                        <div class="contact-icon">
                            <i class="fas fa-envelope"></i>
                        </div>
                        <div class="contact-details">
                            <h5>Email Support</h5>
                            <p>
                                <a href="javascript:void(0);" class="contact-link open-contact-modal" data-reason="Support">
                                    support@@menuoptics.com
                                </a>
                            </p>
                        </div>
                    </div>

                    <div class="contact-item">
                        <div class="contact-icon">
                            <i class="fas fa-phone"></i>
                        </div>
                        <div class="contact-details">
                            <h5>Phone Support</h5>
                            <p>
                                <a href="tel:+1234567890" class="contact-link">
                                    +1 (234) 567-8900
                                </a>
                            </p>
                        </div>
                    </div>

                    <div class="contact-item">
                        <div class="contact-icon">
                            <i class="fas fa-comments"></i>
                        </div>
                        <div class="contact-details">
                            <h5>Live Chat</h5>
                            <p>
                                <a href="/chat" class="contact-link">
                                    Start Chat Session
                                </a>
                            </p>
                        </div>
                    </div>
                </div>

                <p style="text-align: center; color: #9ca3af; font-size: 14px; margin-top: 24px;">
                    If you believe this is an error, please contact your system administrator or our support team.
                </p>
            </div>
        </div>
    </main>

    <script>
        // Hide loading overlay after page loads
        window.addEventListener('load', function() {
            setTimeout(function() {
                document.getElementById('loadingOverlay').classList.add('hidden');
            }, 1000);
        });

        // Enhanced button interactions
        document.addEventListener('DOMContentLoaded', function() {
            // Handle back button with fallback
            const backBtn = document.querySelector('.btn-ghost');
            if (backBtn) {
                backBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    if (window.history.length > 1) {
                        window.history.back();
                    } else {
                        window.location.href = '/dashboard';
                    }
                });
            }

            // Add click tracking for analytics
            document.querySelectorAll('.btn, .quick-action, .contact-link').forEach(function(element) {
                element.addEventListener('click', function() {
                    // Track user interactions
                    console.log('User clicked:', this.textContent.trim());
                });
            });

            // Auto-refresh session check
            setInterval(function() {
                // Check if user session is restored
                fetch('/api/auth/check', { method: 'HEAD' })
                    .then(response => {
                        if (response.ok) {
                            // Session restored, show notification
                            showNotification('Session restored! Redirecting...', 'success');
                            setTimeout(() => {
                                window.location.href = '/dashboard';
                            }, 2000);
                        }
                    })
                    .catch(() => {
                        // Ignore errors
                    });
            }, 30000); // Check every 30 seconds
        });

        // Notification system
        function showNotification(message, type = 'info') {
            const notification = document.createElement('div');
            notification.className = `notification notification-${type}`;
            notification.innerHTML = `
                <i class="fas fa-${type === 'success' ? 'check-circle' : 'info-circle'}"></i>
                <span>${message}</span>
                <button class="notification-close" onclick="this.parentElement.remove()">
                    <i class="fas fa-times"></i>
                </button>
            `;

            // Add notification styles
            notification.style.cssText = `
                position: fixed;
                top: 20px;
                right: 20px;
                background: white;
                border: 1px solid #e5e7eb;
                border-radius: 12px;
                padding: 16px;
                box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
                display: flex;
                align-items: center;
                gap: 12px;
                z-index: 10001;
                min-width: 300px;
                animation: slideInRight 0.3s ease;
                border-left: 4px solid ${type === 'success' ? '#10b981' : '#3b82f6'};
            `;

            document.body.appendChild(notification);

            // Auto remove after 5 seconds
            setTimeout(() => {
                if (notification.parentElement) {
                    notification.remove();
                }
            }, 5000);
        }

        // Keyboard shortcuts
        document.addEventListener('keydown', function(e) {
            // ESC key to go back
            if (e.key === 'Escape') {
                window.history.back();
            }

            // Enter key to go to dashboard
            if (e.key === 'Enter' && e.ctrlKey) {
                window.location.href = '/dashboard';
            }
        });

        // Add CSS for notification animation
        const style = document.createElement('style');
        style.textContent = `
            @@keyframes slideInRight {
                from {
                    transform: translateX(100%);
                    opacity: 0;
                }
                to {
                    transform: translateX(0);
                    opacity: 1;
                }
            }

            .notification-close {
                background: none;
                border: none;
                color: #6b7280;
                cursor: pointer;
                padding: 4px;
                border-radius: 4px;
                transition: all 0.2s ease;
            }

            .notification-close:hover {
                background: #f3f4f6;
                color: #374151;
            }
        `;
    </script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/js/contact-modal.js?v=@DateTime.Now.Ticks"></script>
    @await Html.PartialAsync("_ContactModalPartial")
</body>
</html>