@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Login";
}


<div id="error-message" class="alert alert-danger" style="display: none;"></div>
<div id="success-message" class="alert alert-success" style="display: none;"></div>

<!-- Left Side - Branding -->
<div class="auth-branding">
    <div class="branding-content">
        <div class="brand-logo" style="cursor:pointer; background:#fffffff0; border-radius: 12px; padding:10px; box-shadow: 0px 10px 15px -3px rgba(0,0,0,0.1);"
            onclick="window.location.href='@Url.Action("Index", "Home")'">
            <img src="~/images/menu optics_logo.png" style="width:200px" />
        </div>
        <div class="branding-text">
            <h2>Data Driven Insights.. <br> Simplified</h2>
        </div>
        <div class="stats-grid">
            <div class="stat-item">
                <div class="stat-number">Menu</div>
                <div class="stat-label">Costing</div>
            </div>
            <div class="stat-item">
                <div class="stat-number">Menu</div>
                <div class="stat-label">Analysis</div>
            </div>
            <div class="stat-item">
                <div class="stat-number">Menu</div>
                <div class="stat-label">Engineering</div>
            </div>
            <div class="stat-item">
                <div class="stat-number">Inventory</div>
                <div class="stat-label" id="lbl_inventoryManagement">Management</div>
                <div class="stat-label" id="lbl_inventoryManagementMobile">Inventory</div>
            </div>
        </div>
    </div>
</div>

<!-- Right Side - Login / Setup Form -->
<div class="auth-form-container">
    <div class="auth-form">

        <!-- ═══════════════════════════════════════════════════════
             STEP 1 — Email
        ════════════════════════════════════════════════════════ -->
        <div id="step-email">
            <div class="form-header">
                <h2>Welcome Back</h2>
                <p>Enter your email address to continue</p>
            </div>

            <div class="form-group">
                <label for="loginIdentifier">Email Address or Username</label>
                <div class="input-wrapper">
                    <i class="fas fa-user-circle"></i>
                    <input type="text" id="loginIdentifier" name="loginIdentifier"
                           placeholder="Enter your email or username" required>
                </div>
            </div>

            <button id="checkEmailBtn" type="button" class="btn btn-primary btn-full">
                <span class="btn-text">Continue</span>
                <i class="fas fa-spinner fa-spin btn-loading" style="display: none;"></i>
            </button>

            <div class="form-footer">
                <p>Don't have an account? <a href="@Url.Action("Register", "User")">Sign up here</a></p>
            </div>
        </div>

        <!-- ═══════════════════════════════════════════════════════
             STEP 2a — Password (IsRegistrationCompleted = 1)
        ════════════════════════════════════════════════════════ -->
        <div id="step-password" style="display: none;">
            <div class="form-header">
                <h2>Welcome Back</h2>
                <p>Sign in to your account to continue</p>
            </div>

            <div class="form-group">
                <label>Email / Username</label>
                <div class="input-wrapper">
                    <i class="fas fa-user-circle"></i>
                    <input type="text" id="confirmedIdentifier" readonly
                           style="background: var(--input-bg, #f5f5f5); cursor: default;">
                </div>
            </div>

            <div class="form-group">
                <label for="password">Password</label>
                <div class="input-wrapper">
                    <i class="fas fa-lock"></i>
                    <input type="password" id="password" name="password"
                           placeholder="Enter your password" required>
                    <button type="button" class="password-toggle"
                            onclick="togglePassword('password')">
                        <i class="fas fa-eye"></i>
                    </button>
                </div>
            </div>

            <div class="form-options">
                <label class="checkbox-label">
                    <input type="checkbox" name="remember">
                    <span class="checkmark"></span>
                    Remember me
                </label>
                <a style="display:none!important" href="#" class="forgot-password" id="forgotPasswordLink">Forgot Password?</a>
            </div>

            <!-- Hidden field carries the username resolved from CheckEmail -->
            <input type="hidden" id="resolvedUsername" />

            <button id="loginFormBtn" type="button" class="btn btn-primary btn-full">
                <span class="btn-text">Sign In</span>
                <i class="fas fa-spinner fa-spin btn-loading" style="display: none;"></i>
            </button>

            <div class="form-footer">
                <button type="button" id="backToEmailBtn"
                        class="btn btn-link p-0"
                        style="font-size:.85rem;">
                    &larr; Use a different email
                </button>
            </div>
        </div>

        <!-- ═══════════════════════════════════════════════════════
             STEP 2b — OTP Verification
                       (IsRegistrationCompleted = 0, before setup)
        ════════════════════════════════════════════════════════ -->
        <div id="step-otp" style="display: none;">
            <div class="form-header">
                <h2>Verify Your Email</h2>
                <p>We sent a 6-digit code to your email address. Enter it below to continue.</p>
            </div>

            <div class="form-group">
                <label for="otpCode">Verification Code</label>
                <div class="input-wrapper">
                    <i class="fas fa-shield-alt"></i>
                    <input type="text" id="otpCode" maxlength="6"
                           placeholder="Enter 6-digit code" autocomplete="one-time-code"
                           style="letter-spacing: 4px; font-size: 1.2rem; text-align: center;">
                </div>
            </div>

            <button id="verifyOtpBtn" type="button" class="btn btn-primary btn-full">
                <span class="btn-text">Verify &amp; Continue</span>
                <i class="fas fa-spinner fa-spin btn-loading" style="display: none;"></i>
            </button>

            <div class="form-footer" style="margin-top: 12px;">
                <span style="font-size:.85rem;">
                    Didn't receive the code?
                    <a href="#" id="resendOtpLink" style="font-size:.85rem;">Resend</a>
                </span>
                <br>
                <button type="button" id="backToEmailBtnOtp"
                        class="btn btn-link p-0"
                        style="font-size:.85rem; margin-top:6px;">
                    &larr; Use a different email
                </button>
            </div>
        </div>

        <!-- ═══════════════════════════════════════════════════════
             STEP 2c — Set Password / Complete Registration
                       (IsRegistrationCompleted = 0, after OTP)
        ════════════════════════════════════════════════════════ -->
        <div id="step-setup" style="display: none;">
            <div class="form-header">
                <h2>Complete Your Account</h2>
                <p>Set up your profile to get started</p>
            </div>

            <!-- Hidden: carries UserId from CheckEmail response -->
            <input type="hidden" id="setupUserId" />

            <div class="form-group">
                <label for="setupFirstName">First Name</label>
                <div class="input-wrapper">
                    <i class="fas fa-user"></i>
                    <input type="text" id="setupFirstName"
                           placeholder="Enter your first name">
                </div>
            </div>

            <div class="form-group">
                <label for="setupLastName">Last Name</label>
                <div class="input-wrapper">
                    <i class="fas fa-user"></i>
                    <input type="text" id="setupLastName"
                           placeholder="Enter your last name">
                </div>
            </div>

            <div class="form-group">
                <label for="setupPassword">Password</label>
                <div class="input-wrapper">
                    <i class="fas fa-lock"></i>
                    <input type="password" id="setupPassword"
                           placeholder="Create a password" required>
                    <button type="button" class="password-toggle"
                            onclick="togglePassword('setupPassword')">
                        <i class="fas fa-eye"></i>
                    </button>
                </div>
            </div>

            <div class="form-group">
                <label for="setupPasswordConfirm">Confirm Password</label>
                <div class="input-wrapper">
                    <i class="fas fa-lock"></i>
                    <input type="password" id="setupPasswordConfirm"
                           placeholder="Confirm your password" required>
                    <button type="button" class="password-toggle"
                            onclick="togglePassword('setupPasswordConfirm')">
                        <i class="fas fa-eye"></i>
                    </button>
                </div>
            </div>

            <div class="form-group">
                <label for="setupProfilePic">Profile Picture <small class="text-muted">(optional)</small></label>
                <div class="input-wrapper">
                    <i class="fas fa-image"></i>
                    <input type="file" id="setupProfilePic"
                           accept="image/*" style="padding: 8px;">
                </div>
            </div>

            <button id="completeSetupBtn" type="button" class="btn btn-primary btn-full">
                <span class="btn-text">Complete Setup &amp; Sign In</span>
                <i class="fas fa-spinner fa-spin btn-loading" style="display: none;"></i>
            </button>

            <div class="form-footer">
                <label class="checkbox-label">
                    <input type="checkbox" name="terms" required>
                    <span class="checkmark"></span>
                    I agree to the <a href="@Url.Action("TermsAndConditions", "Home")" target="_blank">Terms & Conditions</a>
                </label>
                <p>Already have an account? <a href="@Url.Action("Login", "User")">Sign in here</a></p>


                <button type="button" id="backToEmailBtnSetup"
                        class="btn btn-link p-0"
                        style="font-size:.85rem;">
                    &larr; Use a different email
                </button>
            </div>

        </div>

    </div>
</div>

@section Scripts {
    <script src="~/js/globalajax.js?v=@DateTime.Now.Ticks"></script>
    <script src="~/views-js/login.js?v=@DateTime.Now.Ticks"></script>
}
