@{
    ViewData["Title"] = "Inventory Invoices";
}

<div class="page-header">
    <div class="header-text">
        <h1>Inventory Invoices</h1>
        <p>Review supplier invoices, item breakdowns, and purchase history.</p>
    </div>
    <div class="header-actions">
        <button class="btn btn-primary" id="addInvoiceBtn">
            <i class="fas fa-plus"></i> Add Invoice
        </button>
    </div>
</div>


<!-- Stats Cards -->
<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-content">
            <div class="stat-info">
                <p class="stat-label">Total</p>
                <p class="stat-value" id="statTotalInvoices"></p>
                <p class="stat-change-text">Invoices</p>
            </div>
            <div class="stat-icon">
                <i class="fas fa-file-invoice"></i>
            </div>
        </div>
    </div>
</div>



<!-- Filters -->
<div class="filters">
    <div class="search-wrapper">
        <i class="fas fa-search"></i>
        <input type="text" placeholder="Search inventory invoices..." class="filter-search" id="invoiceSearch">
    </div>
    <button class="btn btn-outline" id="clearFilterBtn">
        <i class="fas fa-times"></i> Clear Filter
    </button>
</div>

<!-- Invoices Table Card -->
<div class="card">
    <div class="card-header">
        <h3><i class="fas fa-file-invoice-dollar"></i> Invoices List</h3>
    </div>
    <div class="card-content">
        <div class="table-container">
            <table class="data-table" id="invoicesTable">
                <thead>
                    <tr>
                        <th>Invoice #</th>
                        <th>Invoice Date</th>
                        <th>Supplier</th>
                        <th class="text-right">Total</th>
                        <th class="text-center">Items</th>
                        <th class="text-center hidden">Ingredient Names</th>
                        <th class="text-center hidden">Vendor Product Ids</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="invoicesTableBody">
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ==================== INVOICE DETAILS MODAL ==================== -->
<div class="modal" id="invoiceDetailModal">
    <div class="modal-content large-modal" style="max-width: 850px; width: 95%;">
        <div class="modal-header">
            <div style="display: flex; align-items: center; gap: 12px;">
                <div style="width: 40px; height: 40px; border-radius: 8px; background: rgba(240, 141, 17, 0.12); color: #f08d11; display: flex; align-items: center; justify-content: center; font-size: 18px;">
                    <i class="fas fa-file-invoice-dollar"></i>
                </div>
                <div>
                    <h3 id="modalInvoiceTitle" style="margin: 0; font-size: 18px; font-weight: 600;">Invoice Details</h3>
                    <p id="modalInvoiceSubtitle" style="margin: 2px 0 0 0; font-size: 13px; color: #6b7280;">View itemized breakdown</p>
                </div>
            </div>
            <button class="modal-close" onclick="closeModal('invoiceDetailModal')">&times;</button>
        </div>
        <div class="modal-body" style="padding: 24px;">
            <!-- Summary Info Bar -->
            <div class="invoice-summary-box">
                <div class="invoice-summary-item">
                    <span class="label">Invoice #</span>
                    <span class="value" id="modalInvoiceId">-</span>
                </div>
                <div class="invoice-summary-item">
                    <span class="label">Invoice Date</span>
                    <span class="value" id="modalInvoiceDate">-</span>
                </div>
                <div class="invoice-summary-item">
                    <span class="label">Supplier</span>
                    <span class="value" id="modalVendorName">-</span>
                </div>
                <div class="invoice-summary-item">
                    <span class="label">Total Amount</span>
                    <span class="value highlight" id="modalTotal">$0.00</span>
                </div>
            </div>

            <!-- Items Table -->
            <h4 style="font-size: 14px; font-weight: 600; color: #374151; margin-bottom: 10px; display: flex; align-items: center; gap: 6px;">
                <i class="fas fa-boxes" style="color: #f08d11;"></i> Purchased Items <span id="modalItemsCount">0</span>
            </h4>
            <div style="overflow-x: auto; border: 1px solid #e5e7eb; border-radius: 8px;">
                <table class="data-table" id="modalItemsTable" style="margin: 0;">
                    <thead>
                        <tr style="background: #f8fafc;">
                            <th>Ingredient</th>
                            <th class="text-center">Pack</th>
                            <th class="text-right">Qty / Weight</th>
                            <th class="text-right">Total Price</th>
                        </tr>
                    </thead>
                    <tbody id="modalItemsTableBody">
                        <tr>
                            <td colspan="4" class="text-center" style="padding: 20px; color: #6b7280;">No items found.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-outline" onclick="closeModal('invoiceDetailModal')">Close</button>
        </div>
    </div>
</div>

<!-- ==================== ADD INVOICE MODAL ==================== -->
<div class="modal" id="addInvoiceModal">
    <div class="modal-content large-modal" style="max-width: 860px; width: 95%;">
        <div class="modal-header">
            <div style="display: flex; align-items: center; gap: 12px;">
                <div style="width: 40px; height: 40px; border-radius: 8px; background: rgba(240, 141, 17, 0.12); color: #f08d11; display: flex; align-items: center; justify-content: center; font-size: 18px;">
                    <i class="fas fa-file-invoice-dollar"></i>
                </div>
                <div>
                    <h3 style="margin: 0; font-size: 18px; font-weight: 600;">Add New Invoice</h3>
                    <p style="margin: 2px 0 0 0; font-size: 13px; color: #6b7280;">Select supplier &amp; add purchased items</p>
                </div>
            </div>
            <button class="modal-close" onclick="closeAddInvoiceModal()">&times;</button>
        </div>
        <div class="modal-body">

            <!-- Row 1: Invoice #, Invoice Date, and Vendor -->
            <div class="form-row">
                <div class="form-group">
                    <label>Invoice # <span style="color: #ef4444;">*</span></label>
                    <input type="text" id="newInvoiceId" placeholder="e.g. INV-2024-001">
                </div>
                <div class="form-group">
                    <label>Invoice Date <span style="color: #ef4444;">*</span></label>
                    <input type="date" id="newInvoiceDate">
                </div>
                <div class="form-group">
                    <label>Supplier <span style="color: #ef4444;">*</span></label>
                    <select id="newInvoiceVendor" style="width: 100%;"></select>
                </div>
            </div>

            <!-- Ingredient Selector -->
            <div class="form-group">
                <label><i class="fas fa-box" style="color: #f08d11; margin-right: 6px;"></i> Add Ingredient</label>
                <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
                    <div style="flex: 1; min-width: 200px;">
                        <select id="ingredientSelector" style="width: 100%;"></select>
                    </div>
                    <button type="button" class="btn btn-primary" onclick="addIngredientRow()" style="white-space: nowrap; margin-top: 0;">
                        <i class="fas fa-plus"></i> Add
                    </button>
                    <button type="button" class="btn btn-outline" id="importInvoiceCsvBtn" style="white-space: nowrap; margin-top: 0; display: none;">
                        <i class="fas fa-file-import"></i> Import CSV
                    </button>
                    <a href="javascript:void(0)" id="downloadInvoiceSampleBtn" style="font-size: 13px; color: #f08d11; text-decoration: none; font-weight: 500; display: none; align-items: center; gap: 5px; white-space: nowrap; margin-left: 4px;">
                        <i class="fas fa-file-download"></i> Download Sample CSV
                    </a>
                    <input type="file" id="invoiceCsvFileInput" accept=".csv" style="display: none;">
                </div>
            </div>

            <!-- Items Table -->
            <div id="invoiceItemsWrapper" style="display: none;">
                <h4 style="font-size: 14px; font-weight: 600; color: #374151; margin-bottom: 10px;">
                    <i class="fas fa-list" style="color: #f08d11;"></i> Invoice Items
                </h4>
                <div style="overflow-x: auto; border: 1px solid #e5e7eb; border-radius: 8px;">
                    <table style="width: 100%; border-collapse: collapse; font-size: 13px;">
                        <thead>
                            <tr style="background: #f8fafc; border-bottom: 1px solid #e5e7eb;">
                                <th style="padding: 10px 12px; text-align: left; font-weight: 600; color: #374151;">Ingredient</th>
                                <th style="padding: 10px 8px; text-align: center; font-weight: 600; color: #374151; width: 130px;">Pack</th>
                                <th style="padding: 10px 8px; text-align: center; font-weight: 600; color: #374151; width: 100px;">Qty / Weight</th>
                                <th style="padding: 10px 8px; text-align: center; font-weight: 600; color: #374151; width: 120px;">Price</th>
                                <th style="padding: 10px 8px; text-align: center; font-weight: 600; color: #374151; width: 36px;"></th>
                            </tr>
                        </thead>
                        <tbody id="invoiceItemsBody">
                        </tbody>
                    </table>
                </div>
            </div>

            <div id="invoiceItemsEmpty" style="text-align: center; padding: 20px; color: #9ca3af; font-size: 13px;">
                <i class="fas fa-inbox" style="font-size: 28px; display: block; margin-bottom: 8px; color: #d1d5db;"></i>
                No items added yet. Select an ingredient above and click Add.
            </div>

        </div>
        <div class="modal-footer">
            <button class="btn btn-outline" onclick="closeAddInvoiceModal()">Cancel</button>
            <button class="btn btn-primary" id="submitInvoiceBtn" onclick="submitAddInvoice()">
                <i class="fas fa-save"></i> Save Invoice
            </button>
        </div>
    </div>
</div>

<!-- ==================== EDIT INVOICE MODAL ==================== -->
<div class="modal" id="editInvoiceModal">
    <div class="modal-content large-modal" style="max-width: 860px; width: 95%;">
        <div class="modal-header">
            <div style="display: flex; align-items: center; gap: 12px;">
                <div style="width: 40px; height: 40px; border-radius: 8px; background: rgba(240, 141, 17, 0.12); color: #f08d11; display: flex; align-items: center; justify-content: center; font-size: 18px;">
                    <i class="fas fa-edit"></i>
                </div>
                <div>
                    <h3 style="margin: 0; font-size: 18px; font-weight: 600;">Edit Invoice</h3>
                    <p style="margin: 2px 0 0 0; font-size: 13px; color: #6b7280;">Update invoice details &amp; purchased items</p>
                </div>
            </div>
            <button class="modal-close" onclick="closeEditInvoiceModal()">&times;</button>
        </div>
        <div class="modal-body">
            <input type="hidden" id="editInventoryInvoiceId">

            <!-- Row 1: Invoice #, Invoice Date, and Vendor -->
            <div class="form-row">
                <div class="form-group">
                    <label>Invoice # <span style="color: #ef4444;">*</span></label>
                    <input type="text" id="editInvoiceId" placeholder="e.g. INV-2024-001" disabled>
                </div>
                <div class="form-group">
                    <label>Invoice Date <span style="color: #ef4444;">*</span></label>
                    <input type="date" id="editInvoiceDate" disabled>
                </div>
                <div class="form-group">
                    <label>Supplier <span style="color: #ef4444;">*</span></label>
                    <select id="editInvoiceVendor" style="width: 100%;" disabled></select>
                </div>
            </div>

            <!-- Ingredient Selector -->
            <div class="form-group">
                <label><i class="fas fa-box" style="color: #f08d11; margin-right: 6px;"></i> Add Ingredient</label>
                <div style="display: flex; gap: 10px; align-items: flex-start;">
                    <div style="flex: 1;">
                        <select id="editIngredientSelector" style="width: 100%;"></select>
                    </div>
                    <button type="button" class="btn btn-primary" onclick="addEditIngredientRow()" style="white-space: nowrap; margin-top: 0;">
                        <i class="fas fa-plus"></i> Add
                    </button>
                </div>
            </div>

            <!-- Items Table -->
            <div id="editInvoiceItemsWrapper" style="display: none;">
                <h4 style="font-size: 14px; font-weight: 600; color: #374151; margin-bottom: 10px;">
                    <i class="fas fa-list" style="color: #f08d11;"></i> Invoice Items
                </h4>
                <div style="overflow-x: auto; border: 1px solid #e5e7eb; border-radius: 8px;">
                    <table style="width: 100%; border-collapse: collapse; font-size: 13px;">
                        <thead>
                            <tr style="background: #f8fafc; border-bottom: 1px solid #e5e7eb;">
                                <th style="padding: 10px 12px; text-align: left; font-weight: 600; color: #374151;">Ingredient</th>
                                <th style="padding: 10px 8px; text-align: center; font-weight: 600; color: #374151; width: 130px;">Pack</th>
                                <th style="padding: 10px 8px; text-align: center; font-weight: 600; color: #374151; width: 100px;">Qty / Weight</th>
                                <th style="padding: 10px 8px; text-align: center; font-weight: 600; color: #374151; width: 120px;">Price</th>
                                <th style="padding: 10px 8px; text-align: center; font-weight: 600; color: #374151; width: 36px;"></th>
                            </tr>
                        </thead>
                        <tbody id="editInvoiceItemsBody">
                        </tbody>
                    </table>
                </div>
            </div>

            <div id="editInvoiceItemsEmpty" style="text-align: center; padding: 20px; color: #9ca3af; font-size: 13px;">
                <i class="fas fa-inbox" style="font-size: 28px; display: block; margin-bottom: 8px; color: #d1d5db;"></i>
                No items added yet. Select an ingredient above and click Add.
            </div>

        </div>
        <div class="modal-footer">
            <button class="btn btn-outline" onclick="closeEditInvoiceModal()">Cancel</button>
            <button class="btn btn-primary" id="updateInvoiceBtn" onclick="submitEditInvoice()">
                <i class="fas fa-save"></i> Update Invoice
            </button>
        </div>
    </div>
</div>


@section scripts {
    <script src="~/views-js/invoices.js?v=@DateTime.Now.Ticks"></script>
}
