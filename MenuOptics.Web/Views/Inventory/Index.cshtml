@{
    ViewData["Title"] = "Inventory Reporting Suite";
}

<div class="page-header">
    <div class="header-text">
        <h1>Inventory Reporting Suite</h1>
        <p>Analyze inventory Costs of Good Sold utilizing downloaded supplier purchases and credits.</p>
    </div>
    <div class="header-actions">
        <div id="exportButtons"></div>
        <button class="btn btn-primary" id="openSaveReportModalBtn" disabled>
            <i class="fas fa-plus"></i> Start Inventory
        </button>
    </div>
</div>

<div class="filters">
    <div class="search-wrapper">
        <i class="fas fa-search"></i>
        <input type="text" placeholder="Search ingredients..." class="filter-search" id="ingredientSearch">
    </div>
    <button class="btn btn-outline" id="clear-filter"><i class="fas fa-times"></i> Clear Filters</button>
    <div class="report-select-wrapper" style="margin-left: auto;">
        <select id="reportSelector" class="form-control" style="width: 100%;">
            <option value="">-- Select Inventory --</option>
        </select>
    </div>
</div>

<div class="card" style="position: relative;">
    @* Table loading is shown by the shared LoadingComponent (wwwroot/js/loadingComponent.js) *@

    <div class="card-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
        <h3><i class="fas fa-chart-line"></i> Inventory Cost Overview</h3>
        <div id="reportActionContainer" style="display: flex; gap: 8px; align-items: center;">
            <button class="btn btn-primary" id="saveInventoryBtn" style="display: none;">
                <span class="btn-text"><i class="fas fa-plus-circle"></i> Save Inventory</span>
                <i class="fas fa-spinner fa-spin btn-loading" style="display: none;"></i>
            </button>
            <button class="btn btn-primary" id="updateInventoryBtn" disabled style="display: none;">
                <span class="btn-text"><i class="fas fa-check-circle"></i> Update Inventory</span>
                <i class="fas fa-spinner fa-spin btn-loading" style="display: none;"></i>
            </button>
        </div>
    </div>
    <div class="card-content">
        <div class="table-container">
            <table class="data-table cogs-report-table">
                <thead>
                    <tr>

                        <th>Ingredient</th>
                        <th>Size</th>
                        <th>Supplier</th>
                        <th>Opening Count</th>
                        <th>Opening Value</th>
                        <th>Purchases Quantity</th>
                        <th>Purchases Value</th>
                        <th>Closing Count</th>
                        <th>Closing Value</th>
                        <th>COGS</th>
                    </tr>
                </thead>
                <tbody>
                    @* Rows are loaded by InventorySuiteReport.js; loading is shown by the shared LoadingComponent *@
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="9" class="text-right"><strong>Total COGS:</strong></td>

                        <td id="total-cogs-value"><strong>$0.00</strong></td>
                    </tr>
                    <tr>
                        <td colspan="9" class="text-right"><strong>Total Food Revenue:</strong></td>

                        <td id="total-food-revenue-value"><strong>$0.00</strong></td>
                    </tr>
                    <tr>
                        <td colspan="9" class="text-right"><strong>Actual Food Cost:</strong></td>

                        <td id="actual-food-cost-value"><strong>0%</strong></td>
                    </tr>
                    <tr>
                        <td colspan="9" class="text-right"><strong>Theoretical Food Cost:</strong></td>
                        <td id="theoretical-food-cost-value"><strong>0%</strong></td>

                    </tr>
                    <tr>
                        <td colspan="9" class="text-right"><strong>Variance:</strong></td>
                        <td id="variance-percentage-value"><strong>0%</strong></td>

                    </tr>
                    <tr>
                        <td colspan="9" class="text-right"><strong>Variance Value:</strong></td>
                        <td id="variance-value"><strong>$0.00</strong></td>
                    </tr>

                </tfoot>
            </table>
        </div>
    </div>
</div>

<!-- Add Report Modal -->
<div class="modal" id="addReportModal">
    <div class="modal-content" style="max-width: 480px;">
        <div class="modal-header">
            <h3>Start Inventory</h3>
            <button class="modal-close" type="button">&times;</button>
        </div>
        <div class="modal-body">
            <form id="addReportForm">
                <div class="form-group">
                    <label for="reportStartDate">Start Date <span style="color:red">*</span></label>
                    <input id="reportStartDate" type="date" name="startDate" required>
                    <small id="startDateMinHint" style="display: none; font-size: 12px; color: #d97706; margin-top: 4px;">
                        <i class="fas fa-info-circle"></i> Must be on or after last report's end date: <span id="startDateMinHintVal" style="font-weight: 600; color: #b45309;"></span>
                    </small>
                </div>
                <div class="form-group">
                    <label for="reportEndDate">End Date <span style="color:red">*</span></label>
                    <input id="reportEndDate" type="date" name="endDate" required>
                </div>
            </form>
        </div>
        <div class="modal-footer">
            <button class="btn btn-outline" type="button" onclick="closeModal('addReportModal')">Cancel</button>
            <button id="saveReportBtn" class="btn btn-primary" type="button">
                <span class="btn-text">Start</span>
                <i class="fas fa-spinner fa-spin btn-loading" style="display: none;"></i>
            </button>
        </div>
    </div>
</div>

<!-- Unsaved Changes Warning Modal -->
<div class="modal" id="unsavedChangesModal">
    <div class="modal-content" style="max-width: 440px; text-align: center;">
        <div class="modal-body" style="padding: 28px 24px;">
            <div style="width: 56px; height: 56px; border-radius: 50%; background: #fef3c7; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px;">
                <i class="fas fa-exclamation-triangle" style="font-size: 26px; color: #d97706;"></i>
            </div>
            <h3 style="font-size: 18px; font-weight: 600; color: #111827; margin-bottom: 8px;">Unsaved Changes</h3>
            <p style="font-size: 14px; color: #6b7280; line-height: 1.5; margin: 0 0 24px;">
                You have unsaved closing counts for this report. If you switch to another inventory, your changes will be lost.
            </p>
            <div style="display: flex; gap: 12px; justify-content: center;">
                <button class="btn btn-outline" id="cancelSwitchReportBtn" type="button" style="flex: 1; justify-content: center;">Keep Editing</button>
                <button class="btn btn-primary" id="confirmSwitchReportBtn" type="button" style="flex: 1; justify-content: center; background: #dc2626 !important; border-color: #dc2626 !important;">Discard & Switch</button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/views-js/InventorySuiteReport.js?v=@DateTime.Now.Ticks"></script>
}