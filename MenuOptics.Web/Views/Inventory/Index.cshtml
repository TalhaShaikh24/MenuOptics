@{
    ViewData["Title"] = "Inventory Reporting Suite";
}


<style>
  
    .btn-primary {
        background: #f08d11 !important;
        color: white !important;
        border: 1px solid #f08d11 !important;
    }

    .btn:disabled, .btn[disabled] {
        opacity: 0.5 !important;
        cursor: not-allowed !important;
        pointer-events: none !important;
    }

    .btn-outline {
        background: transparent !important;
        color: #374151 !important;
        border: 1px solid #d1d5db !important;
    }

    .text-right {
        text-align: right;
    }

    .text-center {
        text-align: center;
    }

    /* Report Select2 Dropdown Styling */
    .report-select-wrapper {
        position: relative;
        min-width: 340px;
        max-width: 420px;
    }

    .report-select-wrapper .select2-container {
        width: 100% !important;
    }

    .report-select-wrapper .select2-container--default .select2-selection--single {
        height: 42px !important;
        border: 1px solid #d1d5db !important;
        border-radius: 8px !important;
        background: #ffffff !important;
        display: flex !important;
        align-items: center !important;
        position: relative !important;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05) !important;
        transition: all 0.2s ease !important;
    }

    .report-select-wrapper .select2-container--default .select2-selection--single .select2-selection__rendered {
        line-height: 40px !important;
        padding-left: 14px !important;
        padding-right: 36px !important;
        color: #374151 !important;
        font-size: 14px !important;
        font-weight: 500 !important;
        white-space: nowrap !important;
        overflow: hidden !important;
        text-overflow: ellipsis !important;
        width: 100% !important;
    }

    .report-select-wrapper .select2-container--default .select2-selection--single .select2-selection__placeholder {
        color: #9ca3af !important;
        font-weight: 400 !important;
    }

    .report-select-wrapper .select2-container--default .select2-selection--single .select2-selection__arrow {
        height: 100% !important;
        position: absolute !important;
        top: 0 !important;
        right: 10px !important;
        width: 24px !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
    }

    .report-select-wrapper .select2-container--default .select2-selection--single .select2-selection__arrow b {
        border-color: #6b7280 transparent transparent transparent !important;
        border-width: 5px 4px 0 4px !important;
    }

    .report-select-wrapper .select2-container--default.select2-container--open .select2-selection--single .select2-selection__arrow b {
        border-color: transparent transparent #6b7280 transparent !important;
        border-width: 0 4px 5px 4px !important;
    }

    .report-select-wrapper .select2-container--default.select2-container--focus .select2-selection--single,
    .report-select-wrapper .select2-container--default.select2-container--open .select2-selection--single {
        border-color: #f08d11 !important;
        box-shadow: 0 0 0 3px rgba(240, 141, 17, 0.15) !important;
        outline: none !important;
    }

    .report-select-wrapper .select2-container--default .select2-selection--single .select2-selection__clear {
        display: none !important;
    }

    .select2-dropdown {
        border: 1px solid #e5e7eb !important;
        border-radius: 8px !important;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05) !important;
        overflow: hidden !important;
        z-index: 1050 !important;
    }

    .select2-container--default .select2-results__option {
        padding: 9px 14px !important;
        font-size: 13.5px !important;
        color: #374151 !important;
    }

    .select2-container--default .select2-results__option--highlighted[aria-selected] {
        background-color: #fff7ed !important;
        color: #c2410c !important;
        font-weight: 500 !important;
    }

    .select2-container--default .select2-results__option[aria-selected="true"] {
        background-color: #ffedd5 !important;
        color: #9a3412 !important;
        font-weight: 600 !important;
    }

    td.editable-closing {
        cursor: pointer;
        transition: background-color 0.2s ease;
    }

    td.editable-closing:hover {
        background-color: #fff7ed !important;
    }

    td.editable-closing.modified-count {
        background-color: #fef3c7 !important;
        font-weight: 600;
        color: #92400e;
    }
</style>

<div class="page-header">
    <div class="header-text">
        <h1>Inventory Reporting Suite</h1>
        <p>Analyze inventory Costs of Good Sold utilizing downloaded supplier purchases and credits.</p>
    </div>
    <div class="header-actions">
        <div id="exportButtons"></div>
        <button class="btn btn-primary" id="openAddReportModalBtn" disabled>
            <i class="fas fa-plus"></i> Add Report
        </button>
    </div>
</div>


<div class="filters">
    <div class="search-wrapper">
        <i class="fas fa-search"></i>
        <input type="text" placeholder="Search ingredients..." class="filter-search" id="ingredientSearch">
    </div>
    <button class="btn btn-outline" id="clear-filter"><i class="fas fa-times"></i> Clear Filters</button>
    <div class="report-select-wrapper" style="margin-left: auto;">
        <select id="reportSelector" class="form-control" style="width: 100%;">
            <option value="">-- Select Report --</option>
        </select>
    </div>
</div>

<div class="card" style="position: relative;">
    <!-- Table Loading Overlay -->
    <div id="tableLoadingOverlay" style="display: none; position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(255, 255, 255, 0.8); z-index: 50; border-radius: 12px; align-items: center; justify-content: center; backdrop-filter: blur(2px);">
        <div style="text-align: center; background: white; padding: 22px 34px; border-radius: 12px; box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1); border: 1px solid #e5e7eb;">
            <i class="fas fa-spinner fa-spin" style="font-size: 30px; color: #f08d11; margin-bottom: 12px; display: block;"></i>
            <span id="loadingOverlayText" style="font-size: 15px; font-weight: 600; color: #1f2937;">Loading inventory report...</span>
        </div>
    </div>

    <div class="card-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
        <h3><i class="fas fa-chart-line"></i> Inventory Cost Overview</h3>
        <div id="reportActionContainer" style="display: flex; gap: 8px; align-items: center;">
            <button class="btn btn-primary" id="insertReportBtn" style="display: none;">
                <i class="fas fa-plus-circle"></i> Submit Report
            </button>
            <button class="btn btn-primary" id="updateClosingCountBtn" disabled style="display: none;">
                <i class="fas fa-check-circle"></i> Update Report
            </button>
        </div>
    </div>
    <div class="card-content">
        <div class="table-container">
            <table class="data-table cogs-report-table">
                <thead>
                    <tr>

                        <th>Ingredient</th>
                        <th>Size</th>
                        <th>Supplier</th>
                        <th>Opening Count</th>
                        <th>Opening Value</th>
                        <th>Purchases Quantity</th>
                        <th>Purchases Value</th>
                        <th>Closing Count</th>
                        <th>Closing Value</th>
                        <th>COGS</th>
                    </tr>
                </thead>
                <tbody>
                    <tr id="reportLoadingRow">
                        <td colspan="10" class="text-center" style="padding: 48px 16px; color: #6b7280;">
                            <i class="fas fa-spinner fa-spin" style="font-size: 26px; color: #f08d11; margin-bottom: 10px; display: block;"></i>
                            <span style="font-size: 14px; font-weight: 500;">Loading inventory report...</span>
                        </td>
                    </tr>
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="9" class="text-right"><strong>Total COGS:</strong></td>

                        <td id="total-cogs-value"><strong>$0.00</strong></td>
                    </tr>
                    <tr>
                        <td colspan="9" class="text-right"><strong>Total Food Revenue:</strong></td>

                        <td id="total-food-revenue-value"><strong>$0.00</strong></td>
                    </tr>
                    <tr>
                        <td colspan="9" class="text-right"><strong>Actual Food Cost:</strong></td>

                        <td id="actual-food-cost-value"><strong>0%</strong></td>
                    </tr>
                    <tr>
                        <td colspan="9" class="text-right"><strong>Theoretical Food Cost:</strong></td>
                        <td id="theoretical-food-cost-value"><strong>0%</strong></td>

                    </tr>
                    <tr>
                        <td colspan="9" class="text-right"><strong>Variance:</strong></td>
                        <td id="variance-percentage-value"><strong>0%</strong></td>

                    </tr>
                    <tr>
                        <td colspan="9" class="text-right"><strong>Variance Value:</strong></td>
                        <td id="variance-value"><strong>$0.00</strong></td>
                    </tr>

                </tfoot>
            </table>
        </div>
    </div>
</div>

<!-- Add Report Modal -->
<div class="modal" id="addReportModal">
    <div class="modal-content" style="max-width: 480px;">
        <div class="modal-header">
            <h3>Add Report</h3>
            <button class="modal-close" type="button">&times;</button>
        </div>
        <div class="modal-body">
            <form id="addReportForm">
                <div class="form-group">
                    <label for="reportStartDate">Start Date <span style="color:red">*</span></label>
                    <input id="reportStartDate" type="date" name="startDate" required>
                    <small id="startDateMinHint" style="display: none; font-size: 12px; color: #d97706; margin-top: 4px;">
                        <i class="fas fa-info-circle"></i> Must be on or after last report's end date: <span id="startDateMinHintVal" style="font-weight: 600; color: #b45309;"></span>
                    </small>
                </div>
                <div class="form-group">
                    <label for="reportEndDate">End Date <span style="color:red">*</span></label>
                    <input id="reportEndDate" type="date" name="endDate" required>
                </div>
            </form>
        </div>
        <div class="modal-footer">
            <button class="btn btn-outline" type="button" onclick="closeModal('addReportModal')">Cancel</button>
            <button id="saveReportBtn" class="btn btn-primary" type="button">Add</button>
        </div>
    </div>
</div>

<!-- Unsaved Changes Warning Modal -->
<div class="modal" id="unsavedChangesModal">
    <div class="modal-content" style="max-width: 440px; text-align: center;">
        <div class="modal-body" style="padding: 28px 24px;">
            <div style="width: 56px; height: 56px; border-radius: 50%; background: #fef3c7; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px;">
                <i class="fas fa-exclamation-triangle" style="font-size: 26px; color: #d97706;"></i>
            </div>
            <h3 style="font-size: 18px; font-weight: 600; color: #111827; margin-bottom: 8px;">Unsaved Changes</h3>
            <p style="font-size: 14px; color: #6b7280; line-height: 1.5; margin: 0 0 24px;">
                You have unsaved closing counts for this report. If you switch to another report, your changes will be lost.
            </p>
            <div style="display: flex; gap: 12px; justify-content: center;">
                <button class="btn btn-outline" id="cancelSwitchReportBtn" type="button" style="flex: 1; justify-content: center;">Keep Editing</button>
                <button class="btn btn-primary" id="confirmSwitchReportBtn" type="button" style="flex: 1; justify-content: center; background: #dc2626 !important; border-color: #dc2626 !important;">Discard & Switch</button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/views-js/InventorySuiteReport.js?v=@DateTime.Now.Ticks"></script>
}