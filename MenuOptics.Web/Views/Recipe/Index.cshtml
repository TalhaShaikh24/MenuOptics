@{
    ViewData["Title"] = "Recipes";
}

<style>
    .size-unit-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        margin-left: 8px;
        padding: 2px 10px;
        font-size: 11.5px;
        font-weight: 600;
        color: #c2410c;
        background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%);
        border: 1px solid #fed7aa;
        border-radius: 12px;
        letter-spacing: 0.2px;
        vertical-align: middle;
        box-shadow: 0 1px 3px rgba(240, 141, 17, 0.15);
        animation: unitBadgePop 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        transition: all 0.2s ease;
    }

    .size-unit-badge:hover {
        background: #ffedd5;
        border-color: #fdba74;
        box-shadow: 0 2px 5px rgba(240, 141, 17, 0.2);
    }

    .size-unit-badge i {
        font-size: 10px;
        color: #f08d11;
    }

    .size-unit-badge .unit-code {
        font-weight: 700;
        color: #9a3412;
    }

    .size-unit-badge .unit-name {
        font-weight: 500;
        color: #c2410c;
        opacity: 0.9;
    }

    @@keyframes unitBadgePop {
        0% {
            opacity: 0;
            transform: scale(0.85);
        }
        100% {
            opacity: 1;
            transform: scale(1);
        }
    }
</style>

<div class="page-header">
    <div class="header-text">
        <h1>Recipe Management</h1>
        <p>Build single and batch recipes with real-time ingredient cost tracking.</p>
    </div>
    <div class="header-actions">
        <div class="form-check" style="margin-left: 20px;">
            <input type="checkbox" class="form-check-input" id="employeeFacingRecipe">
            <label class="form-check-label" for="employeeFacingRecipe">Employee Facing Export</label>
        </div>
        <button class="btn btn-outline-success" id="exportRecipesPdfBtn">
            <i class="fas fa-file-pdf"></i> Export All PDF
        </button>
        <button class="btn btn-primary" id="addRecipeBtn" onclick="openAddRecipeModal()">
            <i class="fas fa-plus"></i>
            Add Recipe
        </button>
    </div>
</div>

<!-- Stats Card -->
<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-content">
            <div class="stat-info">
                <p class="stat-label">Total</p>
                <p class="stat-value" id="totalRecipes"></p>
                <p class="stat-change-text">Recipes</p>
            </div>
            <div class="stat-icon recipes">
                <i class="fas fa-utensils"></i>
            </div>
        </div>
    </div>
</div>

<!-- Filters -->
<div class="filters">
    <div class="search-wrapper">
        <i class="fas fa-search"></i>
        <input type="text" placeholder="Search recipes..." class="filter-search" id="recipeSearch">
    </div>
</div>

<!-- Recipes Table -->
<div class="card">
    <div class="card-header">
        <h3><i class="fas fa-utensils"></i> Recipes Overview</h3>
    </div>
    <div class="card-content">
        <div class="table-container">
            <table class="data-table" id="recipesTable">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Direction</th>
                        <th>Size</th>
                        <th>Cost</th>
                        <th>Ingredients</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

<!-- ==================== MODALS (unchanged) ==================== -->
<!-- Add Recipe Modal -->
<div class="modal" id="addRecipeModal">
    <div class="modal-content large-modal">
        <div class="modal-header">
            <h3>Add New Recipe</h3>
            <button class="modal-close" onclick="closeModal('addRecipeModal')">&times;</button>
        </div>
        <div class="modal-body">
            <form id="addRecipeForm">
                <div class="form-row">
                    <div class="form-group">
                        <label>Name <span style="color:red">*</span></label>
                        <input type="text" id="recipeName" name="name" required placeholder="Enter Recipe Name">
                    </div>
                </div>
                <div class="form-group">
                    <label>Direction <span style="color:red">*</span></label>
                    <textarea id="recipeDescription" name="description" rows="3" required placeholder="Describe the recipe, ingredients, and preparation method"></textarea>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Unit <span style="color:red">*</span></label>
                        <select id="recipeUnit" name="unit" required>
                            <option value="ba" selected>BA - Bag</option>
                            <option value="bg">BG - Bag (alt)</option>
                            <option value="bx">BX - Box</option>
                            <option value="ca">CA - Case</option>
                            <option value="cm">CM - Centimeter</option>
                            <option value="ct">CT - Carton</option>
                            <option value="dz">DZ - Dozen</option>
                            <option value="ea">EA - Each</option>
                            <option value="fl">FL - Fluid Ounce</option>
                            <option value="ft">FT - Foot</option>
                            <option value="ga">GA - Gallon</option>
                            <option value="gm">GM - Gram</option>
                            <option value="hr">HR - Hour</option>
                            <option value="in">IN - Inch</option>
                            <option value="kg">KG - Kilogram</option>
                            <option value="lb">LB - Pound</option>
                            <option value="lt">LT - Liter</option>
                            <option value="ml">ML - Milliliter</option>
                            <option value="mr">MR - Meter</option>
                            <option value="oz">OZ - Ounce</option>
                            <option value="pa">PA - Pail</option>
                            <option value="pc">PC - Piece</option>
                            <option value="pr">PR - Pair</option>
                            <option value="pt">PT - Pint</option>
                            <option value="rl">RL - Roll</option>
                            <option value="tb">TB - Tube</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label id="recipeSizeLabel">Size <span style="color:red">*</span> <span class="size-unit-badge" id="recipeSizeUnitBadge"><i class="fas fa-balance-scale"></i> (Unit)</span></label>
                        <input type="number" step="1" id="recipeSize" name="size" required placeholder="Enter Size">
                    </div>
                </div>
                <div class="form-group">
                    <label>Ingredients <span style="color:red">*</span></label>
                    <select id="ingredientsSelect" name="ingredients[]" multiple="multiple" style="width:100%" required></select>
                    <div id="ingredientsDetails" class="ingredientsDetails"></div>
                </div>
                <div class="form-group">
                    <label>Cost ($) <span style="color:red">*</span></label>
                    <input type="number" step="1" id="recipeCost" name="cost" placeholder="Enter Cost">
                </div>
            </form>
        </div>
        <div class="modal-footer">
            <button class="btn btn-outline" onclick="closeModal('addRecipeModal')">Cancel</button>
            <button class="btn btn-primary" id="saveRecipeBtn">Save Recipe</button>
        </div>
    </div>
</div>

<!-- Edit Recipe Modal -->
<div class="modal" id="editRecipeModal">
    <div class="modal-content large-modal">
        <div class="modal-header">
            <h3>Edit Recipe</h3>
            <button class="modal-close" onclick="closeModal('editRecipeModal')">&times;</button>
        </div>
        <div class="modal-body">
            <form id="editRecipeForm">
                <input type="hidden" id="editRecipeId" name="recipeId">
                <div class="form-row">
                    <div class="form-group">
                        <label>Name <span style="color:red">*</span></label>
                        <input type="text" id="editRecipeName" name="name" required placeholder="Enter Recipe Name">
                    </div>
                </div>
                <div class="form-group">
                    <label>Direction <span style="color:red">*</span></label>
                    <textarea id="editRecipeDescription" name="description" rows="3" required placeholder="Describe the recipe, ingredients, and preparation method"></textarea>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Unit <span style="color:red">*</span></label>
                        <select id="editRecipeUnit" name="unit" required>
                            <option value="" disabled>Select unit</option>
                            <option value="ba">BA - Bag</option>
                            <option value="bg">BG - Bag (alt)</option>
                            <option value="bx">BX - Box</option>
                            <option value="ca">CA - Case</option>
                            <option value="cm">CM - Centimeter</option>
                            <option value="ct">CT - Carton</option>
                            <option value="dz">DZ - Dozen</option>
                            <option value="ea">EA - Each</option>
                            <option value="fl">FL - Fluid Ounce</option>
                            <option value="ft">FT - Foot</option>
                            <option value="ga">GA - Gallon</option>
                            <option value="gm">GM - Gram</option>
                            <option value="hr">HR - Hour</option>
                            <option value="in">IN - Inch</option>
                            <option value="kg">KG - Kilogram</option>
                            <option value="lb">LB - Pound</option>
                            <option value="lt">LT - Liter</option>
                            <option value="ml">ML - Milliliter</option>
                            <option value="mr">MR - Meter</option>
                            <option value="oz">OZ - Ounce</option>
                            <option value="pa">PA - Pail</option>
                            <option value="pc">PC - Piece</option>
                            <option value="pr">PR - Pair</option>
                            <option value="pt">PT - Pint</option>
                            <option value="rl">RL - Roll</option>
                            <option value="tb">TB - Tube</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label id="editRecipeSizeLabel">Size <span style="color:red">*</span> <span class="size-unit-badge" id="editRecipeSizeUnitBadge"><i class="fas fa-balance-scale"></i> (Unit)</span></label>
                        <input type="number" step="1" id="editRecipeSize" name="size" required placeholder="Enter Size">
                    </div>
                </div>
                <div class="form-group">
                    <label>Ingredients <span style="color:red">*</span></label>
                    <select id="editIngredientsSelect" name="ingredients[]" multiple="multiple" style="width:100%" required></select>
                    <div id="editIngredientsDetails" class="ingredientsDetails"></div>
                </div>
                <div class="form-group">
                    <label>Cost ($) <span style="color:red">*</span></label>
                    <input type="number" step="1" id="editRecipeCost" name="cost" placeholder="Enter Cost">
                </div>
            </form>
        </div>
        <div class="modal-footer">
            <button class="btn btn-outline" onclick="closeModal('editRecipeModal')">Cancel</button>
            <button class="btn btn-primary" id="updateRecipeBtn">Update Recipe</button>
        </div>
    </div>
</div>


<!-- Recipe Description Popup -->
<div class="modal" id="recipeDescriptionModal">
    <div class="modal-content">
        <div class="modal-header">
            <h3>Recipe Direction</h3>
            <button class="modal-close" onclick="closeModal('recipeDescriptionModal')">&times;</button>
        </div>
        <div class="modal-body">
            <p id="recipeDescriptionPopupText" style="white-space: pre-wrap; word-break: break-word;"></p>
        </div>
        <div class="modal-footer">
            <button class="btn btn-outline" onclick="closeModal('recipeDescriptionModal')">Close</button>
        </div>
    </div>
</div>

<!-- Recipe Cost Breakdown Modal -->
<div class="modal" id="recipeCostBreakdownModal">
    <div class="modal-content large-modal" style="max-width: 750px;">
        <div class="modal-header">
            <div style="display: flex; align-items: center; gap: 10px;">
                <div style="width: 36px; height: 36px; border-radius: 8px; background: rgba(240, 141, 17, 0.1); color: #f08d11; display: flex; align-items: center; justify-content: center; font-size: 16px;">
                    <i class="fas fa-coins"></i>
                </div>
                <div>
                    <h3 id="recipeCostBreakdownName" style="margin: 0; font-size: 18px; font-weight: 600;">Cost Breakdown</h3>
                    <p id="recipeCostBreakdownUnit" style="margin: 2px 0 0 0; font-size: 13px; color: #6b7280;"></p>
                </div>
            </div>
            <button class="modal-close" onclick="closeModal('recipeCostBreakdownModal')">&times;</button>
        </div>
        <div class="modal-body" style="padding: 20px;">
            <div style="overflow-x: auto; border: 1px solid #e5e7eb; border-radius: 8px;">
                <table style="width: 100%; border-collapse: collapse; font-size: 13.5px; text-align: left;">
                    <thead>
                        <tr style="background: #f8fafc; border-bottom: 1px solid #e5e7eb;">
                            <th style="padding: 10px 14px; font-weight: 600; color: #374151;">Ingredients</th>
                            <th style="padding: 10px 14px; font-weight: 600; color: #374151;">Old Price</th>
                            <th style="padding: 10px 14px; font-weight: 600; color: #374151;">Current Price</th>
                            <th style="padding: 10px 14px; font-weight: 600; color: #374151;">Trend</th>
                        </tr>
                    </thead>
                    <tbody id="recipeCostBreakdownTableBody">
                        <!-- Loaded dynamically -->
                    </tbody>
                </table>
            </div>
            <div id="recipeCostBreakdownEmptyMsg" style="display: none; text-align: center; padding: 30px; color: #6b7280;">
                <i class="fas fa-info-circle" style="font-size: 24px; margin-bottom: 8px; color: #9ca3af; display: block;"></i>
                No ingredient details available for this recipe.
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-outline" onclick="closeModal('recipeCostBreakdownModal')">Close</button>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/views-js/recipes.js?v=@DateTime.Now.Ticks"></script>
}