@{
    ViewData["Title"] = "Sales";
}

<style>
   
    /* Modal table styling */
    .sale-item-row input[type="number"] {
        width: 100%;
        max-width: 110px;
        padding: 6px 10px;
        border: 1px solid #d1d5db;
        border-radius: 6px;
        font-size: 13px;
        text-align: center;
        background: #fff;
        transition: border-color 0.2s;
    }

    .sale-item-row input[type="number"]:focus {
        outline: none;
        border-color: #f08d11;
        box-shadow: 0 0 0 2px rgba(240, 141, 17, 0.15);
    }

    .sale-items-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }

    .sale-items-table th {
        padding: 10px 12px;
        background: #f8fafc;
        border-bottom: 1px solid #e5e7eb;
        font-weight: 600;
        color: #374151;
    }

    .sale-items-table td {
        padding: 8px 12px;
        border-bottom: 1px solid #f3f4f6;
        vertical-align: middle;
    }

    .sale-remove-btn {
        background: transparent;
        border: none;
        color: #ef4444;
        cursor: pointer;
        padding: 6px 8px;
        border-radius: 4px;
        transition: all 0.2s ease;
    }

    .sale-remove-btn:hover {
        background: #fee2e2;
        color: #dc2626;
    }

    .sale-total-badge {
        font-size: 15px;
        font-weight: 700;
        color: #0f172a;
        background: #fff7ed;
        padding: 6px 14px;
        border: 1px solid #fed7aa;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .sale-total-badge span {
        color: #ea580c;
        font-size: 17px;
    }
</style>

<div class="page-header">
    <div class="header-text">
        <h1>Sales Records</h1>
        <p>Review sales entries, item breakdowns, and revenue history.</p>
    </div>
    <div class="header-actions">
        <button class="btn btn-primary" id="addSaleBtn">
            <i class="fas fa-plus"></i> Add Sale
        </button>
    </div>
</div>

<!-- Stats Cards -->
<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-content">
            <div class="stat-info">
                <p class="stat-label">Total Sales</p>
                <p class="stat-value" id="statTotalSales"></p>
                <p class="stat-change-text">Recorded sales entries</p>
            </div>
            <div class="stat-icon">
                <i class="fas fa-cash-register"></i>
            </div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-content">
            <div class="stat-info">
                <p class="stat-label">Total Revenue</p>
                <p class="stat-value" id="statTotalRevenue"></p>
                <p class="stat-change-text">Combined sales total</p>
            </div>
            <div class="stat-icon active">
                <i class="fas fa-dollar-sign"></i>
            </div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-content">
            <div class="stat-info">
                <p class="stat-label">Items Sold</p>
                <p class="stat-value" id="statTotalItemsSold"></p>
                <p class="stat-change-text">Total units sold</p>
            </div>
            <div class="stat-icon users">
                <i class="fas fa-utensils"></i>
            </div>
        </div>
    </div>
</div>

<!-- Filters -->
<div class="filters">
    <div class="search-wrapper">
        <i class="fas fa-search"></i>
        <input type="text" placeholder="Search sales by date, item name..." class="filter-search" id="salesSearch">
    </div>
    <button class="btn btn-outline" id="clearFilterBtn">
        <i class="fas fa-times"></i> Clear Filter
    </button>
</div>

<!-- Sales Table Card -->
<div class="card">
    <div class="card-header">
        <h3><i class="fas fa-file-invoice-dollar"></i> Sales List</h3>
    </div>
    <div class="card-content">
        <div class="table-container">
            <table class="data-table" id="salesTable">
                <thead>
                    <tr>
                        <th>Sale #</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th class="text-right">Total Revenue</th>
                        <th class="text-center">Items</th>
                        <th class="hidden">Items Detail</th>
                        <th class="text-center" style="width: 60px;"></th>
                    </tr>
                </thead>
                <tbody id="salesTableBody">
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ==================== SALE DETAILS MODAL ==================== -->
<div class="modal" id="saleDetailModal">
    <div class="modal-content large-modal" style="max-width: 850px; width: 95%;">
        <div class="modal-header">
            <div style="display: flex; align-items: center; gap: 12px;">
                <div style="width: 40px; height: 40px; border-radius: 8px; background: rgba(240, 141, 17, 0.12); color: #f08d11; display: flex; align-items: center; justify-content: center; font-size: 18px;">
                    <i class="fas fa-file-invoice-dollar"></i>
                </div>
                <div>
                    <h3 id="modalSaleTitle" style="margin: 0; font-size: 18px; font-weight: 600;">Sale Details</h3>
                    <p id="modalSaleSubtitle" style="margin: 2px 0 0 0; font-size: 13px; color: #6b7280;">View itemized breakdown</p>
                </div>
            </div>
            <button class="modal-close" onclick="closeModal('saleDetailModal')">&times;</button>
        </div>
        <div class="modal-body" style="padding: 24px;">
            <!-- Summary Info Bar -->
            <div class="sales-summary-box">
                <div class="sales-summary-item">
                    <span class="label">Sale #</span>
                    <span class="value" id="modalSaleId">-</span>
                </div>
                <div class="sales-summary-item">
                    <span class="label">Start Date</span>
                    <span class="value" id="modalSaleStartDate">-</span>
                </div>
                <div class="sales-summary-item">
                    <span class="label">End Date</span>
                    <span class="value" id="modalSaleEndDate">-</span>
                </div>
                <div class="sales-summary-item">
                    <span class="label">Total Revenue</span>
                    <span class="value highlight" id="modalSaleTotal">$0.00</span>
                </div>
            </div>

            <!-- Items Table -->
            <h4 style="font-size: 14px; font-weight: 600; color: #374151; margin-bottom: 10px; display: flex; align-items: center; gap: 6px;">
                <i class="fas fa-utensils" style="color: #f08d11;"></i> Sold Items <span id="modalItemsCount">0</span>
            </h4>
            <div style="overflow-x: auto; border: 1px solid #e5e7eb; border-radius: 8px;">
                <table class="data-table" id="modalItemsTable" style="margin: 0;">
                    <thead>
                        <tr style="background: #f8fafc;">
                            <th>Menu Item</th>
                            <th class="text-center">Qty Sold</th>
                            <th class="text-right">Cost</th>
                            <th class="text-right">Revenue</th>
                        </tr>
                    </thead>
                    <tbody id="modalItemsTableBody">
                        <tr>
                            <td colspan="4" class="text-center" style="padding: 20px; color: #6b7280;">No items found.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-outline" onclick="closeModal('saleDetailModal')">Close</button>
        </div>
    </div>
</div>

<!-- ==================== ADD SALE MODAL ==================== -->
<div class="modal" id="addSaleModal">
    <div class="modal-content large-modal" style="max-width: 860px; width: 95%;">
        <div class="modal-header">
            <div style="display: flex; align-items: center; gap: 12px;">
                <div style="width: 40px; height: 40px; border-radius: 8px; background: rgba(240, 141, 17, 0.12); color: #f08d11; display: flex; align-items: center; justify-content: center; font-size: 18px;">
                    <i class="fas fa-cash-register"></i>
                </div>
                <div>
                    <h3 style="margin: 0; font-size: 18px; font-weight: 600;">Add New Sale</h3>
                    <p style="margin: 2px 0 0 0; font-size: 13px; color: #6b7280;">Select menu items &amp; enter quantities sold</p>
                </div>
            </div>
            <button class="modal-close" onclick="closeAddSaleModal()">&times;</button>
        </div>
        <div class="modal-body">
            <!-- Row 1: Start Date & End Date -->
            <div class="form-row">
                <div class="form-group">
                    <label>Start Date <span style="color: #ef4444;">*</span></label>
                    <input type="date" id="newSaleStartDate">
                </div>
                <div class="form-group">
                    <label>End Date <span style="color: #ef4444;">*</span></label>
                    <input type="date" id="newSaleEndDate">
                </div>
            </div>

            <!-- Menu Item Selector -->
            <div class="form-group">
                <label><i class="fas fa-utensils" style="color: #f08d11; margin-right: 6px;"></i> Add Menu Item</label>
                <div style="display: flex; gap: 10px; align-items: flex-start; flex-wrap: wrap;">
                    <div style="flex: 1; min-width: 220px;">
                        <select id="menuItemSelector" style="width: 100%;"></select>
                    </div>
                    <button type="button" class="btn btn-primary" onclick="addSaleItemRow()" style="white-space: nowrap; margin-top: 0;">
                        <i class="fas fa-plus"></i> Add
                    </button>
                    <div style="display: flex; flex-direction: column; gap: 3px;">
                        <button type="button" class="btn btn-outline" id="importSaleCsvBtn" style="white-space: nowrap; margin-top: 0;">
                            <i class="fas fa-file-import"></i> Import CSV
                        </button>
                        <span id="downloadSaleSampleBtn" onclick="downloadSampleSalesFile()" style="white-space: nowrap; display: inline-flex; align-items: center; gap: 6px; background: transparent;color: #f08d11; border-radius: 8px; padding: 6px 12px; font-size: 12px; font-weight: 600; cursor: pointer; transition: background 0.18s, color 0.18s;">
                            <i class="fas fa-file-download"></i> Download Sample CSV
                        </span>
                    </div>
                    <input type="file" id="saleCsvFileInput" accept=".csv" style="display: none;">
                </div>
            </div>

            <!-- Items Table Form -->
            <div id="saleItemsWrapper" style="display: none;">
                <h4 style="font-size: 14px; font-weight: 600; color: #374151; margin-bottom: 10px;">
                    <i class="fas fa-list" style="color: #f08d11;"></i> Sale Items
                </h4>
                <div style="overflow-x: auto; border: 1px solid #e5e7eb; border-radius: 8px;">
                    <table class="sale-items-table">
                        <thead>
                            <tr>
                                <th style="text-align: left;">Menu Item</th>
                                <th style="text-align: center; width: 130px;">Qty Sold</th>
                                <th style="text-align: right; width: 130px;">Cost</th>
                                <th style="text-align: right; width: 140px;">Revenue</th>
                                <th style="text-align: center; width: 44px;"></th>
                            </tr>
                        </thead>
                        <tbody id="saleItemsBody">
                        </tbody>
                    </table>
                </div>
            </div>

            <div id="saleItemsEmpty" style="text-align: center; padding: 24px; color: #9ca3af; font-size: 13px; display: flex; justify-content: center; gap: 10px; align-items: center;">
                <i class="fas fa-utensils" style="font-size: 26px; color: #d1d5db;"></i>
                No items added yet. Select a menu item above and click Add.
            </div>
        </div>
        <div class="modal-footer" style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
            <div class="sale-total-badge">
                Total Revenue: <span id="newSaleTotalDisplay">$0.00</span>
            </div>
            <div style="display: flex; gap: 8px;">
                <button class="btn btn-outline" onclick="closeAddSaleModal()">Cancel</button>
                <button class="btn btn-primary" id="submitSaleBtn" onclick="submitAddSale()">
                    <i class="fas fa-save"></i> Save Sale
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ==================== EDIT SALE MODAL ==================== -->
<div class="modal" id="editSaleModal">
    <div class="modal-content large-modal" style="max-width: 860px; width: 95%;">
        <div class="modal-header">
            <div style="display: flex; align-items: center; gap: 12px;">
                <div style="width: 40px; height: 40px; border-radius: 8px; background: rgba(240, 141, 17, 0.12); color: #f08d11; display: flex; align-items: center; justify-content: center; font-size: 18px;">
                    <i class="fas fa-edit"></i>
                </div>
                <div>
                    <h3 style="margin: 0; font-size: 18px; font-weight: 600;">Edit Sale</h3>
                    <p style="margin: 2px 0 0 0; font-size: 13px; color: #6b7280;">Update sale quantities and line items</p>
                </div>
            </div>
            <button class="modal-close" onclick="closeEditSaleModal()">&times;</button>
        </div>
        <div class="modal-body">
            <input type="hidden" id="editSaleId">

            <!-- Row 1: Start Date & End Date -->
            <div class="form-row">
                <div class="form-group">
                    <label>Start Date <span style="color: #ef4444;">*</span></label>
                    <input type="date" id="editSaleStartDate">
                </div>
                <div class="form-group">
                    <label>End Date <span style="color: #ef4444;">*</span></label>
                    <input type="date" id="editSaleEndDate">
                </div>
            </div>

            <!-- Menu Item Selector -->
            <div class="form-group">
                <label><i class="fas fa-utensils" style="color: #f08d11; margin-right: 6px;"></i> Add Menu Item</label>
                <div style="display: flex; gap: 10px; align-items: flex-start; flex-wrap: wrap;">
                    <div style="flex: 1; min-width: 220px;">
                        <select id="editMenuItemSelector" style="width: 100%;"></select>
                    </div>
                    <button type="button" class="btn btn-primary" onclick="addEditSaleItemRow()" style="white-space: nowrap; margin-top: 0;">
                        <i class="fas fa-plus"></i> Add
                    </button>
                </div>
            </div>

            <!-- Items Table Form -->
            <div id="editSaleItemsWrapper" style="display: none;">
                <h4 style="font-size: 14px; font-weight: 600; color: #374151; margin-bottom: 10px;">
                    <i class="fas fa-list" style="color: #f08d11;"></i> Sale Items
                </h4>
                <div style="overflow-x: auto; border: 1px solid #e5e7eb; border-radius: 8px;">
                    <table class="sale-items-table">
                        <thead>
                            <tr>
                                <th style="text-align: left;">Menu Item</th>
                                <th style="text-align: center; width: 130px;">Qty Sold</th>
                                <th style="text-align: right; width: 130px;">Cost</th>
                                <th style="text-align: right; width: 140px;">Revenue</th>
                                <th style="text-align: center; width: 44px;"></th>
                            </tr>
                        </thead>
                        <tbody id="editSaleItemsBody">
                        </tbody>
                    </table>
                </div>
            </div>

            <div id="editSaleItemsEmpty" style="text-align: center; padding: 24px; color: #9ca3af; font-size: 13px; display: flex; justify-content: center; gap: 10px; align-items: center;">
                <i class="fas fa-utensils" style="font-size: 26px; color: #d1d5db;"></i>
                No items added yet. Select a menu item above and click Add.
            </div>
        </div>
        <div class="modal-footer" style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
            <div class="sale-total-badge">
                Total: <span id="editSaleTotalDisplay">$0.00</span>
            </div>
            <div style="display: flex; gap: 8px;">
                <button class="btn btn-outline" onclick="closeEditSaleModal()">Cancel</button>
                <button class="btn btn-primary" id="updateSaleBtn" onclick="submitEditSale()">
                    <i class="fas fa-save"></i> Update Sale
                </button>
            </div>
        </div>
    </div>
</div>



@section scripts {
    <script src="~/views-js/sales.js?v=@DateTime.Now.Ticks"></script>
}