@{
    ViewData["Title"] = "Ingredients";
}

<div class="page-header">
    <div class="header-text">
        <h1>Ingredients</h1>
        <p>Monitor, Manage, and Maintain ingredients from multiple sources.</p>
    </div>
    <div class="header-actions">
        <button class="btn btn-primary" id="addIngredientBtn">
            <i class="fas fa-plus"></i>
            Add Ingredient
        </button>
        <button class="btn btn-primary" id="exportPdfBtn">
            <i class="fas fa-file-pdf"></i>
            Export PDF
        </button>
        <button class="btn btn-primary" id="exportCSVBtn">
            <i class="fas fa-file-csv"></i>
            Export CSV
        </button>
    </div>
</div>

<!-- Filters -->
<div class="filters">
    <div class="search-wrapper">
        <i class="fas fa-search"></i>
        <input type="text" placeholder="Search ingredients..." class="filter-search" id="ingredientSearch">
    </div>
    <!-- Supplier Filter -->
    <div class="filter-supplier form-group" style="margin-bottom:0px!important">
        <div class="input-wrapper">
            <select id="supplierFilter" required="">
                <option value="">All</option>
            </select>
        </div>
    </div>
</div>

<!-- Ingredients Table -->
<div class="card">
    <div class="card-header">
        <h3><i class="fas fa-box"></i> Ingredients Overview</h3>
    </div>
    <div class="card-content">
        <div class="table-container">
            <table class="ingredients-table data-table">
                <thead>
                    <tr>
                        @* <th><input type="checkbox" id="selectAllIngredients"></th> *@
                        <th>Ingredient</th>
                        <th>Product Id</th>
                        <th>Size</th>
                        <th>Price</th>
                        <th>Supplier</th>
                        <th>Status</th>

                        <th></th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Add Ingredient Modal -->
<div class="modal" id="addIngredientModal">
    <div class="modal-content">
        <div class="modal-header">
            <h3>Add New Ingredient</h3>
            <button class="modal-close">&times;</button>
        </div>
        <div class="modal-body">
            <form id="addIngredientForm">
                <div class="form-row">
                <div class="form-group">
                    <label>Brand <span style="color:red">*</span></label>
                    <input id="ingredientBrand" type="text" name="brand" required placeholder="Enter Ingredient Brand">
                </div>
                <div class="form-group">
                    <label>Name <span style="color:red">*</span></label>
                    <input id="ingredientName" type="text" name="name" required placeholder="Enter Ingredient Name">
                </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label for="unit">Unit <span style="color:red">*</span></label>
                        <div class="input-wrapper">
                            <select id="ingredientUnit" name="unit" required>
                                <option value="" disabled>Select unit</option>
                                <option value="ba">BA - Bag</option>
                                <option value="bg">BG - Bag (alt)</option>
                                <option value="bx">BX - Box</option>
                                <option value="ca">CA - Case</option>
                                <option value="ct">CT - Carton</option>
                                <option value="dz">DZ - Dozen</option>
                                <option value="ea">EA - Each</option>
                                <option value="fl">FL - Fluid Ounce</option>
                                <option value="ga">GA - Gallon</option>
                                <option value="gm">GM - Gram</option>
                                <option value="kg">KG - Kilogram</option>
                                <option value="lb">LB - Pound</option>
                                <option value="lt">LT - Liter</option>
                                <option value="ml">ML - Milliliter</option>
                                <option value="oz">OZ - Ounce</option>
                                <option value="pa">PA - Pail</option>
                                <option value="pc">PC - Piece</option>
                                <option value="pr">PR - Pair</option>
                                <option value="pt">PT - Pint</option>
                                <option value="rl">RL - Roll</option>
                                <option value="tb">TB - Tube</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="unit">Type <span style="color:red">*</span></label>
                        <div class="input-wrapper">
                            <select id="ingredientType" name="ingredientType" required>
                                <option value="" disabled>Select Type</option>
                                <option value="packItem">Pack Item</option>
                                <option value="catchWeight">Catch Weight Item</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label id="typeLabel">Price Per Case <span style="color:red">*</span></label>
                        <input id="ingredientPrice" type="number" name="price" placeholder="Enter Price Per Case" required>
                    </div>
                    <div class="form-group">
                        <label id="ingredientSizeLabel">Size <span style="color:red">*</span> <span class="size-unit-badge" id="ingredientSizeUnitBadge"><i class="fas fa-balance-scale"></i> (Unit)</span></label>
                        <input id="ingredientSize" type="number" name="size" placeholder="Enter Size" required>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Pack <span id="ingredientPackSizeRequired" style="color:red;">*</span></label>
                        <input id="ingredientPackSize" type="number" name="packSize" placeholder="Enter Pack">
                    </div>
                    <div class="form-group">
                        <label>Product ID <span style="color:red;">*</span></label>
                        <input id="ingredientVendorProductId" type="text" name="vendorProductId" placeholder="Enter Product ID" required>
                    </div>
                </div>
                <div class="form-group">
                    <label>Supplier <span style="color:red">*</span></label>
                    <div class="input-wrapper">
                        <select id="ingredientPrivateVendorId" name="privateVendorId" required>
                            <option value="" disabled selected>Select Supplier</option>
                        </select>
                    </div>
                </div>
            </form>
        </div>
        <div class="modal-footer">
            <button class="btn btn-outline" onclick="closeModal('addIngredientModal')">Cancel</button>
            <button id="addIngredientBtn2" class="btn btn-primary"><span class="btn-text">Save Ingredient</span><i class="fas fa-spinner fa-spin btn-loading" style="display: none;"></i></button>
        </div>
    </div>
</div>

<!-- Edit Ingredient Modal -->
<div class="modal" id="editIngredientModal">
    <div class="modal-content">
        <div class="modal-header">
            <h3>Edit Ingredient</h3>
            <button class="modal-close" onclick="closeModal('editIngredientModal')">&times;</button>
        </div>
        <div class="modal-body">
            <form id="editIngredientForm">
                <input type="hidden" id="editIngredientId" name="ingredientId">
                <div class="form-row">
                <div class="form-group">
                    <label>Brand <span style="color:red">*</span></label>
                    <input id="editIngredientBrand" type="text" name="brand" required placeholder="Enter Ingredient Brand">
                </div>
                <div class="form-group">
                    <label>Name <span style="color:red">*</span></label>
                    <input id="editIngredientName" type="text" name="name" required placeholder="Enter Ingredient Name">
                </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label for="unit">Unit <span style="color:red">*</span></label>
                        <div class="input-wrapper">
                            <select id="editIngredientUnit" name="unit" required>
                                <option value="" disabled>Select unit</option>
                                <option value="ba">BA - Bag</option>
                                <option value="bg">BG - Bag (alt)</option>
                                <option value="bx">BX - Box</option>
                                <option value="ca">CA - Case</option>
                                <option value="ct">CT - Carton</option>
                                <option value="dz">DZ - Dozen</option>
                                <option value="ea">EA - Each</option>
                                <option value="fl">FL - Fluid Ounce</option>
                                <option value="ga">GA - Gallon</option>
                                <option value="gm">GM - Gram</option>
                                <option value="kg">KG - Kilogram</option>
                                <option value="lb">LB - Pound</option>
                                <option value="lt">LT - Liter</option>
                                <option value="ml">ML - Milliliter</option>
                                <option value="oz">OZ - Ounce</option>
                                <option value="pa">PA - Pail</option>
                                <option value="pc">PC - Piece</option>
                                <option value="pr">PR - Pair</option>
                                <option value="pt">PT - Pint</option>
                                <option value="rl">RL - Roll</option>
                                <option value="tb">TB - Tube</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="unit">Type <span style="color:red">*</span></label>
                        <div class="input-wrapper">
                            <select id="editIngredientType" name="ingredientType" required>
                                <option value="" disabled>Select Type</option>
                                <option value="packItem">Pack Item</option>
                                <option value="catchWeight">Catch Weight Item</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label id="editTypeLabel">Price Per Case <span style="color:red">*</span></label>
                        <input id="editIngredientPrice" type="number" name="price" placeholder="Enter Price Per Case" required>
                    </div>
                    <div class="form-group">
                        <label id="editIngredientSizeLabel">Size <span style="color:red">*</span> <span class="size-unit-badge" id="editIngredientSizeUnitBadge"><i class="fas fa-balance-scale"></i> (Unit)</span></label>
                        <input id="editIngredientSize" type="number" name="size" placeholder="Enter Size" required>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Pack<span id="editIngredientPackSizeRequired" style="color:red; display:none">*</span></label>
                        <input id="editIngredientPackSize" type="number" name="packSize" placeholder="Enter Pack">
                    </div>
                    <div class="form-group">
                        <label>Product ID <span style="color:red;">*</span></label>
                        <input id="editIngredientVendorProductId" type="text" name="vendorProductId" placeholder="Enter Product ID" required>
                    </div>
                </div>
            </form>
        </div>
        <div class="modal-footer">
            <button class="btn btn-outline" onclick="closeModal('editIngredientModal')">Cancel</button>
            <button id="updateIngredientBtn" class="btn btn-primary"><span class="btn-text">Update Ingredient</span><i class="fas fa-spinner fa-spin btn-loading" style="display: none;"></i></button>
        </div>
    </div>
</div>

<!-- Import Ingredient Prices Modal -->
<div class="modal" id="importIngredientPricesModal">
    <div class="modal-content">
        <div class="modal-header">
            <h3>Update Ingredient Prices</h3>
            <button class="modal-close" onclick="closeModal('importIngredientPricesModal')">&times;</button>
        </div>
        <div class="modal-body">
            <form id="importIngredientPricesForm">
                <div class="form-group" style="margin-bottom: 16px;">
                    <label for="ingredientPricesFile" style="display: block; font-weight: 500; margin-bottom: 6px;">Upload CSV File <span style="color:red">*</span></label>
                    <input type="file" id="ingredientPricesFile" name="ingredientPricesFile" accept=".csv" required>
                </div>
                <p><a href="javascript:void(0)" id="downloadSamplePricesBtn"><i class="fas fa-download"></i> Download Sample File</a></p>
            </form>
        </div>
        <div class="modal-footer">
            <button class="btn btn-outline" onclick="closeModal('importIngredientPricesModal')">Cancel</button>
            <button class="btn btn-primary" id="importIngredientPricesSubmitBtn"><span class="btn-text">Import</span><i class="fas fa-spinner fa-spin btn-loading" style="display: none;"></i></button>
        </div>
    </div>
</div>

<!-- Ingredient Pricing History Modal -->
<div class="modal" id="ingredientPricingHistoryModal">
    <div class="modal-content large" style="max-width: 960px; width: 95%;">
        <div class="modal-header" style="display: flex; align-items: center; justify-content: space-between;">
            <div style="display: flex; align-items: center; gap: 12px;">
                <div class="history-modal-header-icon" style="width: 42px; height: 42px; border-radius: 8px; background: rgba(240, 141, 17, 0.12); color: #f08d11; display: flex; align-items: center; justify-content: center; font-size: 20px;">
                    <i class="fas fa-chart-line"></i>
                </div>
                <div>
                    <h3 id="historyModalIngredientName" style="margin: 0; font-size: 18px; font-weight: 600; color: #111827;">Pricing History</h3>
                    <p id="historyModalIngredientMeta" style="margin: 3px 0 0; font-size: 13px; color: #6b7280;">Historical price trends & recorded updates</p>
                </div>
            </div>
            <button class="modal-close" type="button" onclick="closeModal('ingredientPricingHistoryModal')">&times;</button>
        </div>
        <div class="modal-body" style="padding: 24px; max-height: calc(85vh - 120px); overflow-y: auto;">
            <!-- Loading Indicator -->
            <div id="historyLoadingState" style="text-align: center; padding: 60px 20px;">
                <i class="fas fa-spinner fa-spin" style="font-size: 32px; color: #f08d11; margin-bottom: 12px;"></i>
                <p style="color: #6b7280; font-size: 14px; margin: 0;">Loading pricing history...</p>
            </div>

            <!-- Empty State -->
            <div id="historyEmptyState" style="display: none; text-align: center; padding: 60px 20px;">
                <div style="width: 64px; height: 64px; border-radius: 50%; background: #f3f4f6; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px;">
                    <i class="fas fa-history" style="font-size: 28px; color: #9ca3af;"></i>
                </div>
                <h4 style="font-size: 16px; font-weight: 600; color: #374151; margin: 0 0 6px 0;">No Pricing History Found</h4>
                <p style="color: #6b7280; font-size: 13px; margin: 0;">There are no recorded price updates for this ingredient yet.</p>
            </div>

            <!-- Main Content (Stats + Tabs + Charts) -->
            <div id="historyContentContainer" style="display: none;">
                <!-- Empty / Baseline Notice Banner (shown when history is empty) -->
                <div id="historyEmptyBanner" style="display: none; background: #fffbeb; border: 1px solid #fef3c7; border-left: 4px solid #f59e0b; padding: 12px 16px; border-radius: 8px; margin-bottom: 20px;">
                    <div style="display: flex; align-items: flex-start; gap: 12px;">
                        <i class="fas fa-info-circle" style="color: #f59e0b; font-size: 18px; margin-top: 2px;"></i>
                        <div>
                            <h4 style="margin: 0; font-size: 13px; font-weight: 600; color: #92400e;" id="historyEmptyBannerTitle">No Price History Recorded Yet</h4>
                            <p style="margin: 3px 0 0; font-size: 12px; color: #b45309; line-height: 1.4;" id="historyEmptyBannerMsg">
                                This ingredient has no historical price updates logged yet. Displaying the current price as baseline. Price trends and variance will be tracked automatically as price updates are made.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Summary Metric Cards -->
                <div class="history-stats-grid">
                    <div class="stat-card">
                        <p class="stat-label">Current Price</p>
                        <p class="stat-value" id="historyStatCurrent">$0.00</p>
                        <div id="historyStatChangeBadge" class="stat-change" style="font-size: 12px;">
                            <span>--</span>
                        </div>
                    </div>
                    <div class="stat-card">
                        <p class="stat-label">Lowest Price</p>
                        <p class="stat-value" id="historyStatLowest" style="color: #059669;">$0.00</p>
                        <p class="stat-subtext" id="historyStatLowestDate" style="font-size: 11px; color: #6b7280; margin: 0;">--</p>
                    </div>
                    <div class="stat-card">
                        <p class="stat-label">Highest Price</p>
                        <p class="stat-value" id="historyStatHighest" style="color: #dc2626;">$0.00</p>
                        <p class="stat-subtext" id="historyStatHighestDate" style="font-size: 11px; color: #6b7280; margin: 0;">--</p>
                    </div>
                    <div class="stat-card">
                        <p class="stat-label">Average Price</p>
                        <p class="stat-value" id="historyStatAverage" style="color: #2563eb;">$0.00</p>
                        <p class="stat-subtext" id="historyStatCount" style="font-size: 11px; color: #6b7280; margin: 0;">0 updates</p>
                    </div>
                </div>

                <!-- Chart & Data Tabs -->
                <div class="custom-tabs style-2 history-chart-tabs" style="margin-bottom: 20px;">
                    <button type="button" class="tab-btn active" data-chart-tab="trend">
                        <i class="fas fa-chart-line"></i> Price Trend
                    </button>
                    <button type="button" class="tab-btn" data-chart-tab="stepped">
                        <i class="fas fa-chart-area"></i> Stepped Timeline
                    </button>
                    <button type="button" class="tab-btn" data-chart-tab="bar">
                        <i class="fas fa-chart-bar"></i> Price Levels
                    </button>
                    <button type="button" class="tab-btn" data-chart-tab="variance">
                        <i class="fas fa-percentage"></i> % Changes
                    </button>
                    <button type="button" class="tab-btn" data-chart-tab="table">
                        <i class="fas fa-table"></i> History Table
                    </button>
                </div>

                <!-- Tab Panes for Charts -->
                <div class="history-tab-pane" id="paneTrend" style="position: relative; height: 350px;">
                    <canvas id="historyChartTrend"></canvas>
                    <div id="trendEmptyPlaceholder" class="chart-empty-placeholder" style="display: none;">
                        <i class="fas fa-chart-line"></i>
                        <h4>No Price Trend History</h4>
                        <p>No historical price updates have been logged yet. Trend lines will appear as prices change over time.</p>
                    </div>
                </div>
                <div class="history-tab-pane" id="paneStepped" style="display: none; position: relative; height: 350px;">
                    <canvas id="historyChartStepped"></canvas>
                    <div id="steppedEmptyPlaceholder" class="chart-empty-placeholder" style="display: none;">
                        <i class="fas fa-chart-area"></i>
                        <h4>No Timeline Stages</h4>
                        <p>Stepped price duration intervals will be displayed once price revisions are recorded.</p>
                    </div>
                </div>
                <div class="history-tab-pane" id="paneBar" style="display: none; position: relative; height: 350px;">
                    <canvas id="historyChartBar"></canvas>
                    <div id="barEmptyPlaceholder" class="chart-empty-placeholder" style="display: none;">
                        <i class="fas fa-chart-bar"></i>
                        <h4>No Price Levels Comparison</h4>
                        <p>Comparison bars will show price changes between consecutive updates.</p>
                    </div>
                </div>
                <div class="history-tab-pane" id="paneVariance" style="display: none; position: relative; height: 350px;">
                    <canvas id="historyChartVariance"></canvas>
                    <div id="varianceEmptyPlaceholder" class="chart-empty-placeholder" style="display: none;">
                        <i class="fas fa-percentage"></i>
                        <h4>No Variance Data</h4>
                        <p>Price variance requires at least 2 recorded price changes to calculate percentage fluctuation.</p>
                    </div>
                </div>
                <div class="history-tab-pane" id="paneTable" style="display: none; max-height: 350px; overflow-y: auto;">
                    <table class="data-table history-data-table" style="width: 100%;">
                        <thead>
                            <tr>
                                <th style="width: 50px;">#</th>
                                <th>Date & Time</th>
                                <th>Price</th>
                                <th>Change ($)</th>
                                <th>Change (%)</th>
                                <th>Trend</th>
                            </tr>
                        </thead>
                        <tbody id="historyTableBody">
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="modal-footer" style="padding: 14px 24px; display: flex; justify-content: flex-end;">
            <button class="btn btn-outline" type="button" onclick="closeModal('ingredientPricingHistoryModal')">Close</button>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/views-js/ingredients.js?v=@DateTime.Now.Ticks"></script>
    <!-- jsPDF Library for PDF Export -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.31/jspdf.plugin.autotable.min.js"></script>
}

