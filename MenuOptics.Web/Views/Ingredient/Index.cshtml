@{
    ViewData["Title"] = "Ingredients";
}

<div class="page-header">
    <div class="header-text">
        <h1>Ingredients</h1>
        <p>Monitor, Manage, and Maintain ingredients from multiple sources.</p>
    </div>
    <div class="header-actions">
        <button class="btn btn-outline" id="linkVendorBtn">
            <i class="fas fa-link"></i>
            Import
        </button>
        <button class="btn btn-primary" id="addIngredientBtn">
            <i class="fas fa-plus"></i>
            Add Ingredient
        </button>
        <button class="btn btn-primary" id="exportPdfBtn">
            <i class="fas fa-file-pdf"></i>
            Export PDF
        </button>
        <button class="btn btn-primary" id="exportCSVBtn">
            <i class="fas fa-file-csv"></i>
            Export CSV
        </button>
    </div>
</div>

<!-- Filters -->
<div class="filters">
    <div class="search-wrapper">
        <i class="fas fa-search"></i>
        <input type="text" placeholder="Search ingredients..." class="filter-search" id="ingredientSearch">
    </div>
    <!-- Supplier Filter -->
    <div class="filter-supplier form-group" style="margin-bottom:0px!important">
        <div class="input-wrapper">
            <select id="supplierFilter" required="">
                <option value="">All</option>
            </select>
        </div>
    </div>
    <button class="btn btn-danger hidden" id="bulkDeleteBtn">
        <i class="fas fa-trash"></i>
        Delete Selected
    </button>
    <button class="btn btn-warning hidden" id="bulkToggleBtn">
        <i class="fas fa-toggle-on"></i>
        Toggle Selected
    </button>
</div>

<!-- Ingredients Table -->
<div class="card">
    <div class="card-header">
        <h3><i class="fas fa-box"></i> Ingredients Overview</h3>
    </div>
    <div class="card-content">
        <div class="table-container">
            <table class="ingredients-table data-table">
                <thead>
                    <tr>
                        @* <th><input type="checkbox" id="selectAllIngredients"></th> *@
                        <th>Ingredient</th>
                        <th>Product Id</th>
                        <th>Size</th>
                        <th>Price Per Item</th>
                        <th>Supplier</th>
                        <th>Status</th>

                        <th></th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Add Ingredient Modal -->
<div class="modal" id="addIngredientModal">
    <div class="modal-content">
        <div class="modal-header">
            <h3>Add New Ingredient</h3>
            <button class="modal-close">&times;</button>
        </div>
        <div class="modal-body">
            <form id="addIngredientForm">
                <div class="form-group">
                    <label>Ingredient Name <span style="color:red">*</span></label>
                    <input id="ingredientName" type="text" name="name" required>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label for="unit">Unit <span style="color:red">*</span></label>
                        <div class="input-wrapper">
                            <select id="ingredientUnit" name="unit" required>
                                <option value="" disabled>Select unit</option>
                                <option value="ba">BA - Bag</option>
                                <option value="bg">BG - Bag (alt)</option>
                                <option value="bx">BX - Box</option>
                                <option value="ca">CA - Case</option>
                                <option value="ct">CT - Carton</option>
                                <option value="dz">DZ - Dozen</option>
                                <option value="ea">EA - Each</option>
                                <option value="fl">FL - Fluid Ounce</option>
                                <option value="ga">GA - Gallon</option>
                                <option value="gm">GM - Gram</option>
                                <option value="kg">KG - Kilogram</option>
                                <option value="lb">LB - Pound</option>
                                <option value="lt">LT - Liter</option>
                                <option value="ml">ML - Milliliter</option>
                                <option value="oz">OZ - Ounce</option>
                                <option value="pa">PA - Pail</option>
                                <option value="pc">PC - Piece</option>
                                <option value="pr">PR - Pair</option>
                                <option value="pt">PT - Pint</option>
                                <option value="rl">RL - Roll</option>
                                <option value="tb">TB - Tube</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="unit">Type <span style="color:red">*</span></label>
                        <div class="input-wrapper">
                            <select id="ingredientType" name="ingredientType" required>
                                <option value="" disabled>Select Type</option>
                                <option value="packItem">Pack Item</option>
                                <option value="catchWeight">Catch Weight</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Price Per Item <span style="color:red">*</span></label>
                        <input id="ingredientPrice" type="number" name="price" placeholder="Enter Price Per Item" required>
                    </div>
                    <div class="form-group">
                        <label>Size <span style="color:red">*</span></label>
                        <input id="ingredientSize" type="number" name="size" placeholder="Enter Size" required>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Pack Size <span id="ingredientPackSizeRequired" style="color:red;">*</span></label>
                        <input id="ingredientPackSize" type="number" name="packSize" placeholder="Enter Pack Size">
                    </div>
                    <div class="form-group">
                        <label>Stock</label>
                        <input id="ingredientStock" type="number" name="stock" placeholder="Enter Stock" required>
                    </div>
                </div>
                <div class="form-group">
                    <label>Supplier <span style="color:red">*</span></label>
                    <div class="input-wrapper">
                        <select id="ingredientPrivateVendorId" name="privateVendorId" required>
                            <option value="" disabled selected>Select Supplier</option>
                        </select>
                    </div>
                </div>
            </form>
        </div>
        <div class="modal-footer">
            <button class="btn btn-outline" onclick="closeModal('addIngredientModal')">Cancel</button>
            <button id="addIngredientBtn2" class="btn btn-primary">Save Ingredient</button>
        </div>
    </div>
</div>

<!-- Edit Ingredient Modal -->
<div class="modal" id="editIngredientModal">
    <div class="modal-content">
        <div class="modal-header">
            <h3>Edit Ingredient</h3>
            <button class="modal-close" onclick="closeModal('editIngredientModal')">&times;</button>
        </div>
        <div class="modal-body">
            <form id="editIngredientForm">
                <input type="hidden" id="editIngredientId" name="ingredientId">
                <div class="form-group">
                    <label>Ingredient Name <span style="color:red">*</span></label>
                    <input id="editIngredientName" type="text" name="name" required>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label for="unit">Unit <span style="color:red">*</span></label>
                        <div class="input-wrapper">
                            <select id="editIngredientUnit" name="unit" required>
                                <option value="" disabled>Select unit</option>
                                <option value="ba">BA - Bag</option>
                                <option value="bg">BG - Bag (alt)</option>
                                <option value="bx">BX - Box</option>
                                <option value="ca">CA - Case</option>
                                <option value="ct">CT - Carton</option>
                                <option value="dz">DZ - Dozen</option>
                                <option value="ea">EA - Each</option>
                                <option value="fl">FL - Fluid Ounce</option>
                                <option value="ga">GA - Gallon</option>
                                <option value="gm">GM - Gram</option>
                                <option value="kg">KG - Kilogram</option>
                                <option value="lb">LB - Pound</option>
                                <option value="lt">LT - Liter</option>
                                <option value="ml">ML - Milliliter</option>
                                <option value="oz">OZ - Ounce</option>
                                <option value="pa">PA - Pail</option>
                                <option value="pc">PC - Piece</option>
                                <option value="pr">PR - Pair</option>
                                <option value="pt">PT - Pint</option>
                                <option value="rl">RL - Roll</option>
                                <option value="tb">TB - Tube</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="unit">Type <span style="color:red">*</span></label>
                        <div class="input-wrapper">
                            <select id="editIngredientType" name="ingredientType" required>
                                <option value="" disabled>Select Type</option>
                                <option value="packItem">Pack Item</option>
                                <option value="catchWeight">Catch Weight</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Price Per Item <span style="color:red">*</span></label>
                        <input id="editIngredientPrice" type="number" name="price" placeholder="Enter Price Per Item" required>
                    </div>
                    <div class="form-group">
                        <label>Size <span style="color:red">*</span></label>
                        <input id="editIngredientSize" type="number" name="size" placeholder="Enter Size" required>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Pack Size <span id="editIngredientPackSizeRequired" style="color:red; display:none">*</span></label>
                        <input id="editIngredientPackSize" type="number" name="packSize" placeholder="Enter Pack Size">
                    </div>
                    <div class="form-group editIngredientStock" style="display:none">
                        <label>Stock</label>
                        <input id="editIngredientStock" type="number" name="stock" placeholder="Enter Stock">
                    </div>
                </div>
            </form>
        </div>
        <div class="modal-footer">
            <button class="btn btn-outline" onclick="closeModal('editIngredientModal')">Cancel</button>
            <button id="updateIngredientBtn" class="btn btn-primary">Update Ingredient</button>
        </div>
    </div>
</div>

<!-- Link Vendor Modal -->
<div class="modal" id="linkVendorModal">
    <div class="modal-content modal-large">
        <div class="modal-header">
            <h3>Import distributor</h3>
            <button class="modal-close">&times;</button>
        </div>
        <div class="modal-body">
            <!-- Tab Navigation -->
            <div class="tab-navigation">
                <button class="tab-btn active" data-tab="addVendor">Import from distributor</button>
                <button class="tab-btn" data-tab="linkedVendors">Imported distributors</button>
            </div>

            <!-- Add Vendor Tab -->
            <div class="tab-content active" id="addVendorTab">
                <div class="vendor-grid"></div>
                <div class="empty-state add-vendor-empty" style="display: none;">
                    <h2 style="text-align: center;">No Distributors Available to Import</h2>
                </div>
            </div>

            <!-- Linked Vendors Tab -->
            <div class="tab-content" id="linkedVendorsTab">
                <div class="linked-vendors-list"></div>
                <div class="empty-state linked-vendor-empty" style="display: none;">
                    <h2 style="text-align: center;">No Vendors Are Linked</h2>
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-outline" onclick="closeModal('linkVendorModal')">Close</button>
        </div>
    </div>
</div>

<!-- Add Stock Modal -->
<div class="modal" id="addStockModal">
    <div class="modal-content">
        <div class="modal-header">
            <h3>Add Stock</h3>
            <button class="modal-close" onclick="closeModal('addStockModal')">&times;</button>
        </div>
        <div class="modal-body">
            <form id="addStockForm">
                <input type="hidden" id="addStockIngredientId">

                <div class="form-group">
                    <label for="stock">Add Stock</label>
                    <input type="number" id="addStock" name="stock" placeholder="Enter Stock" required min="1">
                </div>
            </form>
        </div>
        <div class="modal-footer">
            <button class="btn btn-outline" onclick="closeModal('addStockModal')">Cancel</button>
            <button id="saveStockBtn" class="btn btn-primary">Add Stock</button>
        </div>
    </div>
</div>


@section scripts {
    <script src="~/views-js/ingredients.js?v=@DateTime.Now.Ticks"></script>
    <!-- jsPDF Library for PDF Export -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.31/jspdf.plugin.autotable.min.js"></script>
}

