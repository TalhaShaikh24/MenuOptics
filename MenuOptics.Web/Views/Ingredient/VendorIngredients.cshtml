@{
    ViewData["Title"] = "Ingredients";
}

<div class="page-header">
    <div class="header-text">
        <h1>Ingredients</h1>
        <p>Monitor and manage ingredients.</p>
    </div>
    <div class="header-actions">
        <button class="btn btn-primary" id="addIngredientBtn">
            <i class="fas fa-plus"></i>
            Add Ingredient
        </button>
    </div>
</div>

<div class="filters">
    <div class="search-wrapper">
        <i class="fas fa-search"></i>
        <input type="text" placeholder="Search ingredients..." class="filter-search" id="ingredientSearch">
    </div>
    <button class="btn btn-danger" id="bulkDeleteBtn">
        <i class="fas fa-trash"></i>
        Delete Selected
    </button>
    <button class="btn btn-warning" id="bulkToggleBtn">
        <i class="fas fa-toggle-on"></i>
        Toggle Selected
    </button>
</div>

<div class="card">
    <div class="card-header">
        <h3><i class="fas fa-box"></i> Ingredients Overview</h3>
    </div>
    <div class="card-content">
        <div class="table-container">
            <table class="ingredients-table data-table">
                <thead>
                    <tr>
                        <th><input type="checkbox" id="selectAllIngredients"></th>
                        <th>Ingredient</th>
                        <th>Unit</th>
                        <th>Status</th>
                        <th>Created Date</th>
                        <th>Price</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal" id="addIngredientModal">
    <div class="modal-content">
        <div class="modal-header">
            <h3>Add New Ingredient</h3>
            <button class="modal-close">&times;</button>
        </div>
        <div class="modal-body">
            <form id="addIngredientForm">
                <div class="form-group">
                    <label>Ingredient Name</label>
                    <input id="ingredientName" type="text" name="name" required>
                </div>
                <div class="form-group">
                    <label>Ingredient Description</label>
                    <textarea id="ingredientDescription" name="description" required></textarea>
                </div>
                <div class="form-group">
                    <label for="unit">Unit</label>
                    <div class="input-wrapper">
                        <select id="ingredientUnit" name="unit" required>
                            <option value="" disabled selected>Select unit</option>
                            <option value="g">g</option>
                            <option value="kg">kg</option>
                            <option value="lbs">lbs</option>
                            <option value="oz">oz</option>
                            <option value="ml">ml</option>
                            <option value="l">l</option>
                            <option value="pcs">pcs</option>
                        </select>
                    </div>
                </div>
                <div class="form-group">
                    <label>Price</label>
                    <input id="ingredientPrice" type="number" name="price" placeholder="Enter Price" required>
                </div>
            </form>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-outline modal-close">Cancel</button>
            <button id="addIngredientBtn2" class="btn btn-primary">Save Ingredient</button>
        </div>
    </div>
</div>

<div class="modal" id="editIngredientModal">
    <div class="modal-content">
        <div class="modal-header">
            <h3>Edit Ingredient</h3>
            <button class="modal-close">&times;</button>
        </div>
        <div class="modal-body">
            <form id="editIngredientForm">
                <input type="hidden" id="editIngredientId" name="ingredientId">
                <div class="form-group">
                    <label>Ingredient Name</label>
                    <input id="editIngredientName" type="text" name="name" required>
                </div>
                <div class="form-group">
                    <label>Ingredient Description</label>
                    <textarea id="editIngredientDescription" name="description" required></textarea>
                </div>
                <div class="form-group">
                    <label for="unit">Unit</label>
                    <div class="input-wrapper">
                        <select id="editIngredientUnit" name="unit" required>
                            <option value="" disabled>Select unit</option>
                            <option value="g">g</option>
                            <option value="kg">kg</option>
                            <option value="lbs">lbs</option>
                            <option value="oz">oz</option>
                            <option value="ml">ml</option>
                            <option value="l">l</option>
                            <option value="pcs">pcs</option>
                        </select>
                    </div>
                </div>
                <div class="form-group">
                    <label>Price</label>
                    <input id="editIngredientPrice" type="number" name="price" placeholder="Enter Price" required>
                </div>
            </form>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-outline modal-close">Cancel</button>
            <button id="updateIngredientBtn" class="btn btn-primary">Update Ingredient</button>
        </div>
    </div>
</div>

<script src="~/views-js/vendoringredients.js?v=@DateTime.Now.Ticks"></script>