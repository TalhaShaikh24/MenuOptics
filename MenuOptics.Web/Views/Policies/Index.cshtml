@{
    ViewData["Title"] = "Policy Management";
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">

<div class="page-header">
    <div class="header-text">
        <h1>Policy Management</h1>
        <p>Manage legal documents, privacy policies, and terms of service.</p>
    </div>
    <div class="header-actions">
        <button class="btn btn-primary" id="savePolicyBtn">
            <span class="btn-text"><i class="fas fa-save"></i> Save Changes</span>
            <i class="fas fa-spinner fa-spin btn-loading" style="display: none;"></i>
        </button>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <div class="tabs-container">
            <button class="tab-btn" data-type="Terms">
                <i class="fas fa-file-contract"></i> Terms & Conditions
            </button>
        </div>
    </div>

    <div class="card-content" style="padding: 20px;">
        <input type="hidden" id="currentPolicyType" value="Privacy" />

        <div class="editor-container">
            <textarea id="policyEditor"></textarea>
        </div>
    </div>
</div>

@section scripts {
    <!-- CKEditor 4 - No CORS issues, very stable -->
    <script src="https://cdn.ckeditor.com/4.22.1/standard/ckeditor.js"></script>

    <!-- Your custom scripts -->
    <script src="~/views-js/policies.js?v=@DateTime.Now.Ticks"></script>
}