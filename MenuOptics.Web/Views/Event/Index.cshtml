@{
    ViewData["Title"] = "Event & Catering Costing";
}

<div class="page-header">
    <div class="header-text">
        <h2>Event & Catering Costing</h2>
        <p>Manage your events, costs, and margins.</p>
    </div>
    <div class="header-actions">
        <!-- Add this to Index.cshtml, inside <div class="filters"> -->
        <div class="form-check" style="margin-left: 20px;">
            <input type="checkbox" class="form-check-input" id="customerFacing">
            <label class="form-check-label" for="customerFacing">Customer Facing Quote</label>
        </div>
        <button class="btn btn-outline-success" id="exportPdfBtn">
            <i class="fas fa-file-pdf"></i> Export PDF
        </button>
        <button class="btn btn-outline-primary" id="exportCsvBtn">
            <i class="fas fa-file-csv"></i> Export CSV
        </button>
        <button class="btn btn-primary" onclick="openNewEventModal()">
            <i class="fas fa-plus"></i> New Event
        </button>
    </div>
</div>

<div class="filters">
    <div class="search-wrapper">
        <i class="fas fa-search"></i>
        <input type="text" placeholder="Search events..." class="filter-search" id="eventSearch">
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3><i class="fas fa-calendar-alt"></i> Events Overview</h3>
    </div>
    <div class="card-content">
        <div class="table-container">
            <table class="table data-table events-table">
                <thead>
                    <tr>
                        <th>Event Details</th>
                        <th>Guests</th>
                        <th>Price per Guest</th>
                        <th>Total Cost</th>
                        <th>Total Event Cost</th>
                        <th>Profit</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal" id="eventModal">
    <div class="modal-content large">
        <div class="modal-header">
            <h3 id="eventModalTitle">Event Costing</h3>
            <button class="modal-close" onclick="closeModal('eventModal')">&times;</button>
        </div>
        <div class="modal-body">
            <form id="addEventForm">
                <input type="hidden" id="eventId">

                <h4 class="event-heading">Event Details</h4>
                <div class="form-row">
                    <div class="form-group">
                        <label>Event Name <span style="color:red">*</span></label>
                        <input type="text" id="eventName" class="form-control" placeholder="Enter event name">
                    </div>
                    <div class="form-group">
                        <label>Event Date <span style="color:red">*</span></label>
                        <input type="datetime-local" id="eventDate" class="form-control">
                    </div>
                    <div class="form-group">
                        <label>Number of Guests <span style="color:red">*</span></label>
                        <input type="number" id="guestCount" class="form-control" placeholder="0">
                    </div>
                    <div class="form-group">
                        <label>Price Per Guest <span style="color:red">*</span></label>
                        <input type="number" id="pricePerGuest" class="form-control" placeholder="0.00">
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group" style="width: 100%;">
                        <label>Note <span>(Optional)</span></label>
                        <textarea id="noteText" class="form-control" rows="3" placeholder="Add note about this event (vendors, special requests, reminders, etc.)"></textarea>
                    </div>
                </div>
                <hr />
                <h4 class="event-heading" style="margin-top: 18px;">Contact Information</h4>
                <div class="form-row">
                    <div class="form-group">
                        <label>Location <span style="color:red">*</span></label>
                        <input type="text" id="location" class="form-control" placeholder="Event location">
                    </div>
                    <div class="form-group">
                        <label>Contact Name <span style="color:red">*</span></label>
                        <input type="text" id="contactName" class="form-control" placeholder="Full name">
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Contact Email <span style="color:red">*</span></label>
                        <input type="email" id="contactEmail" class="form-control" placeholder="email@example.com">
                    </div>
                    <div class="form-group">
                        <label>Contact Phone <span style="color:red">*</span></label>
                        <input type="tel" id="contactPhone" class="form-control" placeholder="Mobile/Phone">
                    </div>
                </div>

                <hr />

                <div class="custom-tabs style-2" style="margin: 12px 0;">
                    <button type="button" class="tab-btn active" onclick="openTab(event, 'tab-menu-items')">
                        Menu Items
                    </button>
                    <button type="button" class="tab-btn" onclick="openTab(event, 'tab-event-items')">
                        Event Items
                    </button>
                </div>
                <div class="form-row">
                    <div class="form-group">
                <div id="tab-menu-items" class="tab-content-area active">
                    <label>Add Menu Items</label>
                    <select id="menuItemSelect"  multiple="multiple" style="width: 100%;"></select>
                </div>

                <div id="tab-event-items" class="tab-content-area">
                    <div style="display:flex; gap:10px; align-items:flex-end;">
                        <div style="flex-grow:1;">
                            <label>Add Event Items</label>
                            <select id="eventOnlyItemSelect" multiple="multiple" style="width: 100%;"></select>
                        </div>
                        <button type="button" class="btn btn-outline-primary" onclick="openCreateCustomItemModal()">
                            + New
                        </button>
                    </div>
                </div>
                </div>
                </div>

                <div class="event-items-header">
                    <span style="min-width:140px; flex-grow:1;">Item</span>
                    <span style="min-width:70px; text-align:right;">Cost</span>
                    <span style="min-width:95px; text-align:center;">Price</span>
                    <span style="width:90px;">Qty</span>
                    <span style="min-width:80px; text-align:right;">Total</span>
                    <span style="width:24px;"></span>
                </div>

                <div id="eventItemsContainer" class="ingredientsDetails" style="margin-top: 0px; margin-bottom:18px; max-height: 300px; overflow-y: auto;">
                </div>

                <hr />
                <h4 class="event-heading" style="margin-top: 18px;">Financial Summary</h4>

                <div class="totals p-3 bg-light rounded mt-3">
                    <div class="grid-container">
                        <div class="grid-item">
                            <small>Total Revenue</small>
                            <h4 id="totalRevenue" class="text-success">$0.00</h4>
                        </div>
                        <div class="grid-item">
                            <small>Total Cost</small>
                            <h4 id="totalFoodCost" class="text-danger">$0.00</h4>
                        </div>
                        <div class="grid-item">
                            <small>Cost per Guest</small>
                            <h4 id="costPerGuest" class="text-danger">$0.00</h4>
                        </div>
                        <div class="grid-item">
                            <small>Cost %</small>
                            <h4 id="foodCostPercent">0%</h4>
                        </div>
                        <div class="grid-item">
                            <small>Gross Margin</small>
                            <h4 id="grossMargin" class="text-success">$0.00</h4>
                        </div>
                        <div class="grid-item">
                            <small>Margin %</small>
                            <h4 id="grossMarginPercent">0%</h4>
                        </div>
                    </div>
                </div>

            </form>
        </div>
        <div class="modal-footer">
            <button class="btn btn-primary" onclick="saveEvent()">Save Event</button>
            <button class="btn btn-light" onclick="closeModal('eventModal')">Cancel</button>
        </div>
    </div>
</div>

<div class="modal" id="customItemModal" style="z-index: 1060;">
    <div class="modal-content small">
        <div class="modal-header">
            <h4>Add Event Item</h4>
            <button class="modal-close" onclick="closeModal('customItemModal')">&times;</button>
        </div>
        <div class="modal-body">
            <div class="form-group">
                <label>Item Name</label>
                <input type="text" id="newCustomName" class="form-control" placeholder="e.g. DJ Service">
            </div>
            <div class="form-group">
                <label>Cost</label>
                <input type="number" id="newCustomCost" class="form-control" placeholder="0.00" step="0.01">
            </div>
            <div class="form-group">
                <label>Selling Price</label>
                <input type="number" id="newCustomSellingPrice" class="form-control" placeholder="0.00" step="0.01">
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-success" onclick="saveNewCustomItem()">Create & Add</button>
        </div>
    </div>
</div>





<div id="customerDetailsModal" class="modal" style="display:none;">
    <div class="modal-content">
        <div class="modal-header">
            <h3>Customer Quote Details</h3>
            <span class="close" onclick="closeModal('customerDetailsModal')">&times;</span>
        </div>

        <div class="modal-body">
            <input type="hidden" id="exportEventId">

            <!-- Row 1 -->
            <div class="form-row">
                <div class="form-group">
                    <label>Quote #</label>
                    <input type="text" class="form-control" id="quoteNumber" placeholder="e.g., INV-00001">
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Customer Name</label>
                    <input type="text" id="custName" class="form-control" placeholder="Enter name">
                </div>
                <div class="form-group">
                    <label>Company</label>
                    <input type="text" id="custCompany" class="form-control" placeholder="Enter company">
                </div>
            </div>

            <!-- Row 2 -->
            <div class="form-row">
                <div class="form-group">
                    <label>Phone</label>
                    <input type="text" id="custPhone" class="form-control" placeholder="Enter phone">
                </div>
                <div class="form-group">
                    <label>Email</label>
                    <input type="email" id="custEmail" class="form-control" placeholder="Enter email">
                </div>
            </div>

            <!-- Row 3 -->
            <div class="form-row">
                <div class="form-group">
                    <label>Address</label>
                    <input type="text" id="custAddress" class="form-control" placeholder="Enter address">
                </div>
            </div>

            <!-- Row 4 -->
            <div class="form-row">
                

                <div class="form-group">
                    <label>Date</label>
                    <input type="date" class="form-control" id="quoteDate">
                </div>

                <div class="form-group">
                    <label>Valid Until</label>
                    <input type="date" class="form-control" id="quoteValidUntil">
                </div>
            </div>

            <!-- Row 5 -->
            <div class="form-row">
                <div class="form-group">
                    <label>Note for PDF</label>
                    <textarea id="custNote" class="form-control" rows="2"
                              placeholder="Additional notes for this quote..."></textarea>
                </div>

                <div class="form-group">
                    <label>T & C</label>
                    <textarea class="form-control" id="quoteTerms" rows="2"
                              placeholder="e.g., 50% deposit required. Balance due on event day."></textarea>
                </div>
            </div>

          

        </div>

        <div class="modal-footer">
            <button class="btn btn-secondary" onclick="closeModal('customerDetailsModal')">Cancel</button>
            <button class="btn btn-primary" onclick="processCustomerQuote()">Generate PDF</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/views-js/events.js?v=@DateTime.Now.Ticks"></script>
    <style>
        .nav-tabs .nav-link {
            cursor: pointer;
        }

        .badge-menu {
            background-color: #d4edda;
            color: #155724;
            padding: 2px 6px;
            border-radius: 4px;
            font-size: 0.75rem;
            margin-right: 5px;
        }

        .badge-event {
            background-color: #cce5ff;
            color: #004085;
            padding: 2px 6px;
            border-radius: 4px;
            font-size: 0.75rem;
            margin-right: 5px;
        }

        .dt-buttons{
            display:none!important;
        }
    </style>
}
