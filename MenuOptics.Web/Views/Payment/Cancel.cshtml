@{
    Layout = "_LandingLayout";
    ViewData["Title"] = "Payment Cancelled";
    bool isAuthenticated = User?.Identity?.IsAuthenticated ?? false;
    string dashboardUrl = (User?.IsInRole("Restaurant") ?? false) ? (Url.Action("Index", "Menu") ?? "/Menu/Index") : (Url.Action("Index", "User") ?? "/User/Index");
}

<!-- ═════════════════════════════════════════════════════════════════
     HEADER: Logo & Theme Switcher
     ═════════════════════════════════════════════════════════════════ -->
<header class="landing-header">
    <div class="landing-container nav-wrapper">
        <a href="@Url.Action("Index", "Home")" class="brand-logo-link">
            <img src="~/images/menu optics_light_logo.png" alt="Menu Optics Logo" />
        </a>

        <div class="nav-actions">
            <button class="theme-toggle-btn hidden" id="themeToggleBtn" title="Switch Theme" aria-label="Switch Theme">
                <i class="fas fa-sun" id="themeIcon"></i>
            </button>
            @if (isAuthenticated)
            {
                <a href="@dashboardUrl" class="btn-landing-primary">
                    <i class="fas fa-th-large"></i> Go to Dashboard
                </a>
            }
            else
            {
                <a href="@Url.Action("Login", "User")" class="btn-landing-outline">
                    <i class="fas fa-sign-in-alt"></i> Sign In
                </a>
            }
        </div>
    </div>
</header>

<!-- ═════════════════════════════════════════════════════════════════
     PAYMENT CANCEL CONTENT
     ═════════════════════════════════════════════════════════════════ -->
<section class="payment-status-section">
    <div class="hero-glow-bg"></div>

    <div class="landing-container payment-status-wrapper hero-container-relative">
        <div class="payment-status-card cancel-card reveal">

            <!-- Brand Logo -->
            <div class="hero-logo-wrapper" style="margin-bottom: 20px;">
                <img src="~/images/menu optics_light_logo.png" alt="Menu Optics Logo" class="hero-main-logo" style="height: 52px;" />
            </div>

            <!-- Status Icon -->
            <div class="payment-status-icon-box cancel-icon">
                <i class="fas fa-exclamation-triangle"></i>
            </div>

            <h1 class="payment-status-title">
                Payment <span class="gradient-amber-text">Cancelled</span>
            </h1>
            <div class="payment-status-subtitle">
                No charges were made to your account
            </div>
            <p class="payment-status-desc">
                Your payment transaction was cancelled or was not completed. If you experienced any difficulty or have questions regarding our subscription plans, our support team is available to assist you.
            </p>

            <!-- Action Buttons -->
            <div class="payment-status-actions">
                @if (isAuthenticated)
                {
                    <a href="@Url.Action("Index", "Subscription")" class="btn-landing-primary btn-landing-lg">
                        <i class="fas fa-redo"></i> Return to Subscriptions
                    </a>
                }
                else
                {
                    <a href="@Url.Action("Register", "User")" class="btn-landing-primary btn-landing-lg">
                        <i class="fas fa-redo"></i> Try Again / Register
                    </a>
                }
                <a href="mailto:admin@menuoptics.com" class="btn-landing-outline btn-landing-lg">
                    <i class="fas fa-envelope"></i> Contact Support
                </a>
                <a href="@Url.Action("Index", "Home")" class="btn-landing-outline btn-landing-lg">
                    <i class="fas fa-home"></i> Return to Home
                </a>
            </div>

            <!-- Info Assistance Grid -->
            <div class="payment-status-grid two-col">
                <div class="payment-feature-mini-card">
                    <i class="fas fa-question-circle"></i>
                    <h4>Have Questions?</h4>
                    <p>Visit our <a href="@Url.Action("Faq", "Home")" class="landing-faq-inline-link">FAQ Page</a> for answers regarding plans, discounts, and features.</p>
                </div>
                <div class="payment-feature-mini-card">
                    <i class="fas fa-headset"></i>
                    <h4>Need Assistance?</h4>
                    <p>Email us at <a href="mailto:admin@menuoptics.com" class="landing-faq-inline-link">admin@menuoptics.com</a> for personalized support.</p>
                </div>
            </div>

        </div>
    </div>
</section>