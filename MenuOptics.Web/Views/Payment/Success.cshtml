@{
    Layout = "_LandingLayout";
    ViewData["Title"] = "Payment Successful";
    bool isAuthenticated = User?.Identity?.IsAuthenticated ?? false;
    string dashboardUrl = (User?.IsInRole("Restaurant") ?? false) ? (Url.Action("Index", "Menu") ?? "/Menu/Index") : (Url.Action("Index", "User") ?? "/User/Index");
}

<!-- ═════════════════════════════════════════════════════════════════
     HEADER: Logo & Theme Switcher
     ═════════════════════════════════════════════════════════════════ -->
<header class="landing-header">
    <div class="landing-container nav-wrapper">
        <a href="@Url.Action("Index", "Home")" class="brand-logo-link">
            <img src="~/images/menu optics_light_logo.png" alt="Menu Optics Logo" />
        </a>

        <div class="nav-actions">
            <button class="theme-toggle-btn hidden" id="themeToggleBtn" title="Switch Theme" aria-label="Switch Theme">
                <i class="fas fa-sun" id="themeIcon"></i>
            </button>
            @if (isAuthenticated)
            {
                <a href="@dashboardUrl" class="btn-landing-primary">
                    <i class="fas fa-th-large"></i> Go to Dashboard
                </a>
            }
            else
            {
                <a href="@Url.Action("Login", "User")" class="btn-landing-primary">
                    <i class="fas fa-sign-in-alt"></i> Sign In
                </a>
            }
        </div>
    </div>
</header>

<!-- ═════════════════════════════════════════════════════════════════
     PAYMENT SUCCESS CONTENT
     ═════════════════════════════════════════════════════════════════ -->
<section class="payment-status-section">
    <div class="hero-glow-bg"></div>

    <div class="landing-container payment-status-wrapper hero-container-relative">
        <div class="payment-status-card success-card reveal">

            <!-- Brand Logo -->
            <div class="hero-logo-wrapper" style="margin-bottom: 20px;">
                <img src="~/images/menu optics_light_logo.png" alt="Menu Optics Logo" class="hero-main-logo" style="height: 52px;" />
            </div>

            <!-- Status Icon -->
            <div class="payment-status-icon-box success-icon">
                <i class="fas fa-check"></i>
            </div>

            <h1 class="payment-status-title">
                Payment <span class="gradient-amber-text">Successful!</span>
            </h1>
            <div class="payment-status-subtitle">
                Welcome to Menu Optics
            </div>
            <p class="payment-status-desc">
                Congratulations! Your payment has been processed successfully. Your account is now active with full access to live recipe costing, automated distributor price syncing, and AI menu engineering insights.
            </p>

            <!-- Action Buttons -->
            <div class="payment-status-actions">
                @if (isAuthenticated)
                {
                    <a href="@dashboardUrl" class="btn-landing-primary btn-landing-lg">
                        <i class="fas fa-th-large"></i> Go to Dashboard
                    </a>
                }
                else
                {
                    <a href="@Url.Action("Login", "User")" class="btn-landing-primary btn-landing-lg">
                        <i class="fas fa-sign-in-alt"></i> Sign In to Your Account
                    </a>
                }
                <a href="@Url.Action("Index", "Home")" class="btn-landing-outline btn-landing-lg">
                    <i class="fas fa-home"></i> Return to Home
                </a>
            </div>

            <!-- Feature Highlights Grid -->
            <div class="payment-status-grid">
                <div class="payment-feature-mini-card">
                    <i class="fas fa-sync-alt"></i>
                    <h4>Live Price Sync</h4>
                    <p>Dynamic supplier costing updated 24/7</p>
                </div>
                <div class="payment-feature-mini-card">
                    <i class="fas fa-brain"></i>
                    <h4>AI Insights</h4>
                    <p>Hyper-local menu optimization</p>
                </div>
                <div class="payment-feature-mini-card">
                    <i class="fas fa-concierge-bell"></i>
                    <h4>Catering Proposals</h4>
                    <p>Instant precision banquet quotes</p>
                </div>
            </div>

        </div>
    </div>
</section>