@{
    Layout = "_LandingLayout";
    ViewData["Title"] = "Home - Live Food Costing & AI Menu Engineering";
    bool isAuthenticated = User?.Identity?.IsAuthenticated ?? false;
    string dashboardUrl = (User?.IsInRole("Restaurant") ?? false) ? (Url.Action("Index", "Menu") ?? "/Menu/Index") : (Url.Action("Index", "User") ?? "/User/Index");
}

<!-- ═════════════════════════════════════════════════════════════════
     HEADER: Logo & Navigation
     ═════════════════════════════════════════════════════════════════ -->
<header class="landing-header">
    <div class="landing-container nav-wrapper">
        <a href="@Url.Action("Index", "Home")" class="brand-logo-link">
            <img src="~/images/menu optics_light_logo.png" alt="Menu Optics Logo" />
        </a>

        <ul class="nav-menu" id="navMenu">
            <li><a href="#food-costing" class="nav-link">Food Costing</a></li>
            <li><a href="#ai-insights" class="nav-link">AI Insights</a></li>
            <li><a href="#catering-suite" class="nav-link">Catering Suite</a></li>
            <li><a href="#why-us" class="nav-link">Why Menu Optics</a></li>
            <li><a href="#faq" class="nav-link">FAQ</a></li>
        </ul>

        <div class="nav-actions">
            <button class="theme-toggle-btn hidden" id="themeToggleBtn" title="Switch Theme" aria-label="Switch Theme">
                <i class="fas fa-sun" id="themeIcon"></i>
            </button>
            @if (isAuthenticated)
            {
                <a href="@dashboardUrl" class="btn-landing-primary">
                    <i class="fas fa-th-large"></i> Go to Dashboard
                </a>
            }
            else
            {
                <a href="@Url.Action("Login", "User")" class="btn-landing-outline">
                    <i class="fas fa-sign-in-alt"></i> Sign In
                </a>
                <a href="@Url.Action("Register", "User")" class="btn-landing-primary">
                    <i class="fas fa-user-plus"></i> Sign Up
                </a>
            }
            <button class="mobile-nav-toggle" id="mobileNavToggle" aria-label="Toggle Navigation">
                <i class="fas fa-bars"></i>
            </button>
        </div>
    </div>
</header>

<!-- ═════════════════════════════════════════════════════════════════
     HERO SECTION
     ═════════════════════════════════════════════════════════════════ -->
<section class="hero-section">
    <div class="hero-glow-bg"></div>
    <div class="landing-container hero-container-relative">

        <div class="hero-content">
            <div class="hero-logo-badge reveal">
                <img src="~/favicon.png" alt="Emblem" />
                <span>Next-Gen Menu Optics</span>
            </div>

            <h1 class="hero-title reveal">
                Data Driven Insights....<br />
                <span class="gradient-amber-text">Simplified</span>
            </h1>

            <p class="hero-subtitle reveal">
                The hospitality industry moves fast, and static spreadsheets can’t keep up. Menu Optics gives you a live, dynamic view of your menu costing, both before you print and long after, so you can protect your bottom line in real time.
            </p>

            <div class="hero-actions reveal">
                @if (isAuthenticated)
                {
                    <a href="@dashboardUrl" class="btn-landing-primary btn-landing-lg">
                        <i class="fas fa-chart-line"></i> Open Dashboard
                    </a>
                    <a href="#welcome-video" class="btn-landing-outline btn-landing-lg">
                        <i class="fas fa-play-circle"></i> Watch Demo
                    </a>
                }
                else
                {
                    <a href="@Url.Action("Register", "User")" class="btn-landing-primary btn-landing-lg">
                        <i class="fas fa-rocket"></i> Get Started
                    </a>
                    <a href="#welcome-video" class="btn-landing-outline btn-landing-lg">
                        <i class="fas fa-play-circle"></i> Watch Demo
                    </a>
                }
            </div>
        </div>
    </div>
</section>

<!-- ═════════════════════════════════════════════════════════════════
     SECTION 1: Pre- & Post-Print Food Costing
     ═════════════════════════════════════════════════════════════════ -->
<section class="feature-section" id="food-costing">
    <div class="landing-container">
        <div class="feature-grid">
            <div class="feature-media reveal">
                <div class="media-wrapper">
                    <img src="~/images/section_food_costing.png" alt="Know Your Food Cost" class="media-img" />
                </div>
            </div>
            <div class="feature-content reveal">
                <div class="section-tag">
                    <i class="fas fa-calculator"></i> Real-Time Food Costing
                </div>
                <h2 class="section-title">
                    KNOW YOUR FOOD COST. <br />
                    <span class="gradient-amber-text">BEFORE YOU PRINT. BEFORE YOU PLATE</span>
                </h2>
                <p class="section-desc">
                    In a kitchen, prices change daily, but your printed menu shouldn't be a guessing game. Menu Optics bridges the gap between your prep table and your purchasing desk. By pairing live ingredient price tracking with your active recipes, we give you a living, breathing look at your exact food costs.
                </p>
                <ul class="feature-list">
                    <li>
                        <i class="fas fa-check-circle"></i>
                        <span><strong>Simulate Margins Pre-Print:</strong> Test dish pricing and target margins before committing to physical menu prints.</span>
                    </li>
                    <li>
                        <i class="fas fa-check-circle"></i>
                        <span><strong>Active Recipe Cost Syncing:</strong> Menu Optics automatically updates...</span>
                    </li>
                    <li>
                        <i class="fas fa-check-circle"></i>
                        <span><strong>Bottom-Line Shield:</strong> Receive automated alerts when plate margins dip below target thresholds.</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</section>

<!-- ═════════════════════════════════════════════════════════════════
     SECTION 2: AI-Driven Menu Engineering Insights
     ═════════════════════════════════════════════════════════════════ -->
<section class="feature-section" id="ai-insights">
    <div class="landing-container">
        <div class="feature-grid reverse">
            <div class="feature-media reveal">
                <div class="media-wrapper">
                    <img src="~/images/section_ai_insights.png" alt="AI-Driven Menu Engineering Insights" class="media-img" />
                </div>
            </div>
            <div class="feature-content reveal">
                <div class="section-tag">
                    <i class="fas fa-brain"></i> Intelligent Analytics
                </div>
                <h2 class="section-title">
                    AI-DRIVEN MENU ENGINEERING INSIGHTS
                </h2>
                <div class="section-subtitle">
                    Maximize margins without risking your guest count
                </div>
                <p class="section-desc">
                    Stop guessing how to price your plates. Our Menu Engineering dashboard combines your unique menu data with advanced, hyper-local AI insights to find the profit hidden in your recipes.
                </p>
                <p class="section-desc">
                    By analyzing your sales mix alongside localized market data, our AI suggests precise, actionable adjustments to your pricing and portioning—giving you the confidence to protect your bottom line while keeping your local customers happy.
                </p>
            </div>
        </div>
    </div>
</section>

<!-- ═════════════════════════════════════════════════════════════════
     SECTION 3: Why Chefs & Owners Trust Menu Optics
     ═════════════════════════════════════════════════════════════════ -->
<section class="why-us-section" id="why-us">
    <div class="landing-container">
        <div class="why-us-header reveal">
            <div class="section-tag">
                <i class="fas fa-shield-heart"></i> Built for Hospitality Leaders
            </div>
            <h2 class="section-title">
                WHY CHEFS & OWNERS TRUST <span class="gradient-amber-text">MENU OPTICS</span>
            </h2>
            <p class="section-desc">
                Designed specifically for restaurant owners, culinary directors, and executive chefs who demand complete financial visibility.
            </p>
        </div>

        <div class="trust-grid">
            <!-- Card 1 -->
            <div class="trust-card reveal">
                <div class="trust-icon-box">
                    <i class="fas fa-print"></i>
                </div>
                <h3>Live Pre- & Post-Print Costing</h3>
                <p>
                    Simulate and lock in your target margins before your menus are printed, then automatically track daily ingredient fluctuations to protect your bottom line in real time.
                </p>
            </div>

            <!-- Card 2 -->
            <div class="trust-card reveal">
                <div class="trust-icon-box">
                    <i class="fas fa-robot"></i>
                </div>
                <h3>AI-Driven Menu Engineering</h3>
                <p>
                    Get hyper-local, regional insights specific to your geographic area, offering precise suggestions to adjust your pricing or portioning without risking your guest loyalty.
                </p>
            </div>

            <!-- Card 3 -->
            <div class="trust-card reveal">
                <div class="trust-icon-box">
                    <i class="fas fa-file-pdf"></i>
                </div>
                <h3>Instant Event & Catering Quotes</h3>
                <p>
                    Turn live ingredient costs into professional, customer-facing PDF quotes in minutes, streamlining your booking workflow so you can win more business faster.
                </p>
            </div>

            <!-- Card 4 -->
            <div class="trust-card reveal">
                <div class="trust-icon-box">
                    <i class="fas fa-boxes"></i>
                </div>
                <h3>Inventory</h3>
                <p>
                    Track raw ingredients from delivery to dish, monitor stock levels in real time, and reduce waste with automated alerts when inventory runs low.
                </p>
            </div>
        </div>
    </div>
</section>

<!-- ═════════════════════════════════════════════════════════════════
     SECTION 4: The Event & Catering Suite
     ═════════════════════════════════════════════════════════════════ -->
<section class="feature-section" id="catering-suite">
    <div class="landing-container">
        <div class="feature-grid">
            <div class="feature-media reveal">
                <div class="media-wrapper">
                    <img src="~/images/section_catering_suite.png" alt="The Event & Catering Suite" class="media-img" />
                </div>
            </div>
            <div class="feature-content reveal">
                <div class="section-tag">
                    <i class="fas fa-concierge-bell"></i>  Live Priced Quotes
                </div>
                <h2 class="section-title">
                    THE EVENT & CATERING SUITE
                </h2>
                <div class="section-subtitle">
                    Profitable, professional event quotes in minutes.
                </div>
                <p class="section-desc">
                    Don't let fluctuating ingredient costs stall your event bookings. Our Event & Catering Suite uses your real-time supplier pricing to let you build fully costed, highly accurate guest proposals instantly.
                </p>
                <p class="section-desc">
                    No more manual margin guesswork when quoting large banquets or private parties. Build your custom menu, lock in your exact margins, and instantly export a beautiful, professional PDF quote to email directly to your client. Menu Optics streamlines the entire quoting workflow, helping your team secure more business faster and with total accuracy.
                </p>
            </div>
        </div>
    </div>
</section>


<!-- ═════════════════════════════════════════════════════════════════
     STATS BANNER
     ═════════════════════════════════════════════════════════════════ -->
<section class="stats-banner landing-container">
    <div class="stats-glass-box reveal">
        <div>
            <div class="stat-counter-number" data-target="100" data-suffix="%">100%</div>
            <div class="stat-counter-label">Pre-Print Margin Accuracy</div>
        </div>
        <div>
            <div class="stat-counter-number" data-target="24" data-suffix="/7">24/7</div>
            <div class="stat-counter-label">Live Supplier Price Sync</div>
        </div>
        <div>
            <div class="stat-counter-number" data-target="4" data-suffix="x">5x</div>
            <div class="stat-counter-label">Faster Catering Proposals with 100% accuracy in costing</div>
        </div>
        <div>
            <div class="stat-counter-number" data-target="15" data-suffix="x">8x</div>
            <div class="stat-counter-label">Faster Catering Proposals with 100% accuracy in costing</div>
        </div>
    </div>
</section>

<!-- ═════════════════════════════════════════════════════════════════
     WELCOME VIDEO TOUR
     ═════════════════════════════════════════════════════════════════ -->
<section class="video-tour-section" id="welcome-video">
    <div class="landing-container">
        <div class="video-tour-header reveal">
            <div class="section-tag">
                <i class="fas fa-play-circle"></i> Video Showcase
            </div>
            <h2 class="section-title">
                Experience the Power of Menu Optics
            </h2>
            <p class="section-desc">
                Take a look at how Menu Optics updates recipes with real-time supplier costs, generates instant banquet proposals, and uses hyper-local AI to safeguard your restaurant's bottom line.
            </p>
        </div>

        <div class="video-tour-wrapper reveal">
            <div class="video-browser-header">
                <div class="video-browser-dot red"></div>
                <div class="video-browser-dot yellow"></div>
                <div class="video-browser-dot green"></div>
                <div class="video-browser-title">Menu Optics - Walkthrough & Demo Tour</div>
            </div>
            <div class="video-frame">
                <video id="welcomeVideo" controls preload="metadata" playsinline>
                    <source src="~/videos/Welcome.mp4" type="video/mp4">
                    Your browser does not support the video tag.
                </video>
            </div>
        </div>
    </div>
</section>

<!-- ═════════════════════════════════════════════════════════════════
     SECTION 5: FREQUENTLY ASKED QUESTIONS (FAQ)
     ═════════════════════════════════════════════════════════════════ -->
<section class="landing-faq-section" id="faq">
    <div class="landing-container">
        <div class="landing-faq-header reveal">
            <div class="section-tag">
                <i class="fas fa-circle-question"></i> Frequently Asked Questions
            </div>
            <h2 class="section-title">
                HAVE QUESTIONS? <span class="gradient-amber-text">WE'VE GOT ANSWERS</span>
            </h2>
            <p class="section-desc">
                Everything you need to know about Menu Optics, live food costing, hyper-local AI menu engineering, and event catering management.
            </p>
        </div>

        <!-- FAQ Controls: Search & Category Filter Pills -->
        <div class="landing-faq-controls reveal">
            <div class="landing-faq-search-wrapper">
                <i class="fas fa-search landing-faq-search-icon"></i>
                <input type="text" id="landingFaqSearch" class="landing-faq-search-input" placeholder="Search questions, features, or topics..." aria-label="Search FAQs" />
                <button type="button" id="landingFaqClear" class="landing-faq-clear-btn" aria-label="Clear Search" style="display: none;">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <div class="landing-faq-pills" id="landingFaqPills" role="tablist">
                <button type="button" class="faq-pill-btn active" data-category="all" role="tab" aria-selected="true">
                    <i class="fas fa-layer-group"></i> All Questions
                </button>
                <button type="button" class="faq-pill-btn" data-category="general" role="tab" aria-selected="false">
                    <i class="fas fa-info-circle"></i> General &amp; Overview
                </button>
                <button type="button" class="faq-pill-btn" data-category="costing" role="tab" aria-selected="false">
                    <i class="fas fa-calculator"></i> Food Costing &amp; Recipes
                </button>
                <button type="button" class="faq-pill-btn" data-category="ai" role="tab" aria-selected="false">
                    <i class="fas fa-brain"></i> AI &amp; Menu Engineering
                </button>
                <button type="button" class="faq-pill-btn" data-category="catering" role="tab" aria-selected="false">
                    <i class="fas fa-concierge-bell"></i> Event &amp; Catering Suite
                </button>
                <button type="button" class="faq-pill-btn" data-category="security" role="tab" aria-selected="false">
                    <i class="fas fa-shield-alt"></i> Onboarding &amp; Security
                </button>
                <button type="button" class="faq-pill-btn" data-category="pricing" role="tab" aria-selected="false">
                    <i class="fas fa-calendar-check"></i> Pricing &amp; Demos
                </button>
            </div>
        </div>

        <!-- FAQ Categories & Accordion List -->
        <div class="landing-faq-content reveal">

            <!-- Category 1: General & Overview -->
            <div class="landing-faq-group" data-group-category="general">
                <div class="landing-faq-group-title">
                    <div class="group-icon-badge">
                        <i class="fas fa-info-circle"></i>
                    </div>
                    <span>General &amp; Overview</span>
                </div>
                <div class="landing-faq-items">
                    <div class="landing-faq-card" data-category="general">
                        <button type="button" class="landing-faq-trigger" aria-expanded="false">
                            <span class="faq-badge-q">Q</span>
                            <span class="faq-question-text">What is Menu Optics?</span>
                            <span class="faq-category-tag">General</span>
                            <i class="fas fa-chevron-down landing-faq-arrow"></i>
                        </button>
                        <div class="landing-faq-panel">
                            <div class="landing-faq-panel-inner">
                                <p>
                                    Menu Optics is a cloud-based menu engineering and live food costing platform built for restaurant owners, executive chefs, culinary directors, and catering operators. It replaces static, manual spreadsheets with real-time supplier price tracking, pre-print margin simulations, hyper-local AI menu engineering, and an instant catering quote generator.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="landing-faq-card" data-category="general">
                        <button type="button" class="landing-faq-trigger" aria-expanded="false">
                            <span class="faq-badge-q">Q</span>
                            <span class="faq-question-text">How is Menu Optics different from standard inventory software or spreadsheets?</span>
                            <span class="faq-category-tag">General</span>
                            <i class="fas fa-chevron-down landing-faq-arrow"></i>
                        </button>
                        <div class="landing-faq-panel">
                            <div class="landing-faq-panel-inner">
                                <p>
                                    While traditional spreadsheets are static and quickly become outdated as supplier prices change, Menu Optics provides <strong>Live Recipe Costing</strong>. It connects your active recipes to real-time supplier price updates, allowing you to see your exact plate costs and margins dynamically. Additionally, our platform features hyper-local AI pricing suggestions and an integrated event quoting engine designed specifically for hospitality operators.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="landing-faq-card" data-category="general">
                        <button type="button" class="landing-faq-trigger" aria-expanded="false">
                            <span class="faq-badge-q">Q</span>
                            <span class="faq-question-text">Who is Menu Optics designed for?</span>
                            <span class="faq-category-tag">General</span>
                            <i class="fas fa-chevron-down landing-faq-arrow"></i>
                        </button>
                        <div class="landing-faq-panel">
                            <div class="landing-faq-panel-inner">
                                <p>
                                    Menu Optics is tailored for single-unit independent restaurants, multi-location restaurant groups, banquet halls, private dining venues, catering companies, and hospitality management firms looking for complete financial visibility and bottom-line protection.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Category 2: Food Costing & Recipe Management -->
            <div class="landing-faq-group" data-group-category="costing">
                <div class="landing-faq-group-title">
                    <div class="group-icon-badge">
                        <i class="fas fa-calculator"></i>
                    </div>
                    <span>Food Costing &amp; Recipe Management</span>
                </div>
                <div class="landing-faq-items">
                    <div class="landing-faq-card" data-category="costing">
                        <button type="button" class="landing-faq-trigger" aria-expanded="false">
                            <span class="faq-badge-q">Q</span>
                            <span class="faq-question-text">How does pre-print margin simulation work?</span>
                            <span class="faq-category-tag">Costing</span>
                            <i class="fas fa-chevron-down landing-faq-arrow"></i>
                        </button>
                        <div class="landing-faq-panel">
                            <div class="landing-faq-panel-inner">
                                <p>
                                    Before sending a menu to the printer or publishing it online, Menu Optics allows you to test various menu price points and portion sizes against live ingredient costs. You can simulate your exact target margins ahead of time, ensuring every dish printed on your menu meets your profitability targets from day one.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="landing-faq-card" data-category="costing">
                        <button type="button" class="landing-faq-trigger" aria-expanded="false">
                            <span class="faq-badge-q">Q</span>
                            <span class="faq-question-text">What happens when my distributor changes ingredient prices?</span>
                            <span class="faq-category-tag">Costing</span>
                            <i class="fas fa-chevron-down landing-faq-arrow"></i>
                        </button>
                        <div class="landing-faq-panel">
                            <div class="landing-faq-panel-inner">
                                <p>
                                    Menu Optics features <strong>24/7 Live Supplier Price Sync</strong> and an automated <strong>Bottom-Line Shield</strong>. When an ingredient price fluctuates, your recipe plate costs automatically recalculate in real time. If an ingredient price surge drops a dish's margin below your set target threshold, you’ll receive an automated alert so you can make necessary adjustments immediately.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="landing-faq-card" data-category="costing">
                        <button type="button" class="landing-faq-trigger" aria-expanded="false">
                            <span class="faq-badge-q">Q</span>
                            <span class="faq-question-text">Can I manage batch recipes and sub-recipes?</span>
                            <span class="faq-category-tag">Costing</span>
                            <i class="fas fa-chevron-down landing-faq-arrow"></i>
                        </button>
                        <div class="landing-faq-panel">
                            <div class="landing-faq-panel-inner">
                                <p>
                                    Yes. Menu Optics allows you to nest sub-recipes, batch preps, and component recipes into final plated menu items. When a core commodity price changes, every associated prep and final dish recalculates automatically.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Category 3: AI & Menu Engineering -->
            <div class="landing-faq-group" data-group-category="ai">
                <div class="landing-faq-group-title">
                    <div class="group-icon-badge">
                        <i class="fas fa-brain"></i>
                    </div>
                    <span>AI &amp; Menu Engineering</span>
                </div>
                <div class="landing-faq-items">
                    <div class="landing-faq-card" data-category="ai">
                        <button type="button" class="landing-faq-trigger" aria-expanded="false">
                            <span class="faq-badge-q">Q</span>
                            <span class="faq-question-text">How does the AI Menu Engineering feature work?</span>
                            <span class="faq-category-tag">AI Insights</span>
                            <i class="fas fa-chevron-down landing-faq-arrow"></i>
                        </button>
                        <div class="landing-faq-panel">
                            <div class="landing-faq-panel-inner">
                                <p>
                                    Menu Optics categorizes your menu using classic menu engineering principles—automatically identifying your <strong>Stars</strong>, <strong>Plowhorses</strong>, <strong>Puzzles</strong>, and <strong>Dogs</strong> based on popularity and contribution margin.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="landing-faq-card" data-category="ai">
                        <button type="button" class="landing-faq-trigger" aria-expanded="false">
                            <span class="faq-badge-q">Q</span>
                            <span class="faq-question-text">What makes your AI "hyper-local", and who is it available to?</span>
                            <span class="faq-category-tag">AI Insights</span>
                            <i class="fas fa-chevron-down landing-faq-arrow"></i>
                        </button>
                        <div class="landing-faq-panel">
                            <div class="landing-faq-panel-inner">
                                <p>
                                    Unlike generic tools that evaluate national averages, Menu Optics analyzes your sales mix alongside regional competitive benchmarking data to suggest precise, actionable adjustments—such as subtle portion tweaks or price adjustments—that preserve guest loyalty while maximizing profitability in your specific market.
                                </p>
                                <div class="landing-faq-highlight-box">
                                    <i class="fas fa-crown"></i>
                                    <span><strong>Note:</strong> Hyper-Local Market Pricing and regional competitive benchmarking insights are available exclusively to <strong>Pro Account tier</strong> users.</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Category 4: Event & Catering Suite -->
            <div class="landing-faq-group" data-group-category="catering">
                <div class="landing-faq-group-title">
                    <div class="group-icon-badge">
                        <i class="fas fa-concierge-bell"></i>
                    </div>
                    <span>Event &amp; Catering Suite</span>
                </div>
                <div class="landing-faq-items">
                    <div class="landing-faq-card" data-category="catering">
                        <button type="button" class="landing-faq-trigger" aria-expanded="false">
                            <span class="faq-badge-q">Q</span>
