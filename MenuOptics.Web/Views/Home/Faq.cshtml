                <div class="faq-footer-icon">
                    <i class="fas fa-comments"></i>
                </div>
                <div>
                    <h3>Still have questions?</h3>
                    <p>Our culinary and technology specialists are always available to help answer questions or guide you through a personalized demo.</p>
                </div>
            </div>
            <div class="faq-footer-right">
                <a href="mailto:admin@menuoptics.com" class="btn-landing-primary">
                    <i class="fas fa-envelope"></i> Contact Us
                </a>
            </div>
        </div>
    </div>
</section>

