@{
    Layout = "_LandingLayout";
    ViewData["Title"] = "Frequently Asked Questions (FAQ)";
    bool isAuthenticated = User?.Identity?.IsAuthenticated ?? false;
    string dashboardUrl = (User?.IsInRole("Restaurant") ?? false) ? (Url.Action("Index", "Menu") ?? "/Menu/Index") : (Url.Action("Index", "User") ?? "/User/Index");
}

<!-- ═════════════════════════════════════════════════════════════════
     HEADER: Logo & Navigation
     ═════════════════════════════════════════════════════════════════ -->
<header class="landing-header">
    <div class="landing-container nav-wrapper">
        <a href="@Url.Action("Index", "Home")" class="brand-logo-link">
            <img src="~/images/menu optics_light_logo.png" alt="Menu Optics Logo" />
        </a>

        <ul class="nav-menu" id="navMenu">
            <li><a href="@Url.Action("Index", "Home")#food-costing" class="nav-link">Food Costing</a></li>
            <li><a href="@Url.Action("Index", "Home")#ai-insights" class="nav-link">AI Insights</a></li>
            <li><a href="@Url.Action("Index", "Home")#catering-suite" class="nav-link">Catering Suite</a></li>
            <li><a href="@Url.Action("Index", "Home")#why-us" class="nav-link">Why Menu Optics</a></li>
            <li><a href="@Url.Action("Faq", "Home")" class="nav-link active">FAQ</a></li>
        </ul>

        <div class="nav-actions">
            <button class="theme-toggle-btn hidden" id="themeToggleBtn" title="Switch Theme" aria-label="Switch Theme">
                <i class="fas fa-sun" id="themeIcon"></i>
            </button>
            @if (isAuthenticated)
            {
                <a href="@dashboardUrl" class="btn-landing-primary">
                    <i class="fas fa-th-large"></i> Go to Dashboard
                </a>
            }
            else
            {
                <a href="@Url.Action("Login", "User")" class="btn-landing-outline">
                    <i class="fas fa-sign-in-alt"></i> Sign In
                </a>
                <a href="@Url.Action("Register", "User")" class="btn-landing-primary">
                    <i class="fas fa-user-plus"></i> Sign Up
                </a>
            }
            <button class="mobile-nav-toggle" id="mobileNavToggle" aria-label="Toggle Navigation">
                <i class="fas fa-bars"></i>
            </button>
        </div>
    </div>
</header>

<!-- ═════════════════════════════════════════════════════════════════
     FAQ HERO SECTION
     ═════════════════════════════════════════════════════════════════ -->
<section class="hero-section faq-page-hero">
    <div class="hero-glow-bg"></div>
    <div class="landing-container hero-container-relative">

        <div class="hero-content">
            <div class="hero-logo-badge reveal">
                <i class="fas fa-question-circle"></i>
                <span>Help &amp; Knowledge Hub</span>
            </div>

            <h1 class="hero-title reveal">
                Frequently Asked <br />
                <span class="gradient-amber-text">Questions</span>
            </h1>

            <p class="hero-subtitle reveal">
                Have questions about live food costing, hyper-local AI menu engineering, supplier syncing, or event quotes? Find comprehensive answers below.
            </p>
        </div>
    </div>
</section>

<!-- ═════════════════════════════════════════════════════════════════
     FAQ INTERACTIVE CONTENT SECTION
     ═════════════════════════════════════════════════════════════════ -->
<section class="landing-faq-section faq-standalone-page" id="faq-main">
    <div class="landing-container">

        <!-- Controls: Live Search & Category Filter Pills -->
        <div class="landing-faq-controls reveal">
            <div class="landing-faq-search-wrapper">
                <i class="fas fa-search landing-faq-search-icon"></i>
                <input type="text" id="landingFaqSearch" class="landing-faq-search-input" placeholder="Search questions, features, or topics..." aria-label="Search FAQs" autofocus />
                <button type="button" id="landingFaqClear" class="landing-faq-clear-btn" aria-label="Clear Search" style="display: none;">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <div class="landing-faq-pills" id="landingFaqPills" role="tablist">
                <button type="button" class="faq-pill-btn active" data-category="all" role="tab" aria-selected="true">
                    <i class="fas fa-layer-group"></i> All Questions
                </button>
                <button type="button" class="faq-pill-btn" data-category="general" role="tab" aria-selected="false">
                    <i class="fas fa-info-circle"></i> General &amp; Overview
                </button>
                <button type="button" class="faq-pill-btn" data-category="costing" role="tab" aria-selected="false">
                    <i class="fas fa-calculator"></i> Food Costing &amp; Recipes
                </button>
                <button type="button" class="faq-pill-btn" data-category="ai" role="tab" aria-selected="false">
                    <i class="fas fa-brain"></i> AI &amp; Menu Engineering
                </button>
                <button type="button" class="faq-pill-btn" data-category="catering" role="tab" aria-selected="false">
                    <i class="fas fa-concierge-bell"></i> Event &amp; Catering Suite
                </button>
                <button type="button" class="faq-pill-btn" data-category="security" role="tab" aria-selected="false">
                    <i class="fas fa-shield-alt"></i> Onboarding &amp; Security
                </button>
                <button type="button" class="faq-pill-btn" data-category="pricing" role="tab" aria-selected="false">
                    <i class="fas fa-calendar-check"></i> Pricing &amp; Demos
                </button>
            </div>
        </div>

        <!-- FAQ Categories & Accordion List -->
        <div class="landing-faq-content reveal">

            <!-- Category 1: General & Overview -->
            <div class="landing-faq-group" data-group-category="general">
                <div class="landing-faq-group-title">
                    <div class="group-icon-badge">
                        <i class="fas fa-info-circle"></i>
                    </div>
                    <span>General &amp; Overview</span>
                </div>
                <div class="landing-faq-items">
                    <div class="landing-faq-card" data-category="general">
                        <button type="button" class="landing-faq-trigger" aria-expanded="false">
                            <span class="faq-badge-q">Q</span>
                            <span class="faq-question-text">What is Menu Optics?</span>
                            <span class="faq-category-tag">General</span>
                            <i class="fas fa-chevron-down landing-faq-arrow"></i>
                        </button>
                        <div class="landing-faq-panel">
                            <div class="landing-faq-panel-inner">
                                <p>
                                    Menu Optics is a cloud-based menu engineering and live food costing platform built for restaurant owners, executive chefs, culinary directors, and catering operators. It replaces static, manual spreadsheets with real-time supplier price tracking, pre-print margin simulations, hyper-local AI menu engineering, and an instant catering quote generator.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="landing-faq-card" data-category="general">
                        <button type="button" class="landing-faq-trigger" aria-expanded="false">
                            <span class="faq-badge-q">Q</span>
                            <span class="faq-question-text">How is Menu Optics different from standard inventory software or spreadsheets?</span>
                            <span class="faq-category-tag">General</span>
                            <i class="fas fa-chevron-down landing-faq-arrow"></i>
                        </button>
                        <div class="landing-faq-panel">
                            <div class="landing-faq-panel-inner">
                                <p>
                                    While traditional spreadsheets are static and quickly become outdated as supplier prices change, Menu Optics provides <strong>Live Recipe Costing</strong>. It connects your active recipes to real-time supplier price updates, allowing you to see your exact plate costs and margins dynamically. Additionally, our platform features hyper-local AI pricing suggestions and an integrated event quoting engine designed specifically for hospitality operators.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="landing-faq-card" data-category="general">
                        <button type="button" class="landing-faq-trigger" aria-expanded="false">
                            <span class="faq-badge-q">Q</span>
                            <span class="faq-question-text">Who is Menu Optics designed for?</span>
                            <span class="faq-category-tag">General</span>
                            <i class="fas fa-chevron-down landing-faq-arrow"></i>
                        </button>
                        <div class="landing-faq-panel">
                            <div class="landing-faq-panel-inner">
                                <p>
                                    Menu Optics is tailored for single-unit independent restaurants, multi-location restaurant groups, banquet halls, private dining venues, catering companies, and hospitality management firms looking for complete financial visibility and bottom-line protection.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Category 2: Food Costing & Recipe Management -->
            <div class="landing-faq-group" data-group-category="costing">
                <div class="landing-faq-group-title">
                    <div class="group-icon-badge">
                        <i class="fas fa-calculator"></i>
                    </div>
                    <span>Food Costing &amp; Recipe Management</span>
                </div>
                <div class="landing-faq-items">
                    <div class="landing-faq-card" data-category="costing">
                        <button type="button" class="landing-faq-trigger" aria-expanded="false">
                            <span class="faq-badge-q">Q</span>
                            <span class="faq-question-text">How does pre-print margin simulation work?</span>
                            <span class="faq-category-tag">Costing</span>
                            <i class="fas fa-chevron-down landing-faq-arrow"></i>
                        </button>
                        <div class="landing-faq-panel">
                            <div class="landing-faq-panel-inner">
                                <p>
                                    Before sending a menu to the printer or publishing it online, Menu Optics allows you to test various menu price points and portion sizes against live ingredient costs. You can simulate your exact target margins ahead of time, ensuring every dish printed on your menu meets your profitability targets from day one.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="landing-faq-card" data-category="costing">
                        <button type="button" class="landing-faq-trigger" aria-expanded="false">
                            <span class="faq-badge-q">Q</span>
                            <span class="faq-question-text">What happens when my distributor changes ingredient prices?</span>
                            <span class="faq-category-tag">Costing</span>
                            <i class="fas fa-chevron-down landing-faq-arrow"></i>
                        </button>
                        <div class="landing-faq-panel">
                            <div class="landing-faq-panel-inner">
                                <p>
                                    Menu Optics features <strong>24/7 Live Supplier Price Sync</strong> and an automated <strong>Bottom-Line Shield</strong>. When an ingredient price fluctuates, your recipe plate costs automatically recalculate in real time. If an ingredient price surge drops a dish's margin below your set target threshold, you’ll receive an automated alert so you can make necessary adjustments immediately.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="landing-faq-card" data-category="costing">
                        <button type="button" class="landing-faq-trigger" aria-expanded="false">
                            <span class="faq-badge-q">Q</span>
                            <span class="faq-question-text">Can I manage batch recipes and sub-recipes?</span>
                            <span class="faq-category-tag">Costing</span>
                            <i class="fas fa-chevron-down landing-faq-arrow"></i>
                        </button>
                        <div class="landing-faq-panel">
                            <div class="landing-faq-panel-inner">
                                <p>
                                    Yes. Menu Optics allows you to nest sub-recipes, batch preps, and component recipes into final plated menu items. When a core commodity price changes, every associated prep and final dish recalculates automatically.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Category 3: AI & Menu Engineering -->
            <div class="landing-faq-group" data-group-category="ai">
                <div class="landing-faq-group-title">
                    <div class="group-icon-badge">
                        <i class="fas fa-brain"></i>
                    </div>
                    <span>AI &amp; Menu Engineering</span>
                </div>
                <div class="landing-faq-items">
                    <div class="landing-faq-card" data-category="ai">
                        <button type="button" class="landing-faq-trigger" aria-expanded="false">
                            <span class="faq-badge-q">Q</span>
                            <span class="faq-question-text">How does the Menu Engineering feature work?</span>
                            <span class="faq-category-tag">AI Insights</span>
                            <i class="fas fa-chevron-down landing-faq-arrow"></i>
                        </button>
                        <div class="landing-faq-panel">
                            <div class="landing-faq-panel-inner">
                                <p>
                                    Menu Optics categorizes your menu using classic menu engineering principles—automatically identifying your <strong>Stars</strong>, <strong>Plowhorses</strong>, <strong>Puzzles</strong>, and <strong>Dogs</strong> based on popularity and contribution margin.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="landing-faq-card" data-category="ai">
                        <button type="button" class="landing-faq-trigger" aria-expanded="false">
                            <span class="faq-badge-q">Q</span>
                            <span class="faq-question-text">What makes your AI "hyper-local", and who is it available to?</span>
                            <span class="faq-category-tag">AI Insights</span>
                            <i class="fas fa-chevron-down landing-faq-arrow"></i>
                        </button>
                        <div class="landing-faq-panel">
                            <div class="landing-faq-panel-inner">
                                <p>
                                    Unlike generic tools that evaluate national averages, Menu Optics analyzes your sales mix alongside regional competitive benchmarking data to suggest precise, actionable adjustments—such as subtle portion tweaks or price adjustments—that preserve guest loyalty while maximizing profitability in your specific market.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Category 4: Event & Catering Suite -->
            <div class="landing-faq-group" data-group-category="catering">
                <div class="landing-faq-group-title">
                    <div class="group-icon-badge">
                        <i class="fas fa-concierge-bell"></i>
                    </div>
                    <span>Event &amp; Catering Suite</span>
                </div>
                <div class="landing-faq-items">
                    <div class="landing-faq-card" data-category="catering">
                        <button type="button" class="landing-faq-trigger" aria-expanded="false">
                            <span class="faq-badge-q">Q</span>
                            <span class="faq-question-text">How does the Event &amp; Catering Suite work?</span>
                            <span class="faq-category-tag">Catering</span>
                            <i class="fas fa-chevron-down landing-faq-arrow"></i>
                        </button>
                        <div class="landing-faq-panel">
                            <div class="landing-faq-panel-inner">
                                <p>
                                    The Event &amp; Catering Suite lets you build custom banquet or private dining menus backed by your live supplier ingredient costs. You can lock in exact profit margins for large guest counts and instantly generate export-ready, professional PDF proposals to email directly to clients.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="landing-faq-card" data-category="catering">
                        <button type="button" class="landing-faq-trigger" aria-expanded="false">
                            <span class="faq-badge-q">Q</span>
                            <span class="faq-question-text">How does this speed up our quoting process?</span>
                            <span class="faq-category-tag">Catering</span>
                            <i class="fas fa-chevron-down landing-faq-arrow"></i>
                        </button>
                        <div class="landing-faq-panel">
                            <div class="landing-faq-panel-inner">
                                <p>
                                    Because ingredient costing is updated automatically, your sales or culinary team no longer needs to manually re-cost custom banquet proposals. Users typically create and send custom, fully margin-checked proposals <strong>5x faster</strong> than using spreadsheets.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Category 5: Onboarding, Integrations & Security -->
            <div class="landing-faq-group" data-group-category="security">
                <div class="landing-faq-group-title">
                    <div class="group-icon-badge">
                        <i class="fas fa-shield-alt"></i>
                    </div>
                    <span>Onboarding, Integrations &amp; Security</span>
                </div>
                <div class="landing-faq-items">
                    <div class="landing-faq-card" data-category="security">
                        <button type="button" class="landing-faq-trigger" aria-expanded="false">
                            <span class="faq-badge-q">Q</span>
                            <span class="faq-question-text">How long does it take to set up Menu Optics?</span>
                            <span class="faq-category-tag">Onboarding</span>
                            <i class="fas fa-chevron-down landing-faq-arrow"></i>
                        </button>
                        <div class="landing-faq-panel">
                            <div class="landing-faq-panel-inner">
                                <p>
                                    Once you have registered for Menu Optics, the Partnered-Distributor data will start downloading within <strong>4 hours</strong>. Once the ingredient data is processed from the distributor, you can start building out your batch recipes and menu items.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="landing-faq-card" data-category="security">
                        <button type="button" class="landing-faq-trigger" aria-expanded="false">
                            <span class="faq-badge-q">Q</span>
                            <span class="faq-question-text">Is my recipe and pricing data secure?</span>
                            <span class="faq-category-tag">Security</span>
                            <i class="fas fa-chevron-down landing-faq-arrow"></i>
                        </button>
                        <div class="landing-faq-panel">
                            <div class="landing-faq-panel-inner">
                                <p>
                                    Security and privacy are core to our platform. Your proprietary recipes, supplier pricing, and operational sales data are stored securely and remain exclusively yours. We never share your proprietary financial or recipe data with third parties.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Category 6: Pricing & Getting Started -->
            <div class="landing-faq-group" data-group-category="pricing">
                <div class="landing-faq-group-title">
                    <div class="group-icon-badge">
                        <i class="fas fa-calendar-check"></i>
                    </div>
                    <span>Pricing &amp; Getting Started</span>
                </div>
                <div class="landing-faq-items">
                    <!-- Q1 -->
                    <div class="landing-faq-card" data-category="pricing">
                        <button type="button" class="landing-faq-trigger" aria-expanded="false">
                            <span class="faq-badge-q">Q</span>
                            <span class="faq-question-text">What is included in the Menu Optics subscription?</span>
                            <span class="faq-category-tag">Pricing</span>
                            <i class="fas fa-chevron-down landing-faq-arrow"></i>
                        </button>
                        <div class="landing-faq-panel">
                            <div class="landing-faq-panel-inner">
                                <p>
                                    Menu Optics is an all-in-one menu intelligence and kitchen profitability platform for $75 CAD / month (billed annually) with $0 setup or onboarding fees. You get immediate access to proactive tools designed to protect margins, optimize pricing, and streamline operations:
                                </p>
                                <ul class="landing-faq-sublist">
                                    <li><strong>Real-Time Recipe & Inventory Costing:</strong> Direct-sync AP pricing, multi-level batch and sub-recipe scaling with yield calculations, and automated credit/adjustment tracking.</li>
                                    <li><strong>Hyper-Local AI Intelligence:</strong>Automated 10 km radius competitor menu price tracking and regional elasticity trends to uncover underpriced items and capture an extra $1–$3 per cover. </li>
                                    <li><strong>Behavioral Menu Engineering:</strong>Built-in layout psychology leveraging scan-path science and "Golden Triangle" focal zones to highlight your highest-margin dishes.</li>
                                    <li><strong>Turnkey Event & Catering Quotes:</strong>Fast, branded proposals that combine food costs, beverage specs, rentals, linens, and staffing into client-ready quotes.</li>
                                    <li><strong>Kitchen-Ready Execution:</strong>Instant, 1-click printable PDF prep cards and line cook spec sheets to keep food quality and portioning consistent across shifts.</li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <!-- Q2 -->
                    <div class="landing-faq-card" data-category="pricing">
                        <button type="button" class="landing-faq-trigger" aria-expanded="false">
                            <span class="faq-badge-q">Q</span>
                            <span class="faq-question-text">Are there monthly payment options available?</span>
                            <span class="faq-category-tag">Pricing</span>
                            <i class="fas fa-chevron-down landing-faq-arrow"></i>
                        </button>
                        <div class="landing-faq-panel">
                            <div class="landing-faq-panel-inner">
                                <p>
                                    To deliver the most competitive rates and continuous feature updates, Menu Optics subscriptions are structured as annual plans.
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Discount Q -->
                    <div class="landing-faq-card" data-category="pricing">
                        <button type="button" class="landing-faq-trigger" aria-expanded="false">
                            <span class="faq-badge-q">Q</span>
                            <span class="faq-question-text">Can I get a discount on my subscription?</span>
                            <span class="faq-category-tag">Pricing</span>
                            <i class="fas fa-chevron-down landing-faq-arrow"></i>
                        </button>
                        <div class="landing-faq-panel">
                            <div class="landing-faq-panel-inner">
                                <p>
                                    Yes! We encourage you to check with your broadline food distributor to see if they are a Menu Optics partner. Partnered distributors may offer exclusive discounts or preferred rates to eligible accounts.
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Q3 -->
                    <div class="landing-faq-card" data-category="pricing">
                        <button type="button" class="landing-faq-trigger" aria-expanded="false">
                            <span class="faq-badge-q">Q</span>
                            <span class="faq-question-text">How do I apply a distributor partner discount?</span>
                            <span class="faq-category-tag">Pricing</span>
                            <i class="fas fa-chevron-down landing-faq-arrow"></i>
                        </button>
                        <div class="landing-faq-panel">
                            <div class="landing-faq-panel-inner">
                                <p>
                                    If your distributor is an authorized partner, enter the promo or account code provided by your representative during setup or checkout to apply your discount.
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Live Demo Scheduling Q -->
                    <div class="landing-faq-card" data-category="pricing">
                        <button type="button" class="landing-faq-trigger" aria-expanded="false">
                            <span class="faq-badge-q">Q</span>
                            <span class="faq-question-text">How can I schedule a live demo of Menu Optics?</span>
                            <span class="faq-category-tag">Demo</span>
                            <i class="fas fa-chevron-down landing-faq-arrow"></i>
                        </button>
                        <div class="landing-faq-panel">
                            <div class="landing-faq-panel-inner">
                                <p>
                                    You can book a live, 1-on-1 walkthrough directly through our Microsoft Bookings calendar. Simply pick a date and time that fits your schedule, and a member of our team will meet with you virtually to walk through the platform.
                                    <a class='landing-faq-inline-link' href='https://outlook.office365.com/owa/calendar/MenuOpticsWalkThrough@miseenplace.ca/bookings/?ismsaljsauthenabled'>Schedule online</a>
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Q4 -->
                    <div class="landing-faq-card" data-category="pricing">
                        <button type="button" class="landing-faq-trigger" aria-expanded="false">
                            <span class="faq-badge-q">Q</span>
                            <span class="faq-question-text">What should I expect during the demo?</span>
                            <span class="faq-category-tag">Demo</span>
                            <i class="fas fa-chevron-down landing-faq-arrow"></i>
                        </button>
                        <div class="landing-faq-panel">
                            <div class="landing-faq-panel-inner">
                                <p>
                                    Our demos are interactive and tailored to your restaurant operation. During the session, we will:
                                </p>
                                <ul class="landing-faq-sublist">
                                    <li>Walk you through core features like automated recipe costing, distributor integrations, and contribution margin tracking.</li>
                                    <li>Demonstrate how Hyper Local AI identifies profit opportunities in your specific market (Premium plan).</li>
                                    <li>Answer any questions about distributor partner discounts and onboarding your menu data.</li>
                                    <li>Standard walkthroughs are scheduled for 30 minutes. This provides plenty of time for a full platform tour and a focused Q&amp;A tailored to your business goals.</li>
                                    <li>Once you submit your time via Microsoft Bookings, you’ll receive an immediate email confirmation containing a Microsoft Teams link for the virtual meeting, along with an automated calendar invitation you can add to your schedule.</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Empty Search State -->
            <div id="landingFaqEmpty" class="landing-faq-empty" style="display: none;">
                <div class="empty-icon-wrap">
                    <i class="fas fa-search"></i>
                </div>
                <h3>No matching questions found</h3>
                <p>Try searching for different keywords or browse by category above.</p>
                <button type="button" id="landingFaqResetBtn" class="btn-landing-outline btn-landing-sm">
                    <i class="fas fa-redo"></i> Reset Search
                </button>
            </div>

        </div>

        <!-- Help & Contact CTA Footer inside FAQ -->
        <div class="landing-faq-footer-card reveal">
