@using MenuOptics.Models.Enums
@{
    ViewData["Title"] = "Restaurants";
}

<main class="main-content">
    <div class="page-header">
        <div class="header-text">
            <h1>Restaurant Management</h1>
            <p>Manage Restaurant users for the system.</p>
        </div>
        <div class="header-actions">
            <button class="btn btn-primary" onclick="openModal('addRestaurantModal')">
                <i class="fas fa-plus"></i> Add Restaurant
            </button>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-content">
                <div class="stat-info">
                    <p class="stat-label">Total Restaurants</p>
                    <p class="stat-value" id="totalRestaurants"></p>
                    <p class="stat-change-text">All registered restaurants</p>
                </div>
                <div class="stat-icon users">
                    <i class="fas fa-users"></i>
                </div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-content">
                <div class="stat-info">
                    <p class="stat-label">Active Restaurants</p>
                    <p class="stat-value" id="activeToday"></p>
                    <p class="stat-change-text">Currently active</p>
                </div>
                <div class="stat-icon active">
                    <i class="fas fa-user-check"></i>
                </div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-content">
                <div class="stat-info">
                    <p class="stat-label">Inactive Restaurants</p>
                    <p class="stat-value" id="inactiveRestaurants"></p>
                    <p class="stat-change-text">Currently inactive</p>
                </div>
                <div class="stat-icon inactive">
                    <i class="fas fa-user-times"></i>
                </div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-content">
                <div class="stat-info">
                    <p class="stat-label">New This Week</p>
                    <p class="stat-value" id="newThisWeek">0</p>
                    <p class="stat-change-text">Joined in last 7 days</p>
                </div>
                <div class="stat-icon new">
                    <i class="fas fa-clock"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="filters">
        <div class="search-wrapper">
            <i class="fas fa-search"></i>
            <input type="text" placeholder="Search restaurants..." class="filter-search" id="restaurantSearch">
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h3><i class="fas fa-utensils"></i> Restaurant Directory</h3>
        </div>
        <div class="card-content">
            <div class="table-container">
                <table class="data-table" id="restaurantTable">
                    <thead>
                        <tr>
                            <th>Restaurant</th>
                            <th>Status</th>
                            <th>Join Date</th>
                            <th>Last Modified</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="restaurantTableBody">
                        <!-- Restaurants will be populated dynamically -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Add Restaurant Modal -->
    <div class="modal" id="addRestaurantModal">
        <div class="modal-content large-modal">
            <div class="modal-header">
                <h3>Add New Restaurant</h3>
                <button class="modal-close" onclick="closeModal('addRestaurantModal')">&times;</button>
            </div>
            <div class="modal-body">
                <form id="addRestaurantForm" enctype="multipart/form-data">
                    <div class="form-row">
                        <div class="form-group">
                            <label>Restaurant Name <span style="color:red">*</span></label>
                            <input type="text" name="restaurantName" required>
                        </div>
                        
                    </div>
                    <div class="form-row">
                        
                        <div class="form-group">
                            <label>Profile Picture</label>
                            <div class="file-upload">
                                <img id="addProfilePicPreview" src="https://via.placeholder.com/150" alt="Profile Picture Preview" style="max-width:150px; max-height:150px; margin-bottom:10px; display:none;">
                                <label for="addProfilePicFile" class="file-upload-label">
                                    <i class="fas fa-cloud-upload-alt"></i>
                                    <span>Choose profile picture</span>
                                </label>
                                <input type="file" id="addProfilePicFile" accept="image/*" name="file">
                            </div>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>First Name <span style="color:red">*</span></label>
                            <input type="text" name="firstName" required>
                        </div>
                        <div class="form-group">
                            <label>Last Name <span style="color:red">*</span></label>
                            <input type="text" name="lastName" required>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>Username <span style="color:red">*</span></label>
                            <input type="text" name="username" required>
                        </div>
                        <div class="form-group">
                            <label>Email <span style="color:red">*</span></label>
                            <input type="email" name="email" required>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>Phone <span style="color:red">*</span></label>
                            <input type="text" name="phone" required>
                        </div>
                        <div class="form-group">
                            <label>Password <span style="color:red">*</span></label>
                            <input type="password" name="password" required>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Address</label>
                        <input type="text" name="address">
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>Country</label>
                            <input type="text" name="country">
                        </div>
                        <div class="form-group">
                            <label>State</label>
                            <input type="text" name="state">
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>City</label>
                            <input type="text" name="city">
                        </div>
                        <div class="form-group">
                            <label>Zip</label>
                            <input type="text" name="zip">
                        </div>
                    </div>
                    <input type="hidden" name="role" value="@Role.Restaurant.ToString()">
                </form>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline" onclick="closeModal('addRestaurantModal')">Cancel</button>
                <button class="btn btn-primary" id="saveRestaurantBtn">Save Restaurant</button>
            </div>
        </div>
    </div>

    <!-- Edit Restaurant Modal -->
    <div class="modal" id="editRestaurantModal">
        <div class="modal-content large-modal">
            <div class="modal-header">
                <h3>Edit Restaurant</h3>
                <button class="modal-close" onclick="closeModal('editRestaurantModal')">&times;</button>
            </div>
            <div class="modal-body">
                <form id="editRestaurantForm" enctype="multipart/form-data">
                    <input type="hidden" name="userId">
                    <input type="hidden" name="profilePic">
                    <input type="hidden" name="role" value="@Role.Restaurant.ToString()">
                    <div class="form-row">
                        <div class="form-group">
                            <label>Restaurant Name <span style="color:red">*</span></label>
                            <input type="text" name="restaurantName" required>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>Profile Picture</label>
                            <div class="file-upload">
                                <img id="editProfilePicPreview" src="https://via.placeholder.com/150" alt="Profile Picture Preview" style="max-width:150px; max-height:150px; margin-bottom:10px; display:none;">
                                <label for="editProfilePicFile" class="file-upload-label">
                                    <i class="fas fa-cloud-upload-alt"></i>
                                    <span id="editProfilePicLabel">Choose new profile picture</span>
                                </label>
                                <input type="file" id="editProfilePicFile" accept="image/*" name="file">
                            </div>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>First Name <span style="color:red">*</span></label>
                            <input type="text" name="firstName" required>
                        </div>
                        <div class="form-group">
                            <label>Last Name <span style="color:red">*</span></label>
                            <input type="text" name="lastName" required>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>Username <span style="color:red">*</span></label>
                            <input type="text" name="username" required>
                        </div>
                        <div class="form-group">
                            <label>Email <span style="color:red">*</span></label>
                            <input type="email" name="email" required>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>Phone <span style="color:red">*</span></label>
                            <input type="text" name="phone" required>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Address</label>
                        <input type="text" name="address">
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>Country</label>
                            <input type="text" name="country">
                        </div>
                        <div class="form-group">
                            <label>State</label>
                            <input type="text" name="state">
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>City</label>
                            <input type="text" name="city">
                        </div>
                        <div class="form-group">
                            <label>Zip</label>
                            <input type="text" name="zip">
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline" onclick="closeModal('editRestaurantModal')">Cancel</button>
                <button class="btn btn-primary" id="updateRestaurantBtn">Update Restaurant</button>
            </div>
        </div>
    </div>
</main>

<script src="~/views-js/restaurant.js?v=@DateTime.Now.Ticks"></script>