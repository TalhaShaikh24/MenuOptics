
@{
    Layout = "_AuthLayout";
}


    <!-- Left Side - Branding -->
    <div class="auth-branding">
        <div class="branding-content">
        <div class="brand-logo" style="background:#fffffff0; border-radius: 12px; padding:10px; box-shadow: 0px 10px 15px -3px rgba(0,0,0,0.1);">
            @*  <div class="brand-icon">
                <i class="fas fa-utensils"></i>
            </div> *@
            @* <img src="~/images/transparent logo symbol.png" style="width:80px!important" /> *@
            <img src="~/images/menu optics_logo.png" style="width:200px" />
            @* <div class="brand-text text-black">
                <h1>MENU</h1>
                <h1>OPTICS</h1>
            </div> *@
        </div>
            <div class="branding-text">
                <h2>Start Your Journey</h2>
                <p>Join thousands of restaurant owners who trust our platform to manage their operations efficiently and grow their business.</p>
            </div>
            <div class="stats-grid">
                <div class="stat-item">
                    <div class="stat-number">500+</div>
                    <div class="stat-label">Restaurants</div>
                </div>
                <div class="stat-item">
                    <div class="stat-number">50K+</div>
                    <div class="stat-label">Orders Processed</div>
                </div>
                <div class="stat-item">
                    <div class="stat-number">99.9%</div>
                    <div class="stat-label">Uptime</div>
                </div>
                <div class="stat-item">
                    <div class="stat-number">24/7</div>
                    <div class="stat-label">Support</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Side - Register Form -->
    <div class="auth-form-container">
        <div class="auth-form">
            <div class="form-header">
                <h2>Create Account</h2>
                <p>Get started with your restaurant management system</p>
            </div>

            <!-- Step Indicator -->
            <div class="step-indicator">
                <div class="step active" data-step="1">
                    <div class="step-number">1</div>
                    <span>Personal Info</span>
                </div>
                <div class="step" data-step="2">
                    <div class="step-number">2</div>
                    <span>Details</span>
                </div>
                <div class="step" data-step="3">
                    <div class="step-number">3</div>
                    <span>Profle Pic</span>
                </div>
                <div class="step" data-step="4">
                    <div class="step-number">4</div>
                    <span>Account Setup</span>
                </div>
            </div>

        <form id="registerForm" class="register-form" enctype="multipart/form-data">
            <!-- Step 1: Personal Information -->
            <div class="form-step active" data-step="1">
                <div class="form-row">
                    <div class="form-group">
                        <label for="firstName">First Name <span style="color:red">*</span></label>
                        <div class="input-wrapper">
                            <i class="fas fa-user"></i>
                            <input type="text" id="firstName" name="firstName" placeholder="Enter first name" required>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="lastName">Last Name <span style="color:red">*</span></label>
                        <div class="input-wrapper">
                            <i class="fas fa-user"></i>
                            <input type="text" id="lastName" name="lastName" placeholder="Enter last name" required>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label for="username">Username <span style="color:red">*</span></label>
                    <div class="input-wrapper">
                        <i class="fas fa-user"></i>
                        <input type="text" id="username" name="username" placeholder="Enter your username" required>
                    </div>
                </div>
                <div class="form-group">
                    <label for="email">Email Address <span style="color:red">*</span></label>
                    <div class="input-wrapper">
                        <i class="fas fa-envelope"></i>
                        <input type="email" id="email" name="email" placeholder="Enter your email" required>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label for="gender">Gender <span style="color:red">*</span></label>
                        <div class="input-wrapper">
                            <i class="fas fa-utensils"></i>
                            <select id="gender" name="gender" required>
                                <option value="">Select Gender</option>
                                <option value="male">Male</option>
                                <option value="female">Female</option>
                                <option value="other">Other</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="phone">Phone Number <span style="color:red">*</span></label>
                        <div class="input-wrapper">
                            <i class="fas fa-phone"></i>
                            <input type="tel" id="phone" name="phone" placeholder="Enter phone number" required>
                        </div>
                    </div>
                </div>
                <div class="form-group" style="display:none;">
                    <label for="role">Your Role</label>
                    <div class="input-wrapper">
                        <i class="fas fa-briefcase"></i>
                        <input type="hidden" id="role" name="role" value="restaurant" placeholder="Enter role" required>
                    </div>
                </div>
            </div>

            <!-- Step 2: Restaurant Details -->
            <div class="form-step" data-step="2">
                <div class="form-group">
                    <label for="restaurantName">Restaurant Name <span style="color:red">*</span></label>
                    <div class="input-wrapper">
                        <i class="fas fa-store"></i>
                        <input type="text" id="restaurantName" name="restaurantName" placeholder="Enter restaurant name" required>
                    </div>
                </div>
                <div class="form-group">
                    <label for="cuisine">Cuisine Type <span style="color:red">*</span></label>
                    <div class="input-wrapper">
                        <i class="fas fa-utensils"></i>
                        <select id="cuisine" name="cuisine" required>
                            <option value="">Select cuisine type</option>
                            <option value="american">American</option>
                            <option value="italian">Italian</option>
                            <option value="chinese">Chinese</option>
                            <option value="mexican">Mexican</option>
                            <option value="indian">Indian</option>
                            <option value="japanese">Japanese</option>
                            <option value="french">French</option>
                            <option value="mediterranean">Mediterranean</option>
                            <option value="other">Other</option>
                        </select>
                    </div>
                </div>
                <div class="form-group">
                    <label for="address">Restaurant Address <span style="color:red">*</span></label>
                    <div class="input-wrapper">
                        <i class="fas fa-map-marker-alt"></i>
                        <textarea id="address" name="address" placeholder="Enter complete address" rows="3" required></textarea>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label for="city">City <span style="color:red">*</span></label>
                        <div class="input-wrapper">
                            <i class="fas fa-city"></i>
                            <input type="text" id="city" name="city" placeholder="Enter city" required>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="zipCode">ZIP Code <span style="color:red">*</span></label>
                        <div class="input-wrapper">
                            <i class="fas fa-mail-bulk"></i>
                            <input type="text" id="zipCode" name="zip" placeholder="Enter ZIP code" required>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label for="restaurantSize">Restaurant Size <span style="color:red">*</span></label>
                    <div class="input-wrapper">
                        <i class="fas fa-chart-bar"></i>
                        <select id="restaurantSize" name="restaurantSize" required>
                            <option value="">Select restaurant size</option>
                            <option value="small">Small (1-25 seats)</option>
                            <option value="medium">Medium (26-75 seats)</option>
                            <option value="large">Large (76-150 seats)</option>
                            <option value="enterprise">Enterprise (150+ seats)</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Step 3: Profile Pic -->
            <div class="form-step" data-step="3">
                <div class="form-group">
                    <label>Profile Image <span>(Optional)</span></label>
                    <div class="file-upload">
                        <label for="profile_image" class="file-upload-label">
                            <i class="fas fa-cloud-upload-alt"></i>
                            <span>Choose featured image</span>
                        </label>
                        <input type="file" id="profile_image" accept="image/*" name="file">
                    </div>
                </div>
            </div>

            <!-- Step 4: Account Setup -->
            <div class="form-step" data-step="4">
                <div class="form-group">
                    <label for="password">Password</label>
                    <div class="input-wrapper">
                        <i class="fas fa-lock"></i>
                        <input type="password" id="password" name="password" placeholder="Create password" required>
                        <button type="button" class="password-toggle" onclick="togglePassword('password')">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                    <div class="password-strength">
                        <div class="strength-bar">
                            <div class="strength-fill"></div>
                        </div>
                        <span class="strength-text">Password strength</span>
                    </div>
                </div>
                <div class="form-group">
                    <label for="confirmPassword">Confirm Password</label>
                    <div class="input-wrapper">
                        <i class="fas fa-lock"></i>
                        <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Confirm password" required>
                        <button type="button" class="password-toggle" onclick="togglePassword('confirmPassword')">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                </div>
                <div class="form-group">
                    <label for="plan">Choose Plan</label>
                    <div class="plan-options">
                        <label class="plan-option">
                            <input type="radio" name="plan" value="starter" checked>
                            <div class="plan-card">
                                <div class="plan-header">
                                    <h4>Starter</h4>
                                    <div class="plan-price">$30<span>/month</span></div>
                                </div>
                                <ul class="plan-features">
                                    <li><i class="fas fa-check"></i> Basic analytics</li>
                                    <li><i class="fas fa-check"></i> Email support</li>
                                </ul>
                            </div>
                        </label>
                        <label class="plan-option">
                            <input type="radio" name="plan" value="professional">
                            <div class="plan-card popular">
                                <div class="popular-badge">Most Popular</div>
                                <div class="plan-header">
                                    <h4>Professional</h4>
                                    <div class="plan-price">$79<span>/month</span></div>
                                </div>
                                <ul class="plan-features">
                                    <li><i class="fas fa-check"></i> Advanced analytics</li>
                                    <li><i class="fas fa-check"></i> Priority support</li>
                                </ul>
                            </div>
                        </label>
                    </div>
                </div>
                <div class="form-options">
                    <label class="checkbox-label">
                        <input type="checkbox" name="terms" required>
                        <span class="checkmark"></span>
                        I agree to the <a href="#" target="_blank">Terms of Service</a> and <a href="#" target="_blank">Privacy Policy</a>
                    </label>
                </div>
            </div>

            <!-- Form Navigation -->
            <div class="form-navigation">
                <button type="button" class="btn btn-outline prev-btn" style="display: none;">
                    <i class="fas fa-arrow-left"></i>
                    Previous
                </button>
                <button type="button" class="btn btn-primary next-btn">
                    Next
                    <i class="fas fa-arrow-right"></i>
                </button>
                <button type="submit" class="btn btn-primary submit-btn" style="display: none;">
                    <span class="btn-text">Create Account</span>
                    <i class="fas fa-spinner fa-spin btn-loading" style="display: none;"></i>
                </button>
            </div>

            <div class="form-footer">
                <p>Already have an account? <a href="@Url.Action("Login", "User")">Sign in here</a></p>
            </div>
        </form>
        </div>
    </div>






@section Scripts {
    @* <script src="~/views-js/register.js"></script> *@
    <script src="https://js.stripe.com/v3/"></script>
    <script src="~/js/globalajax.js"></script>
    <script src="~/views-js/register.js"></script>

}