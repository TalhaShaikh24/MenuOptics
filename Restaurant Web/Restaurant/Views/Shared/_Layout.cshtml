@using System.Security.Claims
@{
    var firstName = User?.FindFirst("FirstName")?.Value ?? "John";
    var lastName = User?.FindFirst("LastName")?.Value ?? "Doe";
    var initials = (firstName.FirstOrDefault().ToString() + lastName.FirstOrDefault().ToString()).ToUpper();
    var userRole = User?.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Role)?.Value ?? "User";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Restaurant</title>
    <script type="importmap"></script>
    <link rel="icon" href="~/favicon.ico" type="image/x-icon" />
    <link rel="shortcut icon" href="~/favicon.ico" type="image/x-icon" />
    <link rel="stylesheet" href="~/css/styles.css?v=@DateTime.Now.Ticks">
    <link rel="stylesheet" href="~/css/image-preview.css?v=@DateTime.Now.Ticks">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.10.25/css/jquery.dataTables.min.css" />
    <link href="~/css/error-popup.css" rel="stylesheet" />
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
</head>
<body>
    <style>
        .availability-badge{
            display:none!important;
        }

        .menu-item-content .stat{
            display:none!important;
        }
    </style>
    <div class="dashboard-container">
        <!-- Sidebar -->
        <aside class="sidebar" id="sidebar">
            <!-- Header -->
            <div class="sidebar-header">
                <div class="sidebar-brand">
                  @*   <div class="brand-icon">
                         <i class="fas fa-store"></i> 
                    </div> *@
                    <div class="brand-icon" style="background:transparent!important; width:auto!important;height:auto!important">
                        @* <img src="~/images/transparent logo symbol.png" style="width:30px!important"/> *@
                        <img src="~/images/menu optics_logo.png" style="width:100px!important" />
                        @* <i class="fas fa-store"></i> *@
                    </div>
                   @*  <div class="brand-text">
                        <h1>MENU</h1>
                        <h1>OPTICS</h1>
                    </div> *@
                </div>
                <button class="sidebar-toggle" id="sidebarToggle">
                    <i class="fas fa-bars"></i>
                </button>
            </div>

            <!-- Search -->
            <div class="sidebar-search">
                <div class="search-input-wrapper">
                    <i class="fas fa-search"></i>
                    <input type="text" placeholder="Search..." class="search-input">
                </div>
            </div>

          

            <!-- Navigation -->
            <nav class="sidebar-nav">
                <a href="index.html" class="nav-item active">
                    <i class="fas fa-chart-bar"></i>
                    <span>Dashboard</span>
                </a>

                @if (User.IsInRole("Admin"))
                {
                    <a href="@Url.Action("Index", "Restaurant")" class="nav-item">
                        <i class="fas fa-store"></i>
                        <span>Restaurants</span>
                        <span class="badge">12</span>
                    </a>
                }

                <a href="@Url.Action("Index", "Menu")" class="nav-item">
                    <i class="fas fa-utensils"></i>
                    <span>Menu</span>
                </a>

                <a href="@Url.Action("Index", "Category")" class="nav-item">
                    <i class="fas fa-tags"></i>
                    <span>Categories</span>
                    <span class="badge alert">3</span>
                </a>
                <a href="@Url.Action("Index", "Ingredient")" class="nav-item">
                    <i class="fas fa-box"></i>
                    <span>Ingredients</span>
                    <span class="badge alert">3</span>
                </a>
                @if (User.IsInRole("Restaurant"))
                {
                    <a href="@Url.Action("Index", "Sales")" class="nav-item">
                        <i class="fas fa-cash-register"></i>
                        <span>Sales</span>
                    </a>
                    <a href="@Url.Action("Index", "MenuEngineeringInsights")" class="nav-item">
                        <i class="fas fa-chart-pie"></i>
                        <span>Menu Insights</span>
                    </a>
                    <a href="@Url.Action("Index", "Analytics")" class="nav-item">
                        <i class="fas fa-chart-line"></i>
                        <span>Analytics</span>
                    </a>
                
                }
                

                @if (User.IsInRole("Admin"))
                {
                    <a href="@Url.Action("Index", "User")" class="nav-item">
                        <i class="fas fa-users"></i>
                        <span>Users</span>
                    </a>
                    <a href="settings.html" class="nav-item">
                        <i class="fas fa-cog"></i>
                        <span>Settings</span>
                    </a>
                }

                <a id="btnLogout" class="nav-item" href="javascript:void(0);">
                    <i class="fas fa-sign-out-alt"></i>
                    <span>Logout</span>
                </a>
            </nav>


            <!-- Footer -->
            <div class="sidebar-footer">
                <div class="user-profile">
                    <div class="user-avatar">@initials</div>
                    <div class="user-info">
                        <p class="user-name">@firstName </p>
                        <p class="user-role">@userRole</p>
                    </div>
                    @* <i class="fas fa-bell"></i> *@
                </div>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="main-content">
            @RenderBody()
            <div class="modal" id="confirmDeleteModal" style="display: none;">
                <div class="modal-content">
                    <div class="modal-header">
                        <h3>Confirm Deletion</h3>
                        <button class="modal-close" onclick="closeModal('confirmDeleteModal')">&times;</button>
                    </div>
                    <div class="modal-body">
                        <p id="confirmDeleteMessage">Are you sure you want to delete this item? This action cannot be undone.</p>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-outline" onclick="closeModal('confirmDeleteModal')">Cancel</button>
                        <button id="confirmDeleteBtn" class="btn btn-primary">Delete</button>
                    </div>
                </div>
            </div>
        </main>

    </div>



    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Include this before your custom script -->
    <script src="https://cdn.jsdelivr.net/npm/js-cookie@3.0.5/dist/js.cookie.min.js"></script>
    <script src="https://cdn.datatables.net/1.10.25/js/jquery.dataTables.min.js"></script>
    <script>
        $(document).ready(function () {
            var token = Cookies.get('JwtToken');

            if (token && token.trim() !== '') {
                $.ajaxSetup({
                    headers: {
                        Authorization: 'Bearer ' + token
                    },
                    xhrFields: {
                        withCredentials: true
                    }
                });
            } else {
                $.ajaxSetup({
                    xhrFields: {
                        withCredentials: true
                    }
                });
            }
        });
    </script>

    <script src="~/js/dateformatter.js"></script>
    <script src="~/js/script.js?v=@DateTime.Now.Ticks"></script>
    <script src="~/js/image-preview.js?v=@DateTime.Now.Ticks"></script>
    <script src="~/js/globalajax.js"></script>
    
    <script src="~/js/error-popup.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        $(document).on('click','#btnLogout',function(){
           ajaxRequest({
            url: 'https://localhost:7103/api/UserApi/Logout',
            method: 'POST',
            data: null,
            contentType: false,
            processData: false,
            onSuccess: function (response) {
                showNotification('Restaurant added successfully!', 'success');
                window.location.href = '/User/login';
                
            },
            onError: function (xhr, status, error) {
                console.error('Failed to add restaurant:', error);
                showNotification('Failed to add restaurant.', 'error');
            }
        });
        })
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
