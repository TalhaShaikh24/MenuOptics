@{
    ViewData["Title"] = "Data Export Policy";
    Layout = "_StaticPagesLayout";
}

    

    <div class="card">
       <div class="container mt-5">
    <h1 class="mb-4">Privacy Policy</h1>
    <div id="privacyContent" class="policy-content">
        <p>Loading...</p>
    </div>
</div>
    </div>


    

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function () {
        fetch('/api/PolicyApi/GetPolicyByType?type=DataExport')
            .then(response => response.json())
            .then(data => {
                if (data.data && data.data.content) {
                    document.getElementById('privacyContent').innerHTML = data.data.content;
                } else {
                    document.getElementById('privacyContent').innerHTML = '<p>No Data Export policy available.</p>';
                }
            })
            .catch(err => {
                document.getElementById('privacyContent').innerHTML = '<p>Error loading policy.</p>';
                console.error(err);
            });
    });
</script>
}