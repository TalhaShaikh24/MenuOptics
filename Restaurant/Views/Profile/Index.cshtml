@{
    ViewData["Title"] = "My Profile";
    var userRole = User?.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Role)?.Value ?? "User";
    bool isParent = Convert.ToBoolean(
        User?.FindFirst("isParent")?.Value ?? "false"
    );
}
@using System.Security.Claims
@using MenuOptics
@using MenuOptics.Models
@using MenuOptics.Utility
@inject Microsoft.AspNetCore.Mvc.Rendering.IHtmlHelper Html


    <div class="page-header">
        <h1>Edit Profile</h1>
    </div>

    <div class="card" style="padding:40px">
        <div class="card-body">
            <form id="profileEditForm" enctype="multipart/form-data">
                <input type="hidden" name="profilePic" id="existingProfilePic">

            @if (isParent){
                <div class="profile-upload-section" style="text-align: center; margin-bottom: 2rem;">
                    <img id="profilePreview" src="/img/default-avatar.png" style="width: 150px; height: 150px; border-radius: 50%; object-fit: cover; border: 3px solid #ddd;">
                    <div class="mt-2">
                        <label for="profileFile" class="btn btn-outline-sm">Company Logo</label>
                        <input type="file" id="profileFile" name="file" accept="image/*" style="display: none;">
                    </div>
                </div>
            }
                

                <div class="form-row">
                    <div class="form-group">
                        <label>First Name</label>
                        <input type="text" name="firstName" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label>Last Name</label>
                        <input type="text" name="lastName" class="form-control" required>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label>Username</label>
                        <input type="text" name="username" class="form-control" readonly disabled>
                    </div>
                    <div class="form-group">
                        <label>Email</label>
                        <input type="email" name="email" class="form-control" readonly disabled>
                    </div>
                </div>

                <div class="form-group">
                    <label>Phone</label>
                    <input type="text" name="phone" class="form-control">
                </div>

                <div class="form-group">
                    <label>Address</label>
                    <textarea name="address" class="form-control"></textarea>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label>City</label>
                        <input type="text" name="city" class="form-control">
                    </div>
                    <div class="form-group">
                        <label>Postal Code</label>
                        <input type="text" name="zip" class="form-control">
                    </div>
                </div>

                <div class="modal-footer" style="padding: 1rem 0 0 0;">
                    <button type="button" class="btn btn-primary" id="saveProfileBtn">Update Profile</button>
                </div>
            </form>
        </div>
    </div>


<script src="~/views-js/profile-edit.js"></script>