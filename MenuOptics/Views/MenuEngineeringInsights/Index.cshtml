@{
    ViewData["Title"] = "Menu Engineering";
}


<link href="~/css/customrangefilter.css" rel="stylesheet" />

<style>
    .btn {
        padding: 10px 16px!important;
        border-radius: 8px!important;
        font-size: 14px!important;
        font-weight: 500!important;
        cursor: pointer!important;
        transition: all 0.2s ease!important;
        display: inline-flex!important;
        align-items: center!important;
        gap: 8px!important;
        text-decoration: none!important;
        border: none!important;
    }
    .btn-primary {
        background: #f08d11!important;
        color: white!important;
        border: 1px solid #f08d11!important;
    }

    .btn-outline {
        background: transparent!important;
        color: #374151!important;
        border: 1px solid #d1d5db!important;
    }
</style>


<div class="page-header">
    <div class="header-text">
        <h1>Menu Engineering Insights</h1>
        <p>Analyze menu item performance, profitability, and popularity.</p>
    </div>
    <div class="header-actions" id="exportButtons">
       
    </div>
</div>



<!-- Filters -->
<div class="filters">
    <div class="search-wrapper">
        <i class="fas fa-search"></i>
        <input type="text" placeholder="Search menu items..." class="filter-search" id="menuItemSearch">
    </div>
    <button class="btn btn-outline quadrant-filter" data-quadrant="Star"><i class="fas fa-star"></i> Star</button>
    <button class="btn btn-outline quadrant-filter" data-quadrant="Plowhorse"><i class="fas fa-horse"></i> Plowhorse</button>
    <button class="btn btn-outline quadrant-filter" data-quadrant="Puzzle"><i class="fas fa-puzzle-piece"></i> Puzzle</button>
    <button class="btn btn-outline quadrant-filter" data-quadrant="Dog"><i class="fas fa-dog"></i> Dog</button>
    @* <button class="btn btn-outline" id="high-profit-filter"><i class="fas fa-dollar-sign"></i> High Profit Only</button> *@
    <button class="btn btn-outline" id="clear-filter"><i class="fas fa-times"></i> Clear Filters</button>
    
    <div id="dateRange" style="margin-left:auto"></div>
</div>

<!-- Menu Engineering Insights Table -->
<div class="card">
    <div class="card-header">
        <h3><i class="fas fa-chart-line"></i> Menu Performance Overview</h3>
    </div>
    <div class="card-content">
        <div class="table-container">
            <table class="data-table menu-engineering-table">
                <thead>
                    <tr>
                        <th>Menu Item</th>
                        <th>Selling Price</th>
                        <th>Cost</th>
                        <th>Food Cost %</th>
                        <th>Units Sold</th>
                        <th>Contribution Margin</th>
                        <th>Profitability Score</th>
                        <th>Popularity Share</th>
                        <th>Quadrant</th>
                        <th class="hidden">Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
</div>


@section scripts {
    <script src="~/js/customrangefilter.js"></script>
    <script src="~/views-js/MenuEngineeringInsights.js?v=@DateTime.Now.Ticks"></script>
}
